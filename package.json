{
	"name": "@intervene/neta",
	"version": "2.2.5",
	"description": "Neta: the interface, engine, and machine service for running persistent agent teams across workspaces.",
	"license": "MIT",
	"author": "Sudhanshu Gautam",
	"homepage": "https://github.com/sudhanshug16/neta#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sudhanshug16/neta.git"
	},
	"bugs": {
		"url": "https://github.com/sudhanshug16/neta/issues"
	},
	"keywords": [
		"agent",
		"acp",
		"mcp",
		"claude-code",
		"codex",
		"opencode",
		"orchestration"
	],
	"type": "module",
	"bin": {
		"neta": "dist/main.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE",
		"MANIFESTO.md",
		"CHARTER.example.md",
		"CHANGELOG.md",
		"docs"
	],
	"engines": {
		"node": ">=22"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"setup:opencode": "bun scripts/setup-opencode.ts",
		"build:opencode": "bun scripts/build-opencode.ts",
		"test:opencode": "bun test test/opencode-gateway.test.ts test/opencode-v2-native.test.ts",
		"build": "bun build src/cli/main.ts --target=node --outdir=dist --sourcemap=linked && chmod +x dist/main.js && bash scripts/stage-codex-acp.sh && bun scripts/stage-toad.ts",
		"clean": "rm -rf dist",
		"typecheck": "tsc --noEmit",
		"check": "biome check --write --error-on-warnings . && bun run typecheck",
		"test": "bun test",
		"smoke": "bash scripts/smoke.sh",
		"prepublishOnly": "bun run check && bun test && bun run build && bun run verify:opencode",
		"export:opencode": "bun scripts/export-opencode.ts",
		"verify:opencode": "bun scripts/verify-opencode.ts --all",
		"test:conformance": "bun scripts/conformance.ts"
	},
	"dependencies": {
		"@agentclientprotocol/claude-agent-acp": "0.74.0",
		"@agentclientprotocol/sdk": "1.4.0",
		"@openai/codex": "0.153.4",
		"@anthropic-ai/claude-agent-sdk": "0.3.257",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"node-pty": "1.1.0",
		"opencode-ai": "1.2.26",
		"pi-claude-bridge": "0.7.0"
	},
	"devDependencies": {
		"@agentclientprotocol/codex-acp": "1.10.0",
		"@biomejs/biome": "2.3.5",
		"@types/bun": "1.3.14",
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	},
	"patchedDependencies": {
		"@agentclientprotocol/codex-acp@1.10.0": "patches/@agentclientprotocol%2Fcodex-acp@1.10.0.patch"
	},
	"overrides": {
		"@anthropic-ai/claude-agent-sdk": "0.3.257"
	}
}
