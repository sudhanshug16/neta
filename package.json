{
	"name": "neta",
	"version": "0.1.0",
	"private": true,
	"description": "A leader agent that delegates to tiered worker agents behind the coding-agent CLI you already use.",
	"license": "MIT",
	"type": "module",
	"bin": {
		"neta": "dist/cli.js"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "rm -rf dist",
		"check": "biome check --write --error-on-warnings . && tsc --noEmit",
		"test": "vitest --run"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "1.3.0",
		"@modelcontextprotocol/sdk": "1.30.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "24.12.4",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	}
}
