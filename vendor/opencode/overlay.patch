+      expect(app.captureCharFrame()).toContain("8/8 enabled")
+      failSave = false
+      app.mockInput.pressKey("F3")
+      await app.waitForFrame((frame) => frame.includes("0/8 enabled"))
+      // A row click is the same toggle as Space/Enter.
+      await clickText("[ ] Luna")
+      await app.waitForFrame((frame) => frame.includes("1/8 enabled"))
+
+      app.mockInput.pressEscape()
+      await app.waitForFrame((frame) => frame.includes("Session routing log"))
+      app.mockInput.pressEscape()
