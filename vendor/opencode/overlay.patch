+                if (method === "routing.auth.status") return { configured: true, source: "saved" } as T
+                if (method === "routing.preferences.list") return { models } as T
+                if (failSave) throw new Error("fixture save failed")
+                saves.push(params as (typeof saves)[number])
+                return {} as T
+              },
+            }}
+          />
+        ))
+        dialog.setSize("large")
+      })
+      return <text>Workspace</text>
+    }
+    const app = await testRender(
+      () => (
+        <TestTuiContexts>
+          <ConfigProvider config={createTuiResolvedConfig()}>
+            <Keymap.Provider>
+              <ThemeProvider mode="dark" source={{ discover: async () => ({}) }}>
+                <ToastProvider>
+                  <DialogProvider>
+                    <Open />
+                  </DialogProvider>
+                </ToastProvider>
+              </ThemeProvider>
+            </Keymap.Provider>
+          </ConfigProvider>
+        </TestTuiContexts>
