+import { expect, test } from "bun:test"
+import type { Snapshot } from "@neta/client"
+import {
+  archiveTimestamp,
+  modelDecisionText,
+  missionDisplayState,
+  spineWidth,
+  spineStatusRank,
+  workspaceActivity,
+  stateLabel,
+} from "../src/neta/presentation"
+
+test("archive dates use recorded timestamps without inventing a missing end time", () => {
+  expect(archiveTimestamp("2026-09-18T12:28:00")).toBe("18 Sep")
+  expect(archiveTimestamp("2026-09-18T12:28:00", true)).toBe("18 Sep, 12:28")
+  expect(archiveTimestamp(undefined)).toBe("")
+  expect(archiveTimestamp("invalid")).toBe("")
+})
+
+test("sidebar leaves a readable native viewport at compact and wide terminal sizes", () => {
+  expect(spineWidth(80)).toBe(0)
+  for (const width of [95, 100, 120, 160, 220]) {
+    expect(width - spineWidth(width)).toBeGreaterThanOrEqual(65)
+    expect(spineWidth(width)).toBeLessThanOrEqual(42)
+  }
+  expect(stateLabel("readyToClose")).toBe("READY TO CLOSE")
+  expect(stateLabel("closed")).toBe("ARCHIVED")
+})
+
+test("activity includes working leaders and deduplicates mission attention", () => {
+  const snapshot: Snapshot = {
+    machine: { id: "local", name: "Local" },
+    workspaces: [],
+    leaders: [
+      {
+        name: "Mace",
+        sessionId: "leader",
+        workspaceId: "work",
+        machineId: "local",
+        provider: "opencode",
+        model: "test",
+        mode: "lead",
+        state: "running",
+      },
+    ],
+    missions: [
+      {
+        id: "mission",
+        workspaceId: "work",
+        number: 1,
+        name: "Inspect",
+        createdAt: "2026-09-18",
+        state: "blocked",
+        agentIds: [],
+      },
+    ],
+    agents: [
+      {
+        id: "a",
+        missionId: "mission",
+        workspaceId: "work",
+        sessionId: "child",
+        name: "Sol",
+        provider: "opencode",
+        model: "test",
+        task: "Inspect",
+        state: "blocked",
+        deliveryStatus: "uncertain",
+      },
+    ],
+  }
+  expect(workspaceActivity(snapshot, "work")).toEqual({ running: 1, attention: 1 })
+  expect(workspaceActivity(snapshot, "other")).toEqual({ running: 0, attention: 0 })
+
+  const mission = { ...snapshot.missions[0]!, state: "running" }
+  const actor = snapshot.agents[0]!
+  expect(missionDisplayState(mission, [{ ...actor, state: "idle" }])).toBe("idle")
+  expect(missionDisplayState(mission, [{ ...actor, state: "queued" }])).toBe("queued")
+  expect(missionDisplayState(mission, [{ ...actor, state: "starting" }])).toBe("starting")
+  expect(missionDisplayState(mission, [{ ...actor, state: "running" }])).toBe("running")
+  expect(missionDisplayState(mission, [{ ...actor, missionId: "other", state: "running" }])).toBe("idle")
+  expect(missionDisplayState({ ...mission, state: "closed" }, [{ ...actor, state: "running" }])).toBe("closed")
+  expect(missionDisplayState({ ...mission, state: "readyToClose" }, [{ ...actor, state: "idle" }])).toBe("readyToClose")
+  expect(missionDisplayState({ ...mission, lead: { kind: "leader" } }, [], snapshot.leaders[0])).toBe("running")
+  expect(missionDisplayState(mission, [], snapshot.leaders[0])).toBe("idle")
+  const blocked = { ...mission, state: "blocked" as const, lead: { kind: "agent" as const, agentId: actor.id } }
+  expect(missionDisplayState(blocked, [{ ...actor, state: "running" }])).toBe("running")
+  expect(missionDisplayState(blocked, [{ ...actor, state: "idle" }])).toBe("blocked")
+  expect(missionDisplayState({ ...blocked, state: "closed" }, [{ ...actor, state: "running" }])).toBe("closed")
+})
+
+test("model details preserve routed, requested and actual identities and warnings", () => {
+  const details = modelDecisionText({
+    id: "a",
+    missionId: "m",
+    workspaceId: "w",
+    sessionId: "s",
+    name: "Cove",
+    provider: "opencode",
+    model: "provider/actual",
+    requestedModel: "provider/small",
+    task: "Inspect",
+    state: "idle",
+    routing: {
+      effort: 1,
+      method: "fixed",
+      selectedModel: "provider/small",
+      reason: "Configured effort 1",
+      warnings: ["Historical metadata"],
+    },
+  })
+  expect(details).toContain("Actual model: provider/actual")
+  expect(details).toContain("Requested model: provider/small")
+  expect(details).toContain("Selected model: provider/small")
+  expect(details).toContain("task effort 1/5")
+  expect(details).toContain("Configured effort 1")
+  expect(details).toContain("Warning: Historical metadata")
+  expect(stateLabel("idle")).toBe("IDLE")
+})
+
+test("spine orders live work before attention, idle work and history", () => {
+  const states = ["archived", "completed", "idle", "failed", "queued", "closed",
+    "mergedNotClosed", "readyToClose", "interrupted", "blocked", "starting", "running"]
+  expect(states.sort((a, b) => spineStatusRank(a) - spineStatusRank(b))).toEqual([
+    "running", "starting", "blocked", "failed", "queued", "interrupted", "idle",
+    "readyToClose", "mergedNotClosed", "completed", "closed", "archived",
+  ])
+})
