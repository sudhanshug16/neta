+import { Socket } from "node:net"
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises"
+import { homedir } from "node:os"
+import { join, resolve } from "node:path"
+import { randomUUID } from "node:crypto"
+
+export type Workspace = { id: string; name: string; roots: { machineId: string; path: string }[] }
+export type RoutingAuthStatus = {
+  configured: boolean
+  source: "saved" | "environment" | "none"
+  error?: string
+}
+export type Leader = {
+  workspaceId: string
+  machineId: string
+  sessionId: string
+  name: string
+  provider: string
+  model: string
+  state: string
+  mode: string
+}
+export type Agent = {
+  id: string
+  missionId: string
+  workspaceId: string
+  sessionId: string
+  name: string
+  provider: string
+  model: string
+  state: string
+  task: string
+  canSpawn?: boolean
+  requestedModel?: string
+  routing?: {
+    effort?: number
+    method: "explicit" | "fixed" | "jev"
+    selectedModel: string
+    reason: string
+    warnings: string[]
+  }
+  fallbackModels?: string[]
+  endedAt?: string
+  deliveryStatus?: "pending" | "accepted" | "uncertain" | "failed"
+  deliveryError?: string
+}
+export type Mission = {
+  id: string
+  workspaceId: string
+  number: number
+  name: string
+  state: string
+  createdAt: string
+  closedAt?: string
+  disposition?: "merged" | "abandoned" | "completed"
+  agentIds: string[]
+  lead?: { kind: "leader" } | { kind: "agent"; agentId: string }
+  worktree?: { path: string }
+}
+export type Snapshot = {
+  machine: { id: string; name: string }
+  workspaces: Workspace[]
+  leaders: Leader[]
+  missions: Mission[]
+  agents: Agent[]
+}
+export type Attachment = {
+  integrationVersion: number
+  url: string
+  authorization: string
+  sessionId: string
+  netaSessionId: string
+  directory: string
+}
+export type SavedHost = {
+  id: string
+  displayName: string
+  sshDestination: string
+  sshConfig?: string
+  remoteNetaDir: string
+  lastRemoteWorkspacePath?: string
+}
+export type View = { host: string; workspaceId: string; path: string; owner: string; tabs: string[] }
+
+export function initialView(input: {
+  path?: string
+  host?: string
+  cwd: string
+  previous?: View
+  hosts: SavedHost[]
+}): View {
+  if (!input.path && !input.host && input.previous) return { ...input.previous, tabs: [...input.previous.tabs] }
+  const host = input.host ? (input.host === "local" ? "local" : `ssh:${input.host}`) : "local"
+  const previous = input.previous?.host === host ? input.previous : undefined
+  const path =
+    input.path ??
+    previous?.path ??
+    (host === "local" ? input.cwd : input.hosts.find((one) => `ssh:${one.id}` === host)?.lastRemoteWorkspacePath)
+  if (!path) throw new Error("Choose a project path on the remote machine: neta tui --host HOST /absolute/project/path")
+  return {
+    host,
+    path: host === "local" ? resolve(input.cwd, path) : path,
+    workspaceId: "",
+    owner: "leader",
+    tabs: ["leader"],
+  }
+}
+
+export function netaDirectory() {
+  return process.env.NETA_DIR ?? join(homedir(), ".neta")
+}
+
+export class NetaError extends Error {
+  readonly code: number | undefined
+  constructor(message: string, code?: number) {
+    super(message)
+    this.name = "NetaError"
+    this.code = code
+  }
+}
+
+export class NetaClient {
+  private socket: Socket
+  private pending = new Map<
+    string,
+    { resolve(value: unknown): void; reject(error: Error): void; timeout: ReturnType<typeof setTimeout> }
+  >()
+  private listeners = new Set<(method: string, value: unknown) => void>()
+  private buffer = ""
+
+  constructor(socket: Socket) {
+    this.socket = socket
+    socket.setEncoding("utf8")
+    socket.on("data", (chunk) => {
+      this.buffer += chunk
+      if (this.buffer.length > 16 * 1024 * 1024) return socket.destroy(new Error("Neta response exceeds 16 MiB"))
+      for (;;) {
+        const index = this.buffer.indexOf("\n")
+        if (index < 0) break
+        const line = this.buffer.slice(0, index)
+        this.buffer = this.buffer.slice(index + 1)
+        if (!line.trim()) continue
+        try {
+          const message = JSON.parse(line)
+          const pending = this.pending.get(String(message.id))
+          if (pending) {
+            this.pending.delete(String(message.id))
+            clearTimeout(pending.timeout)
+            if (message.error)
+              pending.reject(new NetaError(message.error.message ?? "Neta request failed", message.error.code))
+            else pending.resolve(message.result)
+          } else if (typeof message.method === "string") {
+            for (const listener of this.listeners) listener(message.method, message.params)
+          }
+        } catch {
+          socket.destroy(new Error("Neta returned a malformed response"))
+        }
+      }
+    })
+    socket.on("error", (error) => this.fail(error))
+    socket.on("close", () => {
+      this.fail(new Error("Disconnected from Neta. Your agent continues on its machine."))
+      for (const listener of this.listeners) listener("disconnected", {})
+    })
+  }
+
+  static async connect(directory = netaDirectory()) {
+    const raw = await readFile(join(directory, "node.json"), "utf8")
+    let descriptor: unknown
+    try {
+      descriptor = JSON.parse(raw)
+    } catch {
+      throw Object.assign(
+        new Error("The saved Neta service descriptor is malformed; checking process ownership before recovery."),
+        { code: "NETA_DESCRIPTOR_INVALID" },
+      )
+    }
+    if (
+      !descriptor ||
+      typeof descriptor !== "object" ||
+      !("socket" in descriptor) ||
+      typeof descriptor.socket !== "string" ||
+      !("token" in descriptor) ||
+      typeof descriptor.token !== "string"
+    )
+      throw Object.assign(
+        new Error("The saved Neta service descriptor is invalid; checking process ownership before recovery."),
+        { code: "NETA_DESCRIPTOR_INVALID" },
+      )
+    return NetaClient.open(descriptor.socket, descriptor.token)
+  }
+
+  static async open(path: string, token: string) {
+    const socket = new Socket()
+    const client = new NetaClient(socket)
+    try {
+      // Install listeners before connecting: Bun may reject a missing Unix
+      // socket immediately. Preserve ENOENT/ECONNREFUSED for cold startup.
+      await new Promise<void>((resolve, reject) => {
+        const finish = (error?: Error) => {
+          clearTimeout(timeout)
+          socket.off("connect", connected)
+          socket.off("error", failed)
+          if (error) reject(error)
+          else resolve()
+        }
+        const connected = () => finish()
+        const failed = (error: Error) => finish(error)
+        const timeout = setTimeout(() => finish(new Error("Timed out connecting to Neta")), 5000)
+        socket.once("connect", connected)
+        socket.once("error", failed)
+        socket.connect(path)
+      })
+      await client.request("hello", { token, client: "cli", protocolVersion: 3 }, 5000)
+      return client
+    } catch (error) {
+      client.close()
+      throw error
+    }
+  }
+
+  request<T>(method: string, params: unknown = {}, timeoutMs = 120_000): Promise<T> {
+    if (this.socket.destroyed) return Promise.reject(new Error("Neta is disconnected"))
+    const id = randomUUID()
+    return new Promise<T>((resolve, reject) => {
+      const timeout = setTimeout(() => {
+        this.pending.delete(id)
+        reject(new Error(`${method} timed out. Its outcome is unknown; reconnect before retrying.`))
+      }, timeoutMs)
+      this.pending.set(id, { resolve: (value) => resolve(value as T), reject, timeout })
+      this.socket.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`)
+    })
+  }
+
+  subscribe(listener: (method: string, value: unknown) => void) {
+    this.listeners.add(listener)
+    return () => {
+      this.listeners.delete(listener)
+    }
+  }
+
+  close() {
+    this.listeners.clear()
+    this.socket.destroy()
+  }
+
+  private fail(error: Error) {
+    for (const pending of this.pending.values()) {
+      clearTimeout(pending.timeout)
+      pending.reject(error)
+    }
+    this.pending.clear()
+  }
+}
+
+export async function loadView(directory = netaDirectory()): Promise<View | undefined> {
+  try {
+    const view = JSON.parse(await readFile(join(directory, "opencode-view.json"), "utf8"))
+    if (
+      typeof view.path !== "string" ||
+      typeof view.host !== "string" ||
+      typeof view.owner !== "string" ||
+      typeof view.workspaceId !== "string" ||
+      !Array.isArray(view.tabs) ||
+      view.tabs.some((tab: unknown) => typeof tab !== "string")
+    )
+      throw new Error("Invalid saved Neta view")
+    return view
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") {
+      try {
+        const legacy = JSON.parse(await readFile(join(directory, "tui-view.json"), "utf8"))
+        if (typeof legacy.path === "string" && typeof legacy.host === "string")
+          return {
+            host: legacy.host,
+            path: legacy.path,
+            workspaceId: typeof legacy.workspace === "string" ? legacy.workspace : "",
+            owner: "leader",
+            tabs: ["leader"],
+          }
+      } catch (legacyError) {
+        if ((legacyError as NodeJS.ErrnoException).code !== "ENOENT") throw legacyError
+      }
+      return undefined
+    }
+    throw error
+  }
+}
+
+export async function saveView(view: View, directory = netaDirectory()) {
+  await mkdir(directory, { recursive: true, mode: 0o700 })
+  const temporary = join(directory, `.opencode-view-${randomUUID()}`)
+  await writeFile(temporary, JSON.stringify(view), { mode: 0o600 })
+  await rename(temporary, join(directory, "opencode-view.json"))
+}
+
+export async function savedHosts(directory = netaDirectory()): Promise<SavedHost[]> {
+  try {
+    const value = JSON.parse(await readFile(join(directory, "client-hosts.json"), "utf8"))
+    const hosts = Array.isArray(value) ? value : value.hosts
+    if (!Array.isArray(hosts)) throw new Error("Invalid Neta machine registry")
+    for (const host of hosts) {
+      if (
+        !host ||
+        typeof host.id !== "string" ||
+        typeof host.displayName !== "string" ||
+        typeof host.sshDestination !== "string" ||
+        host.sshDestination.startsWith("-")
+      )
+        throw new Error("Invalid saved machine")
+      host.remoteNetaDir ??= "~/.neta"
+      // Existing registries serialize unset optional paths as null.
+      if (host.sshConfig === null) delete host.sshConfig
+      if (host.lastRemoteWorkspacePath === null) delete host.lastRemoteWorkspacePath
+      if (
+        typeof host.remoteNetaDir !== "string" ||
+        (host.sshConfig !== undefined && typeof host.sshConfig !== "string") ||
+        (host.lastRemoteWorkspacePath !== undefined && typeof host.lastRemoteWorkspacePath !== "string")
+      )
+        throw new Error("Invalid saved machine paths")
+    }
+    return hosts
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === "ENOENT") return []
+    throw error
+  }
+}
+
+export function ownerSession(snapshot: Snapshot, workspaceId: string, owner: string) {
+  return owner === "leader"
+    ? snapshot.leaders.find((leader) => leader.workspaceId === workspaceId)
+    : snapshot.agents.find((agent) => agent.workspaceId === workspaceId && agent.id === owner)
+}
diff --git a/packages/neta-client/src/remote.ts b/packages/neta-client/src/remote.ts
new file mode 100644
index 0000000..41b4e32
--- /dev/null
+++ b/packages/neta-client/src/remote.ts
@@ -0,0 +1,101 @@
+import { spawn, execFile, type ChildProcess } from "node:child_process"
+import { connect, createServer } from "node:net"
+import { mkdtemp, rm } from "node:fs/promises"
+import { join } from "node:path"
+import { NetaClient, type Attachment, type SavedHost } from "./index"
+
+export function shellQuote(value: string) {
+  return `'${value.replaceAll("'", `'\\''`)}'`
+}
+
+export async function connectRemote(host: SavedHost) {
+  const args = [
+    "-o",
+    "BatchMode=yes",
+    "-o",
+    "ConnectTimeout=8",
+    "-o",
+    "ExitOnForwardFailure=yes",
+    ...(host.sshConfig ? ["-F", host.sshConfig] : []),
+  ]
+  const path = host.remoteNetaDir.startsWith("~/")
+    ? `"$HOME"/${shellQuote(host.remoteNetaDir.slice(2))}`
+    : shellQuote(host.remoteNetaDir)
+  const descriptor = await new Promise<{ socket: string; token: string }>((resolve, reject) => {
+    execFile(
+      "ssh",
+      [...args, "--", host.sshDestination, `cat ${path}/node.json`],
+      { timeout: 12_000 },
+      (error, stdout) => {
+        if (error)
+          return reject(new Error(`Cannot connect to ${host.displayName}. Start Neta on that machine, then reconnect.`))
+        try {
+          const value = JSON.parse(stdout)
+          if (typeof value.socket !== "string" || typeof value.token !== "string")
+            throw new Error("Invalid remote Node descriptor")
+          resolve(value)
+        } catch (error) {
+          reject(error)
+        }
+      },
+    )
+  })
+  const temporary = await mkdtemp("/tmp/neta-oc-")
+  const children: ChildProcess[] = []
+  let client: NetaClient | undefined
+  const close = async () => {
+    client?.close()
+    for (const child of children) child.kill()
+    await rm(temporary, { recursive: true, force: true })
+  }
+  async function forward(spec: string, target: { path: string } | { port: number; host: string }) {
+    const child = spawn("ssh", [...args, "-N", "-L", spec, "--", host.sshDestination], { stdio: "ignore" })
+    children.push(child)
+    let failure: Error | undefined
+    child.on("error", (error) => {
+      failure = error
+    })
+    const deadline = Date.now() + 10_000
+    while (Date.now() < deadline) {
+      if (failure || child.exitCode !== null) throw failure ?? new Error(`SSH connection to ${host.displayName} closed`)
+      const ready = await new Promise<boolean>((resolve) => {
+        const socket = connect(target)
+        socket.once("connect", () => {
+          socket.destroy()
+          resolve(true)
+        })
+        socket.once("error", () => {
+          socket.destroy()
+          resolve(false)
+        })
+      })
+      if (ready) return
+      await new Promise((resolve) => setTimeout(resolve, 50))
+    }
+    throw new Error(`Timed out connecting to ${host.displayName}`)
+  }
+  try {
+    const socket = join(temporary, "node.sock")
+    await forward(`${socket}:${descriptor.socket}`, { path: socket })
+    client = await NetaClient.open(socket, descriptor.token)
+    return {
+      client,
+      close,
+      native: async (attachment: Attachment) => {
+        const server = createServer()
+        await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve))
+        const address = server.address()
+        if (!address || typeof address === "string") throw new Error("Cannot allocate local SSH port")
+        await new Promise<void>((resolve, reject) => server.close((error) => (error ? reject(error) : resolve())))
+        const remote = new URL(attachment.url)
+        if (remote.hostname !== "127.0.0.1" || remote.protocol !== "http:")
+          throw new Error("Invalid remote native chat endpoint")
+        await forward(`127.0.0.1:${address.port}:127.0.0.1:${remote.port}`, { host: "127.0.0.1", port: address.port })
+        return { ...attachment, url: `http://127.0.0.1:${address.port}` }
+      },
+    }
+  } catch (error) {
+    await close()
+    throw error
+  }
+}
diff --git a/packages/neta-client/src/startup.ts b/packages/neta-client/src/startup.ts
new file mode 100644
index 0000000..974cac2
--- /dev/null
+++ b/packages/neta-client/src/startup.ts
@@ -0,0 +1,115 @@
+import { NetaError, type NetaClient, type Snapshot, type Attachment } from "./index"
+
+type Client = Pick<NetaClient, "request" | "close">
+
+/** Check compatibility before opening or mutating a workspace. */
+export async function ensureLocalRuntime<T extends Client>(options: {
+  connect(): Promise<T>
+  start(): Promise<void>
+  replace(instanceId: string): Promise<void>
+  validateReplacement?(): Promise<void>
+  notice(message: string): void
+  expectedBuild?: string
+}): Promise<T> {
+  let client: T
+  try {
+    client = await options.connect()
+  } catch (error) {
+    if (!(error instanceof Error && "code" in error && ["ENOENT", "ECONNREFUSED", "NETA_DESCRIPTOR_INVALID"].includes(String(error.code))))
+      throw error
+    await options.start()
+    client = await options.connect()
+  }
+  try {
+    const capabilities = await client
+      .request<{ nativeOpenCodeVersions?: number[]; nativeOpenCodeRevision?: number; runtimeBuild?: string; activeSessionIds?: string[]; instanceId?: string; runtimeUpgrade?: number }>("runtime.capabilities")
+      .catch((error: unknown) => {
+        if (error instanceof NetaError && error.code === -32601) return undefined
+        throw error
+      })
+    if (capabilities?.nativeOpenCodeVersions?.includes(2) && (capabilities.nativeOpenCodeRevision ?? 0) >= 9 && (!options.expectedBuild || capabilities.runtimeBuild === options.expectedBuild))
+      return client
+    const snapshot = await client.request<Snapshot>("snapshot")
+    const active = capabilities?.activeSessionIds ? capabilities.activeSessionIds.length > 0 :
+      snapshot.leaders.some((leader) => leader.state === "running") ||
+      snapshot.agents.some((agent) => ["starting", "running", "blocked"].includes(agent.state))
+    if (active && capabilities?.nativeOpenCodeVersions?.includes(2)) {
+      options.notice("Opening Neta on the current service; its update will wait until active work finishes.")
+      return client
+    }
+    if (active)
+      throw new Error(
+        "Neta has active work on the previous runtime. Let it finish, then run neta tui again; your work has not been stopped.",
+      )
+    if (capabilities?.runtimeUpgrade !== 1 || !capabilities.instanceId) {
+      if (capabilities?.nativeOpenCodeVersions?.includes(2)) {
+        options.notice("Opening the current Neta service. Its next restart will apply this build; this older service cannot safely perform a live update.")
+        return client
+      }
+      throw new Error("The previous Neta service does not support safe upgrades. An explicit service stop is required once; no work was stopped.")
+    }
+    await options.validateReplacement?.()
+    const instanceId = capabilities.instanceId
+    const prepared = await client.request<{ prepared: boolean; reason?: string; token?: string }>("runtime.upgrade.prepare", {
+      instanceId, desiredBuild: options.expectedBuild,
+    })
+    if (!prepared.prepared && prepared.reason !== "update-in-progress") {
+      options.notice("Opening the current Neta service; newly admitted work deferred its update.")
+      return client
+    }
+    if (prepared.prepared) {
+      if (!prepared.token) throw new Error("Neta returned an invalid update reservation. No service was stopped.")
+      try {
+        const committed = await client.request<{ stopping: boolean }>("runtime.upgrade.commit", { instanceId, token: prepared.token })
+        if (!committed.stopping) {
+          options.notice("Opening the current Neta service; its update reservation expired or work became active.")
+          return client
+        }
+      } catch (error) {
+        await client.request("runtime.upgrade.cancel", { instanceId, token: prepared.token }).catch(() => undefined)
+        throw error
+      }
+    }
+    options.notice("Updating the idle Neta service…")
+    // The service itself admitted the conditional stop. The launcher never
+    // stops whichever instance happens to occupy the descriptor later.
+    await options.replace(instanceId)
+    client.close()
+    client = await options.connect()
+    const updated = await client.request<{ nativeOpenCodeVersions?: number[]; nativeOpenCodeRevision?: number; runtimeBuild?: string; activeSessionIds?: string[]; instanceId?: string; runtimeUpgrade?: number }>(
+      "runtime.capabilities",
+    )
+    if (!updated.nativeOpenCodeVersions?.includes(2) || (updated.nativeOpenCodeRevision ?? 0) < 9 || (options.expectedBuild && updated.runtimeBuild !== options.expectedBuild))
+      throw new Error("The local Neta engine is outdated. Update this checkout and run neta tui again.")
+    return client
+  } catch (error) {
+    client.close()
+    throw error
+  }
+}
+
+
+/** A stale saved tab must not prevent opening the workspace. Explicit navigation still reports errors. */
+export async function openStartupConversation(options: {
+  client: Client
+  selected: { name: string; sessionId: string; state: string }
+  leader: { sessionId: string }
+  recover: boolean
+}): Promise<{ attachment: Attachment; recovered: boolean; notice?: string }> {
+  try {
+    if (options.selected.state === "queued")
+      throw new NetaError(`${options.selected.name} is queued and has not started yet.`, -32004)
+    return {
+      attachment: await options.client.request<Attachment>("conversation.native", { sessionId: options.selected.sessionId }),
+      recovered: false,
+    }
+  } catch (error) {
+    if (!options.recover || options.selected.sessionId === options.leader.sessionId ||
+        !(error instanceof NetaError) || ![-32002, -32004, -32005].includes(error.code ?? 0)) throw error
+    return {
+      attachment: await options.client.request<Attachment>("conversation.native", { sessionId: options.leader.sessionId }),
+      recovered: true,
+      notice: `Opened the workspace leader. ${error.message}`,
+    }
+  }
+}
diff --git a/packages/neta-client/test/startup-socket.test.ts b/packages/neta-client/test/startup-socket.test.ts
new file mode 100644
index 0000000..255b908
--- /dev/null
+++ b/packages/neta-client/test/startup-socket.test.ts
@@ -0,0 +1,66 @@
+import { expect, test } from "bun:test"
+import { createServer } from "node:net"
+import { mkdtemp, writeFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { NetaClient } from "../src/index"
+import { ensureLocalRuntime } from "../src/startup"
+
+test("a stopped Node with a stale descriptor starts and completes the real socket handshake", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "neta-startup-"))
+  const socketPath = join(directory, "node.sock")
+  let started = 0
+  const received: string[] = []
+  const server = createServer((socket) => {
+    let buffer = ""
+    socket.on("data", (chunk) => {
+      buffer += chunk.toString()
+      while (buffer.includes("\n")) {
+        const end = buffer.indexOf("\n")
+        const request = JSON.parse(buffer.slice(0, end))
+        buffer = buffer.slice(end + 1)
+        received.push(request.method)
+        const result = request.method === "hello" ? {} : { nativeOpenCodeVersions: [1, 2], nativeOpenCodeRevision: 9 }
+        socket.write(JSON.stringify({ jsonrpc: "2.0", id: request.id, result }) + "\n")
+      }
+    })
+  })
+  let client: NetaClient | undefined
+  try {
+    await writeFile(join(directory, "node.json"), JSON.stringify({ socket: socketPath, token: "fixture" }))
+    await expect(NetaClient.connect(directory)).rejects.toMatchObject({ code: "ENOENT" })
+    client = await ensureLocalRuntime({
+      connect: () => NetaClient.connect(directory),
+      start: async () => {
+        started++
+        await new Promise<void>((resolve, reject) => {
+          server.once("error", reject)
+          server.listen(socketPath, resolve)
+        })
+      },
+      replace: async () => {
+        throw new Error("A stopped Node must not be replaced")
+      },
+      notice: () => {},
+    })
+    expect(started).toBe(1)
+    expect(received).toEqual(["hello", "runtime.capabilities"])
+  } finally {
+    client?.close()
+    if (server.listening) await new Promise<void>((resolve) => server.close(() => resolve()))
+    await rm(directory, { recursive: true, force: true })
+  }
+})
+
+
+test("malformed descriptor is classified before connecting", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "neta-invalid-"))
+  try {
+    for (const content of ["{broken", "null", "{}"])
+    {
+      await writeFile(join(directory, "node.json"), content)
+      try { await NetaClient.connect(directory); throw new Error("unexpected success") }
+      catch (error) { expect(error).toMatchObject({ code: "NETA_DESCRIPTOR_INVALID" }) }
+    }
+  } finally { await rm(directory, { recursive: true, force: true }) }
+})
diff --git a/packages/neta-client/test/startup.test.ts b/packages/neta-client/test/startup.test.ts
new file mode 100644
index 0000000..cd2206f
--- /dev/null
+++ b/packages/neta-client/test/startup.test.ts
@@ -0,0 +1,222 @@
+import { expect, test } from "bun:test"
+import { ensureLocalRuntime, openStartupConversation } from "../src/startup"
+import { NetaError } from "../src/index"
+
+function fixture(
+  input: {
+    old?: boolean
+    revision?: number
+    absent?: boolean
+    active?: "leader" | "agent" | "queued" | "mission"
+    error?: boolean
+    expectedBuild?: string
+    live?: string[]
+    legacy?: boolean
+    refused?: string
+    commit?: boolean
+    invalidReplacement?: boolean
+  } = {},
+) {
+  const calls: string[] = []
+  let old = input.old ?? false
+  let absent = input.absent ?? false
+  const client = {
+    async request<T>(method: string): Promise<T> {
+      calls.push(method)
+      if (input.error) throw new Error("broken connection")
+      if (method === "runtime.capabilities") {
+        if (input.legacy && input.revision === undefined) throw new NetaError("unknown method", -32601)
+        return { nativeOpenCodeVersions: [1, 2], nativeOpenCodeRevision: old ? (input.revision ?? 8) : 9, runtimeBuild: old ? "previous" : "current", activeSessionIds: input.live, instanceId: old ? "old-instance" : "current-instance", runtimeUpgrade: input.legacy ? undefined : 1 } as T
+      }
+      if (method === "runtime.upgrade.prepare") return { prepared: !input.refused, reason: input.refused, token: "reservation" } as T
+      if (method === "runtime.upgrade.commit") return { stopping: input.commit ?? true } as T
+      return {
+        leaders: input.active === "leader" ? [{ state: "running" }] : [],
+        agents: input.active === "agent" ? [{ state: "running" }] : input.active === "queued" ? [{ state: "queued" }] : [],
+        missions: input.active === "mission" ? [{ state: "running" }] : [],
+      } as T
+    },
+    close() {
+      calls.push("close")
+    },
+  }
+  return {
+    calls,
+    run: () =>
+      ensureLocalRuntime({
+        expectedBuild: input.expectedBuild,
+        connect: async () => {
+          calls.push("connect")
+          if (absent) throw Object.assign(new Error("missing"), { code: "ENOENT" })
+          return client
+        },
+        start: async () => {
+          calls.push("start")
+          absent = false
+        },
+        validateReplacement: async () => { if (input.invalidReplacement) throw new Error("bad executable") },
+        replace: async () => {
+          calls.push("replace")
+          old = false
+        },
+        notice: () => {
+          calls.push("notice")
+        },
+      }),
+  }
+}
+
+test("compatible Node is reused without restarting or opening a workspace", async () => {
+  const item = fixture()
+  await item.run()
+  expect(item.calls).toEqual(["connect", "runtime.capabilities"])
+})
+test("missing Node starts automatically", async () => {
+  const item = fixture({ absent: true })
+  await item.run()
+  expect(item.calls).toContain("start")
+  expect(item.calls).not.toContain("replace")
+})
+test("outdated idle Node is replaced before continuing", async () => {
+  const item = fixture({ old: true })
+  await item.run()
+  expect(item.calls).toEqual([
+    "connect",
+    "runtime.capabilities",
+    "snapshot",
+    "runtime.upgrade.prepare",
+    "runtime.upgrade.commit",
+    "notice",
+    "replace",
+    "close",
+    "connect",
+    "runtime.capabilities",
+  ])
+})
+for (const active of ["leader", "agent"] as const)
+  test(`outdated Node preserves active ${active}`, async () => {
+    const item = fixture({ old: true, active, legacy: true })
+    await expect(item.run()).rejects.toThrow("has not been stopped")
+    expect(item.calls).not.toContain("replace")
+  })
+test("unexpected connection errors never trigger a restart", async () => {
+  const item = fixture({ error: true })
+  await expect(item.run()).rejects.toThrow("broken connection")
+  expect(item.calls).not.toContain("replace")
+})
+
+for (const active of ["leader", "agent"] as const) {
+  test(`an older compatible revision opens during active ${active} work`, async () => {
+    const item = fixture({ old: true, revision: 2, active })
+    await item.run()
+    expect(item.calls).toContain("notice")
+    expect(item.calls).not.toContain("replace")
+    expect(item.calls).not.toContain("close")
+  })
+}
+test("a running mission without live actors does not block an idle update", async () => {
+  const item = fixture({ old: true, revision: 2, active: "mission" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+
+test("durably queued workers do not block an idle runtime update", async () => {
+  const item = fixture({ old: true, revision: 3, active: "queued" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+
+
+test("same revision with a changed build replaces an idle service", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+test("live turns defer a build update even when persisted actor labels are idle", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current", live: ["session"] })
+  await item.run()
+  expect(item.calls).not.toContain("replace")
+  expect(item.calls).toContain("notice")
+})
+test("stale running labels do not block an update when no turns are live", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current", active: "agent", live: [] })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+test("matching build reuses the service", async () => {
+  const item = fixture({ expectedBuild: "current" })
+  await item.run()
+  expect(item.calls).toEqual(["connect", "runtime.capabilities"])
+})
+test("a replacement with the wrong build cannot be reported as updated", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "missing" })
+  await expect(item.run()).rejects.toThrow("outdated")
+  expect(item.calls).toContain("replace")
+})
+
+
+test("a saved unavailable worker opens the leader without restarting work", async () => {
+  const calls: unknown[] = []
+  const attachment = { integrationVersion: 2, url: "http://fixture", authorization: "", sessionId: "vendor", netaSessionId: "leader", directory: "/project" }
+  const client = {
+    async request<T>(method: string, params?: unknown): Promise<T> {
+      calls.push([method, params])
+      if (calls.length === 1) throw new NetaError("Worktree missing; history retained", -32002)
+      return attachment as T
+    },
+    close() {},
+  }
+  const result = await openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: true })
+  expect(result).toMatchObject({ attachment, recovered: true })
+  expect(result.notice).toContain("Worktree missing")
+  expect(calls).toEqual([["conversation.native", { sessionId: "worker" }], ["conversation.native", { sessionId: "leader" }]])
+})
+for (const code of [-32002, -32004, -32005]) {
+  test(`explicit tab navigation preserves error ${code}`, async () => {
+    const client = { async request<T>(): Promise<T> { throw new NetaError("unavailable", code) }, close() {} }
+    await expect(openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: false })).rejects.toThrow("unavailable")
+  })
+}
+test("a queued saved tab opens the leader without attaching the queued worker", async () => {
+  const calls: unknown[] = []
+  const client = { async request<T>(method: string, params?: unknown): Promise<T> { calls.push(params); return {} as T }, close() {} }
+  const result = await openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "queued" }, leader: { sessionId: "leader" }, recover: true })
+  expect(result.recovered).toBe(true)
+  expect(calls).toEqual([{ sessionId: "leader" }])
+})
+test("connection failures are not masked by tab recovery", async () => {
+  const client = { async request<T>(): Promise<T> { throw new Error("disconnected") }, close() {} }
+  await expect(openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: true })).rejects.toThrow("disconnected")
+})
+
+
+test("work admitted after idle snapshot prevents replacement", async () => {
+  const item = fixture({ old: true, expectedBuild: "current", refused: "active-work" })
+  await item.run()
+  expect(item.calls).toContain("runtime.upgrade.prepare")
+  expect(item.calls).not.toContain("replace")
