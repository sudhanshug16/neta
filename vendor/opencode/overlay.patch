+import { expect, test } from "bun:test"
+import { makeACPFixture, makeSession, testModel } from "./service-fixture"
+
+test("refresh discovers newly connected providers without replacing or switching the session", async () => {
+  let connected = false
+  let fail = false
+  const location = { directory: "/workspace", project: { id: "global", directory: "/workspace" } }
+  await using fixture = makeACPFixture({
+    native: true,
+    models: [testModel, { ...testModel, providerID: "xai", id: "new-model" }],
+    fetch(request) {
+      if (request.path === "/api/model" && fail) return new Response(null, { status: 503 })
+      if (request.path === "/api/integration")
+        return Response.json({
+          location,
+          data: ["test", ...(connected ? ["xai"] : [])].map((id) => ({
+            id,
+            name: id,
+            methods: [],
+            connections: [{ type: "env", name: "FIXTURE" }],
+          })),
+        })
+      if (request.path === "/api/provider")
+        return Response.json({
+          location,
+          data: ["test", "xai"].map((id) => ({ id, name: id, activation: "auto", package: "" })),
+        })
+      if (request.path === "/api/session" && request.method === "POST")
+        return Response.json({ data: makeSession("ses_refresh") })
+    },
+  })
+  const session = await fixture.service.newSession({ cwd: "/workspace", mcpServers: [] })
+  expect(JSON.stringify(session.configOptions)).not.toContain("xai/new-model")
+  connected = true
+  const refreshed = await fixture.service.setSessionConfigOption({
+    sessionId: session.sessionId,
+    configId: "neta_refresh_models",
+    value: "",
+  })
+  expect(JSON.stringify(refreshed.configOptions)).toContain("xai/new-model")
+  expect(fixture.requests.filter((r) => r.path === "/api/session" && r.method === "POST")).toHaveLength(1)
+  expect(fixture.requests.filter((r) => r.path.endsWith("/model") && r.method === "POST")).toHaveLength(0)
+  fail = true
+  await expect(
+    fixture.service.setSessionConfigOption({
+      sessionId: session.sessionId,
+      configId: "neta_refresh_models",
+      value: "",
+    }),
+  ).rejects.toThrow()
+  fail = false
+  connected = false
+  const removed = await fixture.service.setSessionConfigOption({
+    sessionId: session.sessionId,
+    configId: "neta_refresh_models",
+    value: "",
+  })
+  expect(JSON.stringify(removed.configOptions)).not.toContain("xai/new-model")
+})
