+}
+
+for (const [width, height] of [
+  [80, 24],
+  [140, 32],
+]) {
+  test(`model checkboxes, bulk actions, search and Escape at ${width}x${height}`, async () => {
+    const saves: { models: Record<string, string> }[] = []
+    let failSave = false
+    const models = [
+      {
+        id: "meta/muse-spark-1.3-contributor",
