+import { expect, test } from "bun:test"
+import type { Snapshot } from "@neta/client"
+import type { AttentionNotifyOptions } from "@opencode/plugin/tui/context"
+import { createNetaNotifications } from "../src/neta/notifications"
+
+test("Node notifications cover both leaders once per turn, with no worker, archived, or other-workspace noise", () => {
+  const sent: AttentionNotifyOptions[] = []
+  const state = {
+    leaders: [{ name: "Mace", workspaceId: "w", sessionId: "leader" }],
+    agents: [
+      { name: "Inga", workspaceId: "w", sessionId: "mission-lead", missionId: "m", canSpawn: true, state: "idle" },
+      { name: "Pim", workspaceId: "w", sessionId: "worker", missionId: "m", canSpawn: false },
+      { name: "Old", workspaceId: "w", sessionId: "archived", missionId: "m", canSpawn: true, state: "archived" },
+    ],
+    missions: [{ id: "m", state: "running" }],
+  } as unknown as Snapshot
+  const notify = createNetaNotifications(
+    {
+      notify: async (value) => {
+        sent.push(value)
+        return { ok: true, notification: true, sound: true }
+      },
+    },
+    () => state,
+    "w",
+  )
+  for (const sessionId of ["leader", "mission-lead", "worker", "archived", "unknown"]) {
+    const turn = { id: "one", endedAt: "2026-09-21T12:00:00Z" }
+    notify("conversation.ended", { sessionId, turn })
+    notify("conversation.ended", { sessionId, turn })
+  }
+  expect(sent.map((item) => item.title)).toEqual(["Neta · Mace", "Neta · Inga"])
+  expect(sent[0]?.notification).toEqual({ when: "always" })
+  notify("conversation.ended", { sessionId: "leader", turn: { id: "two", failed: true, endedAt: "now" } })
+  expect(sent[2]?.message).toContain("failed")
+  const event = { workspaceId: "w", seq: 3, kind: "mission.blocked" }
+  notify("event", { event })
+  notify("event", { event })
+  notify("event", { event: { ...event, workspaceId: "other", seq: 4 } })
+  expect(sent).toHaveLength(4)
+  expect(sent[3]?.message).toContain("needs your response")
+  notify("conversation.ended", { sessionId: "leader", turn: { id: "open" } })
+  notify("conversation.ended", null)
+  expect(sent).toHaveLength(4)
+})
