+import { expect, test } from "bun:test"
+import { Socket } from "node:net"
+import { testRender } from "@opentui/solid"
+import { NetaClient, type Agent, type Snapshot } from "@neta/client"
+import { NetaProvider } from "../src/neta/context"
+import { NetaShell } from "../src/neta/shell"
+import { ConfigProvider } from "../src/config"
+import { ClientProvider } from "../src/context/client"
+import { Keymap } from "../src/context/keymap"
+import { ThemeProvider } from "../src/context/theme"
+import { AttentionProvider } from "../src/context/attention"
+import { ExitProvider } from "../src/context/exit"
+import { DialogProvider } from "../src/ui/dialog"
+import { ToastProvider } from "../src/ui/toast"
+import { TestTuiContexts } from "./fixture/tui-environment"
+import { createTuiResolvedConfig } from "./fixture/tui-runtime"
+import { createApi, createEventStream, createFetch } from "./fixture/tui-client"
+import { useTerminalDimensions } from "../src/ui/terminal-dimensions"
+
+function ViewportProbe() {
+  const dimensions = useTerminalDimensions()
+  return <text>{dimensions().width}×{dimensions().height}</text>
+}
+
+for (const width of [80, 100, 160]) {
+  test(`the spine keeps pinned agents visible and navigation reachable at ${width} columns`, async () => {
+    const socket = new Socket()
+    const client = new NetaClient(socket)
+    const calls: string[] = []
+    const navigated: string[] = []
+    const actor: Agent = {
+      id: "mission-lead",
+      missionId: "m10",
+      workspaceId: "w",
+      sessionId: "saved",
+      name: "Hazel",
+      provider: "opencode",
+      model: "fixture",
+      state: "idle",
+      task: "inspect",
+      canSpawn: true,
+    }
+    const snapshot: Snapshot = {
+      machine: { id: "local", name: "Local" },
+      workspaces: [{ id: "w", name: "Test project", roots: [] }],
+      leaders: [
+        {
+          workspaceId: "w",
+          machineId: "local",
+          name: "Mace",
+          sessionId: "leader",
+          provider: "opencode",
+          model: "fixture",
+          mode: "lead",
+          state: "idle",
+        },
+      ],
+      missions: Array.from({ length: 11 }, (_, number) => ({
+        id: `m${number}`,
+        workspaceId: "w",
+        number,
+        name: number === 0 ? "Still active" : `Mission ${number}`,
+        createdAt: `2026-09-${String(number + 1).padStart(2, "0")}T12:00:00Z`,
+        state: number === 0 || number === 10 ? "running" : "closed",
+        disposition: "completed" as const,
+        agentIds: number === 10 ? [actor.id, "running-worker", "starting-worker", "queued-worker", "idle-worker"] : [],
+        lead: number === 10 ? { kind: "agent" as const, agentId: actor.id } : undefined,
+      })),
+      agents: [
+        { ...actor, id: "idle-worker", name: "Cove", state: "idle", canSpawn: false },
+        actor,
+        { ...actor, id: "running-worker", name: "Rowan", state: "running", canSpawn: false },
+        { ...actor, id: "starting-worker", name: "Pru", state: "starting", canSpawn: false },
+        { ...actor, id: "queued-worker", name: "Quill", state: "queued", canSpawn: false },
+      ],
+    }
+    client.request = async <T,>(method: string): Promise<T> => {
+      calls.push(method)
+      if (method === "snapshot") return snapshot as T
+      if (method === "missions.list")
+        return { missions: snapshot.missions.filter((entry) => entry.state === "closed") } as T
+      if (method === "missions.get") return { agents: [{ ...actor, state: "archived" }] } as T
+      if (method === "conversation.tail")
+        return {
+          blocks: [{ seq: 1, role: "agent", kind: "text", text: "Saved mission result" }],
+          prevCursor: null,
+        } as T
+      if (method === "conversation.untail") return {} as T
+      throw new Error(`Unexpected operation: ${method}`)
+    }
+    const app = await testRender(
+      () => (
+        <TestTuiContexts>
+          <ConfigProvider config={createTuiResolvedConfig()}>
+            <ClientProvider api={createApi(createFetch(undefined, createEventStream()).fetch)}>
+              <Keymap.Provider>
+                <ThemeProvider mode="dark" defaultName="neta" source={{ discover: async () => ({}) }}>
+                <AttentionProvider>
+                  <ExitProvider
+                    exit={() => {
+                      throw new Error("Archive must not leave the live session")
+                    }}
+                  >
+                    <ToastProvider>
+                      <DialogProvider>
+                        <NetaProvider
+                          value={{
+                            client,
+                            snapshot,
+                            view: {
+                              host: "local",
+                              workspaceId: "w",
+                              path: "/fixture",
+                              owner: "leader",
+                              tabs: ["leader"],
+                            },
+                            sessionId: "leader",
+                            hosts: [],
+                            drafts: new Map(),
+                            send: async () => {
+                              throw new Error("Archive must not prompt")
+                            },
+                            navigate: async (view) => {
+                              navigated.push(view.owner)
+                            },
+                          }}
+                        >
+                          <NetaShell>
+                            <box flexDirection="column">
+                              <text>Live chat</text>
+                              <ViewportProbe />
+                            </box>
+                          </NetaShell>
+                        </NetaProvider>
+                      </DialogProvider>
+                    </ToastProvider>
+                  </ExitProvider>
+                </AttentionProvider>
+                </ThemeProvider>
+              </Keymap.Provider>
+            </ClientProvider>
+          </ConfigProvider>
+        </TestTuiContexts>
+      ),
+      { width, height: 60 },
+    )
+    const click = async (text: string, direction: "up" | "down" = "down") => {
+      for (let step = 0; step < 16 && !app.captureCharFrame().includes(text); step++) {
+        await app.mockMouse.scroll(15, 35, direction)
+        await app.waitForVisualIdle()
+      }
+      const lines = app.captureCharFrame().split("\n")
+      const row = lines.findIndex((line) => line.includes(text))
+      const line = lines[row]
+      expect(line, `Visible row for ${text}`).toBeDefined()
+      if (!line) throw new Error(`Missing row: ${text}`)
+      await app.mockMouse.click(line.indexOf(text) + 1, row)
+    }
+    try {
+      app.renderer.start()
+      if (width < 95) {
+        await app.waitForFrame((frame) => frame.includes("Help · actions"))
+        expect(app.captureCharFrame()).toContain("78×59")
+        await click("Help · actions")
+        await app.waitForFrame((frame) => frame.includes("Spine help"))
+        expect(app.captureCharFrame()).toContain("Switch workspace")
+      } else {
+      await app.waitForFrame((frame) => frame.includes("#10 Mission 10"))
+      const initial = app.captureCharFrame()
+      for (let number = 3; number <= 10; number++) expect(initial).toContain(`#${number} Mission ${number}`)
+      expect(initial).toContain("#0 Still active")
+      expect(initial.indexOf("#10 Mission 10")).toBeLessThan(initial.indexOf("#0 Still active"))
+      expect(initial.indexOf("#0 Still active")).toBeLessThan(initial.indexOf("#9 Mission 9"))
+      expect(initial).toContain("Hazel")
+      expect(initial).toContain("Rowan")
+      expect(initial).toContain("Pru")
+      expect(initial).toContain("Quill")
+      expect(initial).not.toContain("Cove")
+      expect(initial).toContain("□ ARCHIVED")
+       expect(initial).toContain("○ Mace")
+       expect(calls).toEqual([])
+       if (process.env.NETA_TEST_CAPTURE === "1") await Bun.write(`/tmp/neta-recent-missions-${width}.txt`, initial)
+
+       await click("Hazel")
+       await app.waitForVisualIdle()
+       expect(navigated).toEqual(["mission-lead"])
+       await click("#10 Mission 10")
+      await app.waitForFrame((frame) => frame.includes("Cove"))
+      const expanded = app.captureCharFrame()
+      expect(expanded.match(/Hazel/g)?.length).toBe(1)
+      expect(expanded.match(/Rowan/g)?.length).toBe(1)
+      expect(expanded).toContain("Cove")
+      }
+    } finally {
+      app.renderer.destroy()
+      socket.destroy()
+    }
+  })
+}
diff --git a/packages/tui/test/neta-reconnect.test.ts b/packages/tui/test/neta-reconnect.test.ts
new file mode 100644
index 0000000..6f07223
