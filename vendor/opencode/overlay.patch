+  type: "assistant",
+  agent: "build",
+  model: { providerID: "fixture", id: "fixture" },
+  content: [
+    { type: "text", text: `Reply ${id}` },
+    { type: "reasoning", text: "Private reasoning" },
+  ],
+  finish,
+  time: { created: 1, completed: 2 },
+})
+
+test("updates contain final replies, including autonomous replies, but no thoughts, tools, or partial streams", () => {
+  const messages: SessionMessageInfo[] = [
+    { id: "user", type: "user", text: "Question", time: { created: 0 } },
+    reply("tool-step", "tool-calls"),
+    { ...reply("streaming"), time: { created: 1 } },
+    reply("answer"),
+    { ...reply("reasoning-only"), content: [{ type: "reasoning", text: "Private" }] },
+    reply("autonomous"),
+    reply("truncated", "length"),
+  ]
+  expect(leaderUpdates(messages)).toEqual([
+    { id: "answer", text: "Reply answer", at: 2, incomplete: false },
+    { id: "autonomous", text: "Reply autonomous", at: 2, incomplete: false },
+    { id: "truncated", text: "Reply truncated", at: 2, incomplete: true },
+  ])
+})
+
+test("reply references identify the exact source without replacing the user's message", () => {
+  const text = updateReplyText({ id: "msg-1", at: 2, text: "First\nSecond" }, "Use three attempts.")
+  expect(text).toContain("message msg-1")
+  expect(text).toContain("> First\n> Second\n\nUse three attempts.")
+  expect(updateReplyText({ id: "large", at: 2, text: "x".repeat(3000) }, "yes")).toContain("[excerpt]")
+  expect(replyDeliveryLabel("uncertain")).toContain("uncertain")
+  expect(replyDeliveryLabel("discarded")).toContain("Not delivered")
+})
