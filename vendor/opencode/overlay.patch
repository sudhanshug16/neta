+import { NetaContextError, usesLegacyNetaContext, type NetaSystemBundle } from "@opencode/util/neta-contract"
+import { Effect } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const it = testEffect(PluginTestLayer)
+const names = [
+  "NETA_MANAGED_OPENCODE",
+  "NETA_NATIVE_LEADER",
+  "NETA_SYSTEM_CONTEXT_FILE",
+  "NETA_SYSTEM_CONTEXT_ACTOR_ID",
+  "NETA_SYSTEM_CONTEXT_SESSION_ID",
+  "NETA_SYSTEM_CONTEXT_GENERATION",
+] as const
+
+function fixture() {
+  const previous = Object.fromEntries(names.map((name) => [name, process.env[name]]))
+  const dir = mkdtempSync(join(tmpdir(), "neta-system-test-"))
+  const file = join(dir, "context.json")
+  const identity = { actorId: "actor", sessionId: "neta-session", generation: "3" }
+  process.env.NETA_MANAGED_OPENCODE = "1"
+  process.env.NETA_SYSTEM_CONTEXT_FILE = file
+  process.env.NETA_SYSTEM_CONTEXT_ACTOR_ID = identity.actorId
+  process.env.NETA_SYSTEM_CONTEXT_SESSION_ID = identity.sessionId
+  process.env.NETA_SYSTEM_CONTEXT_GENERATION = identity.generation
+  return {
+    file,
+    identity,
+    write(text: string, extra: Partial<NetaSystemBundle> = {}) {
+      const bundle: NetaSystemBundle = {
+        version: 1,
+        actorId: identity.actorId,
+        sessionId: identity.sessionId,
+        generation: "3",
+        role: "leader",
+        revision: text,
+        text,
+        hash: createHash("sha256").update(text).digest("hex"),
+        ...extra,
+      }
+      writeFileSync(file, JSON.stringify(bundle))
+      return bundle
+    },
+    [Symbol.dispose]() {
+      for (const name of names) {
+        if (previous[name] === undefined) delete process.env[name]
+        else process.env[name] = previous[name]
+      }
+      rmSync(dir, { recursive: true, force: true })
+    },
+  }
+}
+
+function context(): SessionHooks["context"] {
+  return {
+    sessionID: Session.ID.make("ses_provider"),
+    agent: Agent.ID.make("build"),
+    model: Model.Ref.make({ providerID: Provider.ID.make("test"), id: Model.ID.make("fake") }),
