+++ b/packages/tui/test/neta-reconnect.test.ts
@@ -0,0 +1,63 @@
+import { expect, test } from "bun:test"
+import { createNetaReconnect } from "../src/neta/reconnect"
+
+test("reconnects once after duplicate disconnect events and retries failures", async () => {
+  let calls = 0
+  let failed = false
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    connect: async () => ++calls === 2,
+    failed: () => { failed = true },
+  })
+  recovery.start()
+  recovery.start()
+  await Bun.sleep(40)
+  recovery.stop()
+  expect(calls).toBe(2)
+  expect(failed).toBe(false)
+})
+
+test("continues recovery after showing the failure notice", async () => {
+  let calls = 0
+  let failures = 0
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    attempts: 2,
+    connect: async () => ++calls === 4,
+    failed: () => { failures++ },
+  })
+  recovery.start()
+  await Bun.sleep(80)
+  expect(calls).toBe(4)
+  expect(failures).toBe(1)
+  recovery.start()
+  recovery.stop()
+  expect(calls).toBe(4)
+})
+
+test("unmount cancels scheduled and in-flight retries", async () => {
+  let calls = 0
+  let finish!: (connected: boolean) => void
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    connect: () => { calls++; return new Promise<boolean>((resolve) => { finish = resolve }) },
+    failed: () => { throw new Error("must not report after unmount") },
+  })
+  recovery.start()
+  await Bun.sleep(20)
+  recovery.stop()
+  finish(false)
+  recovery.start()
+  await Bun.sleep(20)
+  expect(calls).toBe(1)
+  let scheduled = 0
+  const cancelled = createNetaReconnect({
+    delayMs: 10,
+    connect: async () => { scheduled++; return true },
+    failed: () => {},
+  })
+  cancelled.start()
+  cancelled.stop()
+  await Bun.sleep(20)
+  expect(scheduled).toBe(0)
+})
