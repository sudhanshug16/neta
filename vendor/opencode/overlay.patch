+      try {
+        linkSync(temporary, target)
+      } catch (error) {
+        if (!(error instanceof Error && "code" in error && error.code === "EEXIST")) throw error
+      }
+    } finally {
+      database.close()
+      if (existsSync(temporary)) unlinkSync(temporary)
+    }
