+      { id: "openai/sol", name: "Sol", connected: true, preference: "prefer" },
+      { id: "remote/offline", name: "Offline", connected: false, preference: "exclude" },
+      ...[1, 2, 3, 4].map((i) => ({
+        id: `fixture/model-${i}`,
+        name: `Model ${i}`,
+        connected: true,
+        preference: "allow",
+      })),
+    ]
+    function Open() {
+      const dialog = useDialog()
+      onMount(() => {
