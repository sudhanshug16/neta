+      expect(app.captureCharFrame()).not.toContain("Allow training use?")
+      expect(saves).toEqual([{ models: { "meta/muse-spark-1.3-contributor": "allow" } }])
+      app.mockInput.pressKey(" ")
+      await app.waitForFrame((frame) => frame.includes("6/8 enabled"))
+
+      await clickText("Select all")
+      await app.waitForFrame((frame) => frame.includes("8/8 enabled"))
