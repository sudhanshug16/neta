index 0000000..282d25a
--- /dev/null
+++ b/packages/cli/src/acp/fallback.ts
@@ -0,0 +1,101 @@
+import type { ModelInfo, ModelRef } from "@opencode/client/promise"
+import { ACPError } from "./error"
+
+export function connectionFailure(error: unknown): boolean {
+  return (
+    error instanceof ACPError.AuthRequiredError ||
+    (error instanceof ACPError.ServiceFailureError &&
+      [
+        "provider.rate-limit",
+        "provider.quota",
+        "provider.no-route",
+        "provider.internal",
+        "provider.transport",
+      ].includes(error.errorName ?? ""))
+  )
+}
+
+export function parseFallbackModels(value: string | undefined): readonly string[] | undefined {
+  if (value === undefined) return undefined
+  let parsed: unknown
+  try {
+    parsed = JSON.parse(value)
+  } catch {
+    throw new Error("Invalid NETA_FALLBACK_MODELS: expected an ordered JSON array of model IDs")
+  }
+  if (
+    !Array.isArray(parsed) ||
+    !parsed.every((item): item is string => typeof item === "string" && item.trim() === item && /^[^/]+\/.+/.test(item))
+  )
+    throw new Error("Invalid NETA_FALLBACK_MODELS: expected an ordered JSON array of provider/model IDs")
+  return [...new Set(parsed)]
+}
+
+export async function withModelFallback<T>(input: {
+  permitted?: readonly string[]
+  current(): ModelRef
+  models(): Promise<{ models: readonly ModelInfo[]; defaultModel: ModelRef }>
+  safe(): boolean
+  run(): Promise<T>
+  switch(model: ModelRef): Promise<void>
+  notice(text: string): Promise<void>
+}): Promise<T> {
+  const failed = new Set<string>()
+  for (;;) {
+    try {
+      return await input.run()
+    } catch (error) {
+      if (!connectionFailure(error)) throw error
+      const previous = input.current()
+      failed.add(previous.providerID)
+      const repair = `${previous.providerID}/${previous.id} failed. Open /connect to repair or reconnect ${previous.providerID}.`
+      if (!input.safe()) {
+        await input.notice(
+          `${repair} Automatic fallback stopped because this turn already produced output or ran tools.`,
+        )
+        throw error
+      }
+      const catalog = await input.models().catch(async () => {
+        await input.notice(`${repair} Could not load connected alternatives; please repair a connection and retry.`)
+        throw error
+      })
+      const available = catalog.models.filter(
+        (model) => model.enabled && model.capabilities.tools && !failed.has(model.providerID),
+      )
+      const permitted = input.permitted?.flatMap((id) => {
+        const exact = available.find((model) => `${model.providerID}/${model.id}` === id)
+        if (exact) return [{ providerID: exact.providerID, id: exact.id }]
+        const model = available.find((model) =>
+          model.variants.some((variant) => `${model.providerID}/${model.id}/${variant.id}` === id),
+        )
+        const variant = model?.variants.find((variant) => `${model.providerID}/${model.id}/${variant.id}` === id)
+        return model && variant ? [{ providerID: model.providerID, id: model.id, variant: variant.id }] : []
+      })
+      const next =
+        input.permitted !== undefined
+          ? permitted?.[0]
+          : (available.find(
+              (model) => model.providerID === catalog.defaultModel.providerID && model.id === catalog.defaultModel.id,
+            ) ??
+            available.toSorted(
+              (a, b) =>
+                b.limit.context - a.limit.context ||
+                b.time.released - a.time.released ||
+                `${a.providerID}/${a.id}`.localeCompare(`${b.providerID}/${b.id}`),
+            )[0])
+      if (!next || failed.size >= 3) {
+        await input.notice(
+          `${repair} ${input.permitted !== undefined ? "No permitted connected fallback is available; choose an allowed model or repair its connection." : "No further connected fallback is available; please repair a connection and retry."}`,
+        )
+        throw error
+      }
+      const selected: ModelRef = {
+        providerID: next.providerID,
+        id: next.id,
+        ...("variant" in next && typeof next.variant === "string" ? { variant: next.variant } : {}),
+      }
+      await input.switch(selected)
+      await input.notice(`${repair} Continuing with ${next.providerID}/${next.id}.`)
+    }
+  }
+}
