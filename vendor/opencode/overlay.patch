+import { createEffect, createMemo, createSignal, For, onCleanup, Show, type JSX } from "solid-js"
+import { TerminalViewport, useTerminalDimensions } from "../ui/terminal-dimensions"
+import { ownerSession, type Agent, type Mission, type Snapshot, type View } from "@neta/client"
+import { deliveryLabel, deliveryNeedsAttention, parentOwner } from "./recovery"
+import { NetaArchive } from "./archive"
+import { missionDisplayState, spineStatusRank, spineWidth, stateLabel, workspaceActivity } from "./presentation"
+import { NetaStatus } from "./status"
+import { useNeta } from "./context"
+import { useNetaUpdates } from "./updates-context"
+import { useTheme } from "../context/theme"
+import { useClient } from "../context/client"
+import { useExit } from "../context/exit"
+import { useDialog } from "../ui/dialog"
+import { DialogSelect } from "../ui/dialog-select"
+import { DialogPrompt } from "../ui/dialog-prompt"
+import { DialogConfirm } from "../ui/dialog-confirm"
+import { NetaRouting } from "./routing"
+import { useToast } from "../ui/toast"
+import { Keymap } from "../context/keymap"
+import { useAttention } from "../context/attention"
+import { createNetaNotifications } from "./notifications"
+import { createNetaReconnect } from "./reconnect"
+
+export function NetaShell(props: { children: JSX.Element }) {
+  const neta = useNeta()
+  if (!neta) return props.children
+  const state = neta
+  const chatClient = useClient()
+  const updates = useNetaUpdates()!
+  const theme = useTheme()
+  const exit = useExit()
+  const dialog = useDialog()
+  const toast = useToast()
+  const [startupNotice, setStartupNotice] = createSignal(state.startupNotice)
+  const confirm = (title: string, message: string) =>
+    new Promise<boolean>((resolve) => {
+      dialog.replace(
+        () => (
+          <DialogConfirm
+            title={title}
+            message={message}
+            onConfirm={() => resolve(true)}
+            onCancel={() => resolve(false)}
+          />
+        ),
+        () => resolve(false),
+      )
+    })
+  const dimensions = useTerminalDimensions()
+  const [snapshot, setSnapshot] = createSignal(state.snapshot)
+  const [connected, setConnected] = createSignal(true)
+  const [busy, setBusy] = createSignal(false)
+  const [archived, setArchived] = createSignal(false)
+  const [collapsed, setCollapsed] = createSignal(
+    new Set(
+      state.snapshot.missions
+        .filter((mission) => !mission.agentIds.includes(state.view.owner))
+        .map((mission) => mission.id),
+    ),
+  )
+  const [archiveActor, setArchiveActor] = createSignal<Agent>()
+  const [archiveMissions, setArchiveMissions] = createSignal<Mission[]>([])
+  const [archiveAgents, setArchiveAgents] = createSignal<Record<string, Agent[]>>({})
+  const sidebarWidth = createMemo(() => spineWidth(dimensions().width))
+  const currentOwner = createMemo(() => archiveActor()?.id ?? state.view.owner)
+  const viewport = createMemo(() => ({
+    width: Math.max(1, dimensions().width - sidebarWidth() - 2),
+    height: Math.max(1, dimensions().height - (startupNotice() ? 1 : 0) - (sidebarWidth() ? 0 : 1)),
+  }))
+  const workspace = createMemo(() => snapshot().workspaces.find((one) => one.id === state.view.workspaceId))
+  const leader = createMemo(() => snapshot().leaders.find((one) => one.workspaceId === state.view.workspaceId))
+  const selected = createMemo(
+    () => archiveActor() ?? ownerSession(snapshot(), state.view.workspaceId, state.view.owner),
+  )
+  const missions = createMemo(() =>
+    [...new Map([...archiveMissions(), ...snapshot().missions].map((mission) => [mission.id, mission])).values()]
+      .filter((mission) => mission.workspaceId === state.view.workspaceId)
+      .sort((a, b) => b.createdAt.localeCompare(a.createdAt) || b.number - a.number),
+  )
+  const recentMissions = createMemo(() =>
+    missions().sort((a, b) =>
+      spineStatusRank(missionDisplayState(a, snapshot().agents, leader())) -
+        spineStatusRank(missionDisplayState(b, snapshot().agents, leader())) ||
+      b.createdAt.localeCompare(a.createdAt) || b.number - a.number,
+    ),
+  )
+  const selectedMission = createMemo(() => {
+    const actor = selected()
+    return actor && "missionId" in actor
+      ? [...snapshot().missions, ...archiveMissions()].find((mission) => mission.id === actor.missionId)
+      : undefined
+  })
+  const latestArchive = createMemo(
+    () =>
+      [...snapshot().missions, ...archiveMissions()]
+        .filter(
+          (mission) => mission.workspaceId === state.view.workspaceId && mission.state === "closed" && mission.closedAt,
+        )
+        .sort((a, b) => b.closedAt!.localeCompare(a.closedAt!))[0],
+  )
+  let refreshing: Promise<void> | undefined
+  let dirty = false
+  const reconnect = createNetaReconnect({
+    connect: () => navigate(state.view, true),
+    failed: () => setStartupNotice("Neta is still reconnecting. Saved work is retained; retries continue automatically."),
+  })
+  onCleanup(reconnect.stop)
+  createEffect(() => {
+    const status = chatClient.connection.status()
+    if (status !== "reconnecting") return
+    setStartupNotice("Chat connection lost. Reopening the saved conversation…")
+    reconnect.start()
+  })
+  const notify = createNetaNotifications(useAttention(), snapshot, state.view.workspaceId)
+  onCleanup(
+    state.client.subscribe((method, value) => {
+      notify(method, value)
+      if (method === "disconnected") {
+        setConnected(false)
+        setStartupNotice("Connection lost. Reconnecting to Neta…")
+        reconnect.start()
+        return
+      }
+      if (!["state", "event", "turn"].includes(method)) return
+      dirty = true
+      if (refreshing) return
+      refreshing = (async () => {
+        while (dirty) {
+          dirty = false
+          const before = selected()
+          setSnapshot(await state.client.request<Snapshot>("snapshot"))
+          const after = selected()
+          if (
+            !archiveActor() &&
+            after &&
+            !busy() &&
+            (after.sessionId !== state.sessionId ||
+              (before && "mode" in before && "mode" in after && before.mode !== after.mode))
+          )
+            void navigate(state.view)
+        }
+      })()
+        .catch(toast.error)
+        .finally(() => {
+          refreshing = undefined
+        })
+    }),
+  )
+
+  async function navigate(view: View, automatic = false): Promise<boolean> {
+    if (busy()) return false
+    setBusy(true)
+    try {
+      const target = view.host === state.view.host ? ownerSession(snapshot(), view.workspaceId, view.owner) : undefined
+      let migrate = false
+      if (target && target.provider !== "opencode") {
+        if (
+          !(await confirm(
+            "Move conversation to OpenCode",
+            `Start a fresh OpenCode conversation with ${target.name}? Existing Neta history is retained.`,
+          ))
+        ) {
+          setBusy(false)
+          return false
+        }
+        migrate = true
+      }
+      await state.navigate(view, migrate || undefined)
+      exit()
+      return true
+    } catch (error) {
+      if (!automatic) toast.error(error)
+      setBusy(false)
+      return false
+    }
+  }
+  function select(owner: string) {
+    if (archiveActor()?.id === owner) return
+    const actor = [...snapshot().agents, ...Object.values(archiveAgents()).flat()].find((one) => one.id === owner)
+    if (
+      actor &&
+      (actor.state === "archived" || missions().find((mission) => mission.id === actor.missionId)?.state === "closed")
+    ) {
+      setArchiveActor(actor)
+      return
+    }
+    setArchiveActor(undefined)
+    if (owner === state.view.owner) return
+    void navigate({ ...state.view, owner, tabs: [...new Set(["leader", ...state.view.tabs, owner])] })
+  }
+  async function openUpdates() {
+    await updates.setActive(true)
+    if (state.view.owner !== "leader" || archiveActor()) select("leader")
+  }
+  async function toggleArchive(picker = false) {
+    if (archived() && !picker) {
+      setArchived(false)
+      return
+    }
+    try {
+      const all: Mission[] = []
+      let cursor: string | undefined
+      do {
+        const page = await state.client.request<{ missions: Mission[]; nextCursor?: string }>("missions.list", {
+          workspaceId: state.view.workspaceId,
+          state: "closed",
+          limit: 100,
+          cursor,
+        })
+        all.push(...page.missions)
+        cursor = page.nextCursor
+      } while (cursor)
+      setArchiveMissions(all)
+      setArchived(true)
+      if (picker || !sidebarWidth()) conversations(true)
+    } catch (error) {
+      toast.error(error)
+    }
+  }
+  async function toggleMission(mission: Mission) {
+    const expand = collapsed().has(mission.id) || (mission.state === "closed" && !archiveAgents()[mission.id])
+    if (mission.state === "closed" && !archiveAgents()[mission.id]) {
+      try {
+        const detail = await state.client.request<{ agents: Agent[] }>("missions.get", { missionId: mission.id })
+        setArchiveAgents((old) => ({ ...old, [mission.id]: detail.agents }))
+      } catch (error) {
+        toast.error(error)
+        return
+      }
+    }
+    setCollapsed((old) => {
+      const next = new Set(old)
+      if (expand) next.delete(mission.id)
+      else next.add(mission.id)
+      return next
+    })
+  }
+  function conversations(history = false) {
+    dialog.replace(() => (
+      <DialogSelect
+        title={history ? "Archived missions" : "Conversations"}
+        options={
+          history
+            ? archiveMissions().map((mission) => ({
+                title: `#${mission.number} ${mission.name}`,
+                value: mission.id,
+                description: "Inspect saved conversations",
+              }))
+            : [
+                { title: `${leader()?.name} · Workspace leader`, value: "leader", description: leader()?.state },
+                ...snapshot()
+                  .agents.filter((actor) => actor.workspaceId === state.view.workspaceId)
+                  .map((actor) => ({
+                    title: actor.name,
+                    value: actor.id,
+                    description: `${stateLabel(actor.state)} · ${actor.model}`,
+                  })),
+              ]
+        }
+        onSelect={(option) => {
+          dialog.clear()
+          if (!history) {
+            select(option.value)
+            return
+          }
+          void state.client
+            .request<{ agents: Agent[] }>("missions.get", { missionId: option.value })
+            .then((detail) => {
+              if (!detail.agents.length) {
+                setStartupNotice("No saved agent conversations for this mission.")
+                return
+              }
+              dialog.replace(() => (
+                <DialogSelect
+                  title="Saved conversations"
+                  options={detail.agents.map((actor) => ({
+                    title: actor.name,
+                    value: actor.id,
+                    description: actor.model,
+                  }))}
+                  onSelect={(choice) => {
+                    dialog.clear()
+                    setArchiveAgents((old) => ({ ...old, [option.value]: detail.agents }))
+                    setCollapsed((old) => {
+                      const next = new Set(old)
+                      next.delete(option.value)
+                      return next
+                    })
+                    setArchiveActor(detail.agents.find((actor) => actor.id === choice.value))
+                  }}
+                />
+              ))
+            })
+            .catch(toast.error)
+        }}
+      />
+    ))
+  }
+  function deliveryActions(agent: Agent) {
+    const mission = snapshot().missions.find((item) => item.id === agent.missionId)
+    dialog.replace(() => (
+      <DialogSelect
+        title={`${agent.name}: ${deliveryLabel(agent) ?? "No pending delivery"}`}
+        options={[
+          {
+            title: "Inspect parent conversation",
+            value: "parent",
+            description:
+              agent.deliveryStatus === "uncertain"
+                ? "Acceptance is uncertain; the runtime will not resend this prompt automatically."
+                : "Inbox acceptance does not mean the parent has reviewed the result.",
+          },
+          { title: "Inspect worker result", value: "child", description: `Actual model: ${agent.model}` },
+          ...(agent.deliveryStatus === "pending" || agent.deliveryStatus === "failed"
+            ? [
+                {
+                  title: "Retry pending result delivery",
+                  value: "retry",
+                  description: "Retry unsent results only; never replay uncertain prompts.",
+                },
+              ]
+            : []),
+        ]}
+        onSelect={(option) => {
+          dialog.clear()
+          if (option.value === "parent") select(parentOwner(agent, mission))
+          else if (option.value === "child") select(agent.id)
+          else
+            void state.client
+              .request<{ pending: number; uncertain: boolean }>("runtime.retryReports", { agentId: agent.id })
+              .then((result) => {
+                setStartupNotice(
+                  result.uncertain
+                    ? "Delivery remains uncertain. Inspect the parent conversation before taking further action."
+                    : result.pending
+                      ? "Result delivery is pending; it will retry when the parent is available."
+                      : "Pending results were accepted by the parent inbox.",
+                )
+              })
+              .catch(toast.error)
+        }}
+      />
+    ))
+  }
+  function deliveries() {
+    const agents = snapshot().agents.filter(
+      (agent) => agent.workspaceId === state.view.workspaceId && agent.state !== "archived" && agent.deliveryStatus,
+    )
+    if (!agents.length) {
+      setStartupNotice("No worker result deliveries in this workspace.")
+      return
+    }
+    dialog.replace(() => (
+      <DialogSelect
+        title="Worker result delivery"
+        options={agents.map((agent) => ({
+          title: agent.name,
+          value: agent.id,
+          description: deliveryLabel(agent),
+        }))}
+        onSelect={(option) => {
+          const agent = agents.find((item) => item.id === option.value)
+          if (agent) deliveryActions(agent)
+        }}
+      />
+    ))
+  }
+  function workspaces() {
+    dialog.replace(() => (
+      <DialogSelect
+        title="Switch workspace"
+        placeholder="Find a workspace…"
+        current={state.view.workspaceId}
+        footer={
+          <box flexDirection="column" gap={1}>
