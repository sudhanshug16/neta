@@ -0,0 +1,14 @@
+import type { Agent, Mission } from "@neta/client"
+
+export function deliveryLabel(agent: Agent): string | undefined {
+  switch (agent.deliveryStatus) {
+    case "pending": return "Result queued"
+    case "accepted": return ["running", "starting", "queued"].includes(agent.state) ? undefined : "Result received by parent inbox"
+    case "uncertain": return "Delivery uncertain · review parent"
+    case "failed": return "Parent unavailable · retry delivery"
+  }
+}
+
+export function parentOwner(agent: Agent, mission?: Mission): string {
+  return agent.canSpawn || mission?.lead?.kind !== "agent" ? "leader" : mission.lead.agentId
+}
diff --git a/packages/tui/src/neta/routing.tsx b/packages/tui/src/neta/routing.tsx
new file mode 100644
index 0000000..35e27ea
--- /dev/null
+++ b/packages/tui/src/neta/routing.tsx
@@ -0,0 +1,324 @@
+import type { Agent, Leader, Mission, NetaClient, RoutingAuthStatus } from "@neta/client"
+import { InputRenderable, TextAttributes } from "@opentui/core"
+import { createSignal, For, onCleanup, onMount, Show } from "solid-js"
+import { Keymap } from "../context/keymap"
+import { useTheme } from "../context/theme"
+import { useDialog } from "../ui/dialog"
+import { useTerminalDimensions } from "../ui/terminal-dimensions"
+import { modelDecisionText } from "./presentation"
+import { NetaModelPreferences } from "./model-preferences"
+
+type RoutingLogs = {
+  agents: Agent[]
+  missions: Mission[]
+  changes?: {
+    kind?: string
+    at: string
+    agentId?: string
+    missionId?: string
+    data: Record<string, string | number | boolean | null>
+  }[]
+}
+
+export function NetaRouting(props: {
+  actor: Agent | Leader
+  client: Pick<NetaClient, "request">
+  machineName: string
+}) {
+  const theme = useTheme().surface("dialog")
+  const dialog = useDialog()
+  const dimensions = useTerminalDimensions()
+  const [logs, setLogs] = createSignal<RoutingLogs>()
+  const [logError, setLogError] = createSignal(false)
+  const [status, setStatus] = createSignal<RoutingAuthStatus>()
+  const [message, setMessage] = createSignal("")
+  const [failed, setFailed] = createSignal(false)
+  const [busy, setBusy] = createSignal(false)
+  const [editing, setEditing] = createSignal(true)
+  let input: InputRenderable
+  let secret = ""
+  let disposed = false
+
+  onMount(() => {
+    void props.client
+      .request<RoutingLogs>("routing.logs", {
+        workspaceId: props.actor.workspaceId,
+      })
+      .then((result) => {
+        if (!disposed) setLogs(result)
+      })
+      .catch(() => {
+        if (!disposed) setLogError(true)
+      })
+  })
+
+  onMount(async () => {
+    try {
+      const result = await props.client.request<RoutingAuthStatus>("routing.auth.status")
+      if (!disposed && !status()) setStatus(result)
+    } catch {
+      if (!disposed && !status()) {
+        setFailed(true)
+        setMessage("Cannot load key status. Check the Neta connection and reopen /routing.")
+      }
+    }
+  })
+  onCleanup(() => {
+    disposed = true
+    secret = ""
+  })
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    commands: [
+      {
+        bind: "f2",
+        title: "Model preferences",
+        group: "Dialog",
+        run: () => {
+          openPreferences()
+        },
+      },
+      {
+        bind: "tab",
+        title: "Switch routing field",
+        group: "Dialog",
+        run: () => {
+          setEditing(!editing())
+        },
+      },
+    ],
+  }))
+
+  function replace(start: number, end: number, text: string) {
+    const next = secret.slice(0, start) + text + secret.slice(end)
+    if (next.length > 4096 || /[^\x21-\x7e]/.test(next)) {
+      setFailed(true)
+      setMessage("Use an API key without spaces (up to 4096 characters).")
+      return
+    }
+    secret = next
+    // The renderable, selection and undo buffers receive masks only, never the key.
+    input.value = "*".repeat(secret.length)
+    input.cursorOffset = start + text.length
+    setFailed(false)
+    setMessage("")
+  }
+
+  async function save() {
+    if (busy()) return
+    if (!secret) {
+      setFailed(true)
+      setMessage("Paste or type your Jev API key first.")
+      return
+    }
+    setBusy(true)
+    setMessage("")
+    try {
+      const result = await props.client.request<RoutingAuthStatus>("routing.auth.save", { apiKey: secret })
+      if (disposed) return
+      replace(0, secret.length, "")
+      setStatus(result)
+      setMessage("Key saved. Ready for the next delegation; not yet verified with Jev.")
+    } catch {
+      // A remote error may include input. Do not echo it into the terminal or toast log.
+      if (!disposed) {
+        setFailed(true)
+        setMessage("Could not save the key. Check the Neta connection and data-directory access, then retry.")
+      }
+    } finally {
+      if (!disposed) setBusy(false)
+    }
+  }
+
+  function openPreferences() {
+    if (busy()) return
+    dialog.replace(() => (
+      <NetaModelPreferences
+        client={props.client}
+        workspaceId={props.actor.workspaceId}
+        machineName={props.machineName}
+        back={() => {
+          dialog.replace(() => <NetaRouting {...props} />)
+          dialog.setSize("large")
+        }}
+      />
+    ))
+    dialog.setSize("large")
+    dialog.setCentered(true)
+  }
+
+  return (
+    <box
+      paddingLeft={2}
+      paddingRight={2}
+      paddingBottom={1}
+      gap={1}
+      maxHeight={Math.max(12, Math.floor(dimensions().height * 0.75) - 4)}
+    >
+      <box flexDirection="row" justifyContent="space-between" flexShrink={0}>
+        <text attributes={TextAttributes.BOLD} fg={theme.text.base}>
+          Session routing log
+        </text>
+        <text fg={theme.text.muted} onMouseUp={() => dialog.clear()}>
+          esc
+        </text>
+      </box>
+      <scrollbox flexShrink={1} minHeight={3} focused={!editing()}>
+        <Show
+          when={logs()}
+          fallback={
+            <text fg={theme.text.muted}>
+              {logError() ? "Cannot load routing logs. Reopen /routing to retry." : "Loading routing logs…"}
+            </text>
+          }
+        >
+          <Show
+            when={logs()!.agents.length > 0}
+            fallback={<text fg={theme.text.muted}>No routing decisions recorded for this workspace yet.</text>}
+          >
+            <For each={logs()!.agents.toReversed()}>
+              {(agent) => {
+                const mission = () => logs()!.missions.find((item) => item.id === agent.missionId)
+                return (
+                  <box flexShrink={0} marginBottom={1} gap={1}>
+                    <text fg={theme.text.base} attributes={TextAttributes.BOLD}>
+                      {agent.name} · #{mission()?.number ?? "?"} · {agent.state}
+                    </text>
+                    <text fg={theme.text.muted}>{modelDecisionText(agent)}</text>
+                  </box>
+                )
+              }}
+            </For>
+          </Show>
+          <For each={logs()!.changes?.toReversed()}>
+            {(event) => (
+              <box flexShrink={0} marginBottom={1} gap={1}>
+                <text fg={theme.text.base} attributes={TextAttributes.BOLD}>
+                  {event.kind === "routing.failed"
+                    ? "Routing failed"
+                    : `${logs()!.agents.find((agent) => agent.id === event.agentId)?.name ?? "Agent"} · #${logs()!.missions.find((mission) => mission.id === event.missionId)?.number ?? "?"} · Model change`}{" "}
+                  · {event.at}
+                </text>
+                <text fg={theme.text.muted}>
+                  {[
+                    event.data.model ? `${event.data.previousModel} → ${event.data.model}` : undefined,
+                    event.data.effort ? `Task effort ${event.data.effort}/5` : undefined,
+                    event.data.method ? `Routing: ${event.data.method}` : undefined,
+                    event.data.reason,
+                    event.data.warnings,
+                  ]
+                    .filter(Boolean)
+                    .join("\n\n")}
+                </text>
+              </box>
+            )}
+          </For>
+        </Show>
+      </scrollbox>
+      <box flexShrink={0}>
+        <text fg={theme.text.base} attributes={TextAttributes.BOLD}>
+          Jev API key · {props.machineName}
+        </text>
+        <text fg={theme.text.muted}>
+          {status()?.error ??
+            (status()?.source === "saved"
+              ? "Configured · saved privately on this machine"
+              : status()?.source === "environment"
+                ? "Configured · TYPESAFE_API_KEY (saving here replaces it)"
+                : status()
+                  ? "Not configured · fixed routing needs no key"
+                  : "Checking key status…")}
+        </text>
+        <input
+          id="neta-routing-key"
+          ref={(value: InputRenderable) => {
+            input = value
+          }}
+          focused={editing() && !busy()}
+          selectable={false}
+          placeholder={status()?.configured ? "Paste a replacement key" : "Paste your TypeSafe/Jev API key"}
+          placeholderColor={theme.text.muted}
+          textColor={theme.text.formfield.base}
+          focusedTextColor={theme.text.formfield.base}
+          backgroundColor={theme.background.formfield.base}
+          focusedBackgroundColor={theme.background.formfield.base}
+          cursorColor={theme.text.base}
+          onPaste={(event) => {
+            event.preventDefault()
+            event.stopPropagation()
+            if (!busy()) replace(input.cursorOffset, input.cursorOffset, new TextDecoder().decode(event.bytes).trim())
+          }}
+          onKeyDown={(event) => {
+            if (event.name === "f2") {
+              event.preventDefault()
+              event.stopPropagation()
+              openPreferences()
+              return
+            }
+            if (event.name === "escape" || event.name === "tab") return
+            event.preventDefault()
+            event.stopPropagation()
+            if (busy()) return
+            const cursor = input.cursorOffset
+            if (event.name === "return") {
+              void save()
+              return
+            }
+            if (event.ctrl && event.name === "u") {
+              replace(0, secret.length, "")
+              return
+            }
+            if (event.ctrl && event.name === "k") {
+              replace(cursor, secret.length, "")
+              return
+            }
+            if (event.name === "home" || (event.ctrl && event.name === "a")) {
+              input.cursorOffset = 0
+              return
+            }
+            if (event.name === "end" || (event.ctrl && event.name === "e")) {
+              input.cursorOffset = secret.length
+              return
+            }
+            if (event.name === "left") {
+              input.cursorOffset = Math.max(0, cursor - 1)
+              return
+            }
+            if (event.name === "right") {
+              input.cursorOffset = Math.min(secret.length, cursor + 1)
+              return
+            }
+            if (event.name === "backspace") {
+              replace(Math.max(0, cursor - 1), cursor, "")
+              return
+            }
+            if (event.name === "delete") {
+              replace(cursor, cursor + 1, "")
+              return
+            }
+            if (!event.ctrl && !event.meta && !event.super && !event.option && /^[\x20-\x7e]$/.test(event.sequence))
+              replace(cursor, cursor, event.sequence)
+          }}
+        />
+        <text fg={failed() ? theme.text.feedback.error.base : theme.text.muted}>
+          {busy() ? "Saving…" : message() || "Private to this machine; routing policy stays unchanged."}
+        </text>
+        <box flexDirection="row" gap={1}>
+          <text
+            fg={theme.text.action.primary.base}
+            onMouseUp={() => {
+              void save()
+            }}
+          >
+            enter save
+          </text>
+          <text fg={theme.text.muted}>· ctrl+u clear · tab {editing() ? "details" : "key"} ·</text>
+          <text fg={theme.text.action.primary.base} onMouseUp={openPreferences}>
+            f2 models
+          </text>
+        </box>
+      </box>
+    </box>
+  )
+}
diff --git a/packages/tui/src/neta/shell.tsx b/packages/tui/src/neta/shell.tsx
new file mode 100644
index 0000000..98fbb29
--- /dev/null
+++ b/packages/tui/src/neta/shell.tsx
@@ -0,0 +1,814 @@
+import { createEffect, createMemo, createSignal, For, onCleanup, Show, type JSX } from "solid-js"
+import { TerminalViewport, useTerminalDimensions } from "../ui/terminal-dimensions"
+import { ownerSession, type Agent, type Mission, type Snapshot, type View } from "@neta/client"
+import { deliveryLabel, parentOwner } from "./recovery"
+import { NetaArchive } from "./archive"
+import { missionDisplayState, spineStatusRank, spineWidth, stateLabel, workspaceActivity } from "./presentation"
+import { NetaStatus } from "./status"
+import { useNeta } from "./context"
+import { useTheme } from "../context/theme"
+import { useClient } from "../context/client"
+import { useExit } from "../context/exit"
+import { useDialog } from "../ui/dialog"
+import { DialogSelect } from "../ui/dialog-select"
+import { DialogPrompt } from "../ui/dialog-prompt"
+import { DialogConfirm } from "../ui/dialog-confirm"
+import { NetaRouting } from "./routing"
+import { useToast } from "../ui/toast"
+import { Keymap } from "../context/keymap"
+import { useAttention } from "../context/attention"
+import { createNetaNotifications } from "./notifications"
+import { createNetaReconnect } from "./reconnect"
+
+export function NetaShell(props: { children: JSX.Element }) {
+  const neta = useNeta()
+  if (!neta) return props.children
+  const state = neta
+  const chatClient = useClient()
+  const theme = useTheme()
+  const exit = useExit()
+  const dialog = useDialog()
+  const toast = useToast()
+  const [startupNotice, setStartupNotice] = createSignal(state.startupNotice)
+  const confirm = (title: string, message: string) =>
+    new Promise<boolean>((resolve) => {
+      dialog.replace(
+        () => (
+          <DialogConfirm
+            title={title}
+            message={message}
+            onConfirm={() => resolve(true)}
+            onCancel={() => resolve(false)}
+          />
+        ),
+        () => resolve(false),
+      )
+    })
+  const dimensions = useTerminalDimensions()
+  const [snapshot, setSnapshot] = createSignal(state.snapshot)
+  const [connected, setConnected] = createSignal(true)
+  const [busy, setBusy] = createSignal(false)
+  const [archived, setArchived] = createSignal(false)
+  const [collapsed, setCollapsed] = createSignal(
+    new Set(
+      state.snapshot.missions
+        .filter((mission) => !mission.agentIds.includes(state.view.owner))
+        .map((mission) => mission.id),
+    ),
+  )
+  const [archiveActor, setArchiveActor] = createSignal<Agent>()
+  const [archiveMissions, setArchiveMissions] = createSignal<Mission[]>([])
+  const [archiveAgents, setArchiveAgents] = createSignal<Record<string, Agent[]>>({})
+  const sidebarWidth = createMemo(() => spineWidth(dimensions().width))
+  const currentOwner = createMemo(() => archiveActor()?.id ?? state.view.owner)
+  const viewport = createMemo(() => ({
+    width: Math.max(1, dimensions().width - sidebarWidth() - 2),
+    height: Math.max(1, dimensions().height - (startupNotice() ? 1 : 0) - (sidebarWidth() ? 0 : 1)),
+  }))
+  const workspace = createMemo(() => snapshot().workspaces.find((one) => one.id === state.view.workspaceId))
+  const leader = createMemo(() => snapshot().leaders.find((one) => one.workspaceId === state.view.workspaceId))
+  const selected = createMemo(
+    () => archiveActor() ?? ownerSession(snapshot(), state.view.workspaceId, state.view.owner),
+  )
+  const resetTarget = () => {
+    if (state.view.owner === "neta") return { sessionId: state.sessionId, name: "Workspace leader" }
+    if (state.view.owner === "filter") return { sessionId: state.sessionId, name: "Filter" }
+    if (state.view.owner === "leader") {
+      const coordinator = leader()
+      return coordinator ? { sessionId: coordinator.sessionId, name: "Coordinator" } : undefined
+    }
+    return selected()
+  }
+  const missions = createMemo(() =>
+    [...new Map([...archiveMissions(), ...snapshot().missions].map((mission) => [mission.id, mission])).values()]
+      .filter((mission) => mission.workspaceId === state.view.workspaceId)
+      .sort((a, b) => b.createdAt.localeCompare(a.createdAt) || b.number - a.number),
+  )
+  const recentMissions = createMemo(() =>
+    missions().sort((a, b) =>
+      spineStatusRank(a.state === "closed" ? "closed" : missionDisplayState(a, snapshot().agents)) -
+        spineStatusRank(b.state === "closed" ? "closed" : missionDisplayState(b, snapshot().agents)) ||
+      b.createdAt.localeCompare(a.createdAt) || b.number - a.number,
+    ),
+  )
+  const selectedMission = createMemo(() => {
+    const actor = selected()
+    return actor && "missionId" in actor
+      ? [...snapshot().missions, ...archiveMissions()].find((mission) => mission.id === actor.missionId)
+      : undefined
+  })
+  const latestArchive = createMemo(
+    () =>
+      [...snapshot().missions, ...archiveMissions()]
+        .filter(
+          (mission) => mission.workspaceId === state.view.workspaceId && mission.state === "closed" && mission.closedAt,
+        )
+        .sort((a, b) => b.closedAt!.localeCompare(a.closedAt!))[0],
+  )
+  let refreshing: Promise<void> | undefined
+  let dirty = false
+  const reconnect = createNetaReconnect({
+    connect: () => navigate(state.view, true),
+    failed: () => setStartupNotice("Neta is still reconnecting. Saved work is retained; retries continue automatically."),
+  })
+  onCleanup(reconnect.stop)
+  createEffect(() => {
+    const status = chatClient.connection.status()
+    if (status !== "reconnecting") return
+    setStartupNotice("Chat connection lost. Reopening the saved conversation…")
+    reconnect.start()
+  })
+  const notify = createNetaNotifications(useAttention(), state.view.workspaceId)
+  onCleanup(
+    state.client.subscribe((method, value) => {
+      notify(method, value)
+      if (method === "disconnected") {
+        setConnected(false)
+        setStartupNotice("Connection lost. Reconnecting to Neta…")
+        reconnect.start()
+        return
+      }
+      if (method === "chats.reset") {
+        if (
+          typeof value === "object" &&
+          value !== null &&
+          "workspaceId" in value &&
+          value.workspaceId === state.view.workspaceId &&
+          (state.view.owner === "leader" || state.view.owner === "neta" || state.view.owner === "filter") &&
+          !busy()
+        )
+          void navigate(state.view, true)
+        return
+      }
+      if (!["state", "event", "turn"].includes(method)) return
+      dirty = true
+      if (refreshing) return
+      refreshing = (async () => {
+        while (dirty) {
+          dirty = false
+          setSnapshot(await state.client.request<Snapshot>("snapshot"))
+          const after = selected()
+          if (
+            !archiveActor() &&
+            after &&
+            !busy() &&
+            after.sessionId !== state.sessionId
+          )
+            void navigate(state.view)
+        }
+      })()
+        .catch(toast.error)
+        .finally(() => {
+          refreshing = undefined
+        })
+    }),
+  )
+
+  async function navigate(view: View, automatic = false): Promise<boolean> {
+    if (busy()) return false
+    setBusy(true)
+    try {
+      const target = view.host === state.view.host ? ownerSession(snapshot(), view.workspaceId, view.owner) : undefined
+      let migrate = false
+      if (target && target.provider !== "opencode") {
+        if (
+          !(await confirm(
+            "Move conversation to OpenCode",
+            `Start a fresh OpenCode conversation with ${target.name}? Existing Neta history is retained.`,
+          ))
+        ) {
+          setBusy(false)
+          return false
+        }
+        migrate = true
+      }
+      await state.navigate(view, migrate || undefined)
+      exit()
+      return true
+    } catch (error) {
+      if (!automatic) toast.error(error)
+      setBusy(false)
+      return false
+    }
+  }
+  function select(owner: string) {
+    if (archiveActor()?.id === owner) return
+    const actor = [...snapshot().agents, ...Object.values(archiveAgents()).flat()].find((one) => one.id === owner)
+    if (
+      actor &&
+      (actor.state === "archived" || missions().find((mission) => mission.id === actor.missionId)?.state === "closed")
+    ) {
+      setArchiveActor(actor)
+      return
+    }
+    setArchiveActor(undefined)
+    if (owner === state.view.owner) return
+    void navigate({ ...state.view, owner, tabs: [...new Set(["leader", ...state.view.tabs, owner])] })
+  }
+  function openWorkspaceLeader() {
+    setArchiveActor(undefined)
+    if (state.view.owner === "neta") return
+    void navigate({ ...state.view, owner: "neta", tabs: [...new Set(["leader", ...state.view.tabs, "neta"])] })
+  }
+
+  async function toggleArchive(picker = false) {
+    if (archived() && !picker) {
+      setArchived(false)
+      return
+    }
+    try {
+      const all: Mission[] = []
+      let cursor: string | undefined
+      do {
+        const page = await state.client.request<{ missions: Mission[]; nextCursor?: string }>("missions.list", {
+          workspaceId: state.view.workspaceId,
+          state: "closed",
+          limit: 100,
+          cursor,
+        })
+        all.push(...page.missions)
+        cursor = page.nextCursor
+      } while (cursor)
+      setArchiveMissions(all)
+      setArchived(true)
+      if (picker || !sidebarWidth()) conversations(true)
+    } catch (error) {
+      toast.error(error)
+    }
+  }
+  async function toggleMission(mission: Mission) {
+    const expand = collapsed().has(mission.id) || (mission.state === "closed" && !archiveAgents()[mission.id])
+    if (mission.state === "closed" && !archiveAgents()[mission.id]) {
+      try {
+        const detail = await state.client.request<{ agents: Agent[] }>("missions.get", { missionId: mission.id })
+        setArchiveAgents((old) => ({ ...old, [mission.id]: detail.agents }))
+      } catch (error) {
+        toast.error(error)
+        return
+      }
+    }
+    setCollapsed((old) => {
+      const next = new Set(old)
+      if (expand) next.delete(mission.id)
+      else next.add(mission.id)
+      return next
+    })
+  }
+  function conversations(history = false) {
+    dialog.replace(() => (
+      <DialogSelect
+        title={history ? "Archived missions" : "Conversations"}
+        options={
+          history
+            ? archiveMissions().map((mission) => ({
+                title: `#${mission.number} ${mission.name}`,
+                value: mission.id,
+                description: "Inspect saved conversations",
+              }))
+            : [
+                { title: "Workspace leader", value: "neta", description: "Chat about this workspace" },
+                { title: "Filter", value: "filter", description: "Message filtering conversation" },
+                { title: "Coordinator", value: "leader", description: stateLabel(leader()?.state ?? "idle") },
+                ...snapshot()
+                  .agents.filter((actor) => actor.workspaceId === state.view.workspaceId)
+                  .map((actor) => ({
+                    title: actor.name,
+                    value: actor.id,
+                    description: `${stateLabel(actor.state)} · ${actor.model}`,
+                  })),
+              ]
+        }
+        onSelect={(option) => {
+          dialog.clear()
+          if (!history) {
+            select(option.value)
+            return
+          }
+          void state.client
+            .request<{ agents: Agent[] }>("missions.get", { missionId: option.value })
+            .then((detail) => {
+              if (!detail.agents.length) {
+                setStartupNotice("No saved agent conversations for this mission.")
+                return
+              }
+              dialog.replace(() => (
+                <DialogSelect
+                  title="Saved conversations"
+                  options={detail.agents.map((actor) => ({
+                    title: actor.name,
+                    value: actor.id,
+                    description: actor.model,
+                  }))}
+                  onSelect={(choice) => {
+                    dialog.clear()
+                    setArchiveAgents((old) => ({ ...old, [option.value]: detail.agents }))
+                    setCollapsed((old) => {
+                      const next = new Set(old)
+                      next.delete(option.value)
+                      return next
+                    })
+                    setArchiveActor(detail.agents.find((actor) => actor.id === choice.value))
+                  }}
+                />
+              ))
+            })
+            .catch(toast.error)
+        }}
+      />
+    ))
+  }
+  function deliveryActions(agent: Agent) {
