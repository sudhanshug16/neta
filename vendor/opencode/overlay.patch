+          expect(existsSync(`${f.file}.applied.json`)).toBe(false)
+        }
+      }
+      for (const text of ["", "   ", "{broken", "[]"]) {
+        writeFileSync(f.file, text)
+        expect((yield* Effect.exit(hooks.trigger("session", "context", context())))._tag).toBe("Failure")
