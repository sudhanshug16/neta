+          machineId: "mac",
+          name: "Mace",
+          sessionId: "neta-session",
+          provider: "opencode",
+          model: "provider/fixture",
+          mode: "lead",
+          state: "running",
+        },
+      ],
+      missions: [],
+      agents: [],
+    }
+    const messages: SessionMessageInfo[] = [
+      { id: "user", type: "user", text: "Review the branch", time: { created: 0 } },
+      ...Array.from(
+        { length: 8 },
+        (_, i): SessionMessageInfo => ({
+          id: `answer-${i}`,
+          type: "assistant",
+          agent: "build",
+          model: info.model!,
+          content: [
+            {
+              type: "text",
+              text:
+                i === 0
+                  ? "The provider fallback change is ready for review.\n\nThe focused tests pass."
+                  : i === 1
+                    ? "## Verification result\n\n- **Evidence checked**\n- `claim_service.rb` inspected\n\n| Issue | Result |\n| --- | --- |\n| #2575 | Not reproduced |\n\nFurther details after the preview."
+                    : `Update ${i}: the mission report arrived while you were away.`,
+            },
+          ],
+          finish: "stop",
+          time: { created: 1 + i * 10, completed: 2 + i * 10 },
+        }),
+      ),
+    ]
+    const events = createEventStream()
+    let paginate = false
+    let olderLoads = 0
+    const calls = createFetch((url, request) => {
+      if (url.pathname === "/api/session") return json({ data: [info], cursor: {} })
+      if (url.pathname === `/api/session/${info.id}`) return json({ data: info })
+      if (url.pathname === `/api/session/${info.id}/message`) {
+        if (!paginate) return json({ data: messages.toReversed(), cursor: {} })
+        if (url.searchParams.has("cursor")) {
+          olderLoads++
+          return json({ data: messages.slice(0, -2).toReversed(), cursor: {} })
+        }
+        return json({ data: messages.slice(-2).toReversed(), cursor: { next: "older" } })
+      }
+      if (url.pathname === `/api/session/${info.id}/inbox` || url.pathname === `/api/session/${info.id}/permission`)
+        return json({ data: [] })
+      if (url.pathname === "/api/agent") return json({ location: { directory }, data: [agent("build", info.model)] })
+      if (url.pathname === "/api/model") return json({ location: { directory }, data: [model("fixture")] })
+      if (url.pathname.endsWith("/agent") && request.method === "POST") return new Response(null, { status: 204 })
+      return undefined
+    }, events)
+    const server = Bun.serve({ port: 0, idleTimeout: 0, fetch: (request) => calls.fetch(request) })
+    const sent: string[] = []
+    let fail = true
+    let status: "queued" | "delivered" = "queued"
+    client.request = async <T,>(method: string): Promise<T> => {
+      if (method === "snapshot") return snapshot as T
+      if (method === "conversation.inbox") return { messages: [{ id: "receipt", status }] } as T
+      throw new Error(`Unexpected Neta request: ${method}`)
+    }
+    const boot = async () => {
+      const setup = await createTestRenderer({ width, height: 46, useThread: false, kittyKeyboard: true })
+      setup.renderer.start()
+      const task = Effect.runPromise(
+        run({
+          app: { name: "test", version: "test", channel: "test" },
+          server: { endpoint: { url: server.url.toString() } },
+          config: { get: async () => ({ animations: false, tabs: { enabled: false } }), update: async () => ({}) },
+          packages: { prepare: async () => ({ directory: "" }) },
+          args: { sessionID: info.id },
+          terminalHandoff: async () => ({ renderer: setup.renderer, mode: "dark", complete: () => {} }),
+          log: () => {},
+          neta: {
+            client,
+            snapshot,
+            sessionId: "neta-session",
+            hosts: [],
+            drafts: new Map(),
+            view: { host: "local", path: directory, workspaceId: "w", owner: "leader", tabs: ["leader"] },
+            navigate: async () => {
+              throw new Error("Updates must remain in the same session")
+            },
+            send: async (input) => {
+              if (fail) throw new Error("Fixture offline")
+              sent.push(input.text)
+              return { messageId: "receipt", status }
+            },
+          },
+        }).pipe(Effect.provide(Global.layerWith({ state: state.path })), Effect.provide(FileSystem.layerNoop({}))),
+      )
+      const click = async (text: string) => {
+        const lines = setup.captureCharFrame().split("\n")
+        const row = lines.findIndex((line) => line.includes(text))
+        if (row < 0) throw new Error(`Missing ${text}\n${setup.captureCharFrame()}`)
+        await setup.mockMouse.click(lines[row]!.indexOf(text) + 2, row)
+      }
+      return { ...setup, task, click }
+    }
+    let app = await boot()
+    try {
+      await app.waitForFrame((frame) => frame.includes("8 unread"))
+      await app.mockInput.typeText("/updates")
+      app.mockInput.pressEnter()
+      await app.waitForFrame((frame) => frame.includes("[ Mark all read a ]") && frame.includes("Update 7:"))
+      expect(app.captureCharFrame()).not.toContain("The focused tests pass.")
+      app.mockInput.pressKey("\u001b[5~")
+      app.mockInput.pressKey("\u001b[5~")
+      app.mockInput.pressKey("\u001b[5~")
+      await app.waitForFrame((frame) => frame.includes("The focused tests pass."))
+      expect(app.captureCharFrame()).toContain("[ Chat ]")
+      expect(app.captureCharFrame()).toContain("The focused tests pass.")
+      await app.waitForFrame((frame) => frame.includes("Evidence checked"))
+      expect(app.captureCharFrame()).not.toContain("**Evidence checked**")
+      expect(app.captureCharFrame()).not.toContain("## Verification result")
+      expect(app.captureCharFrame()).not.toContain("enter expand")
+      if (process.env.NETA_TEST_CAPTURE === "1")
+        await Bun.write(`/tmp/neta-updates-reading-${width}.json`, JSON.stringify(app.captureSpans()))
+      expect(app.renderer.currentFocusedEditor).toBeNull()
+      const find = (node: Renderable): ScrollBoxRenderable | undefined =>
+        node.id === "neta-updates-list" && node instanceof ScrollBoxRenderable
+          ? node
+          : node.getChildren().map(find).find(Boolean)
+      const scroll = find(app.renderer.root)!
+      expect(scroll).toBeDefined()
+      // Every update is complete without selection or an expansion action.
+      scroll.scrollBy(12)
+      await app.waitForFrame((frame) => frame.includes("Further details after the preview."))
+      expect(app.captureCharFrame()).toContain("Not reproduced")
+      expect(app.captureCharFrame()).not.toContain("| --- |")
+      if (process.env.NETA_TEST_CAPTURE === "1")
+        await Bun.write(`/tmp/neta-updates-formatted-${width}.json`, JSON.stringify(app.captureSpans()))
+      scroll.scrollTo(0)
+      await app.waitForFrame((frame) => frame.includes("The focused tests pass."))
+      app.mockInput.pressKey("\u001b[6~")
+      await app.waitFor(() => scroll.scrollTop > 0)
+      const beforeArrival = scroll.scrollTop
+      app.mockInput.pressKey("a")
+      await app.waitForFrame((frame) => frame.includes("[ Updates · 0 ]"))
+      expect(scroll.scrollTop).toBe(beforeArrival)
+      expect(app.captureCharFrame()).not.toContain("[ Reply")
+      expect(app.captureCharFrame()).not.toContain("↑↓ select")
+      const newReply: SessionMessageInfo = {
+        id: "answer-new",
+        type: "assistant",
+        agent: "build",
+        model: info.model!,
+        content: [{ type: "text", text: "New background mission result" }],
+        finish: "stop",
+        time: { created: 91, completed: 95 },
+      }
+      messages.push(newReply)
+      events.emit({
+        id: "evt_start",
+        type: "session.step.started",
+        created: 91,
+        location: { directory },
+        durable: { aggregateID: info.id, seq: 1, version: 1 },
+        data: { sessionID: info.id, assistantMessageID: newReply.id, agent: "build", model: info.model! },
+      })
+      events.emit({
+        id: "evt_text_start",
+        type: "session.text.started",
+        created: 92,
+        location: { directory },
+        durable: { aggregateID: info.id, seq: 2, version: 1 },
+        data: { sessionID: info.id, assistantMessageID: newReply.id, ordinal: 0 },
+      })
+      events.emit({
+        id: "evt_text",
+        type: "session.text.ended",
+        created: 93,
+        location: { directory },
+        durable: { aggregateID: info.id, seq: 3, version: 1 },
+        data: {
+          sessionID: info.id,
+          assistantMessageID: newReply.id,
+          ordinal: 0,
+          text: "New background mission result",
+        },
+      })
+      events.emit({
+        id: "evt_end",
+        type: "session.step.ended",
+        created: 95,
+        location: { directory },
+        durable: { aggregateID: info.id, seq: 4, version: 1 },
+        data: { sessionID: info.id, assistantMessageID: newReply.id, finish: "stop", cost: 0, tokens: info.tokens },
+      })
+      await app.waitForFrame((frame) => frame.includes("1 new update") && frame.includes("1 unread"))
+      expect(scroll.scrollTop).toBe(beforeArrival)
+      expect(app.captureCharFrame()).not.toContain("New background mission result")
+      app.mockInput.pressKey("\u001b[5~")
+      await app.waitFor(() => scroll.scrollTop === 0)
+      app.mockInput.pressKey("i")
