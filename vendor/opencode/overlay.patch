@@ -0,0 +1,98 @@
+import { createSignal, For, onCleanup, onMount, Show } from "solid-js"
+import type { Agent, NetaClient } from "@neta/client"
+import { useTheme } from "../context/theme"
+import { archiveTimestamp } from "./presentation"
+
+type Page = { blocks: { seq: number; role: string; kind: string; text: string }[]; prevCursor?: string | null }
+
+/** Reading history never opens an ACP process or offers a prompt field. */
+export function NetaArchive(props: { actor: Agent; client: Pick<NetaClient, "request">; onBack(): void }) {
+  const theme = useTheme()
+  const elevated = useTheme().surface("dialog")
+  const [blocks, setBlocks] = createSignal<Page["blocks"]>([])
+  const [cursor, setCursor] = createSignal<string | null>()
+  const [busy, setBusy] = createSignal(false)
+  const [error, setError] = createSignal("")
+  let disposed = false
+  async function load() {
+    if (busy()) return
+    setBusy(true)
+    setError("")
+    try {
+      const page = await props.client.request<Page>("conversation.tail", {
+        sessionId: props.actor.sessionId,
+        direction: "backward",
+        limit: 100,
+        ...(cursor() == null ? {} : { cursor: cursor() }),
+      })
+      if (disposed) return
+      setBlocks((old) => [...page.blocks, ...old])
+      setCursor(page.prevCursor ?? null)
+    } catch (error) {
+      if (!disposed) setError(error instanceof Error ? error.message : "Could not load saved conversation")
+    } finally {
+      if (disposed)
+        void props.client.request("conversation.untail", { sessionId: props.actor.sessionId }).catch(() => {})
+      else setBusy(false)
+    }
+  }
+  onMount(() => void load())
+  onCleanup(() => {
+    disposed = true
+    void props.client.request("conversation.untail", { sessionId: props.actor.sessionId }).catch(() => {})
+  })
+  return (
+    <box flexDirection="column" flexGrow={1} minHeight={0} paddingLeft={2} paddingRight={2}>
+      <text fg={theme.text.muted}>Saved transcript · input disabled · opening this view does not restart work</text>
+      <Show when={error()}>
+        <text fg={theme.text.feedback.error.base}>{error()}</text>
+      </Show>
+      <scrollbox flexGrow={1} minHeight={0}>
+        <For each={blocks()}>
+          {(block) => (
+            <box
+              flexDirection="column"
+              marginTop={1}
+              padding={block.role === "user" || block.kind === "tool" ? 1 : 0}
+              backgroundColor={
+                block.role === "user"
+                  ? elevated.background.raised.base
+                  : block.kind === "tool"
+                    ? elevated.background.raised.high
+                    : undefined
+              }
+            >
+              <Show when={block.kind === "tool"}>
+                <text fg={theme.text.muted}>Tool</text>
+              </Show>
+              <text fg={theme.text.base}>{block.text}</text>
+            </box>
+          )}
+        </For>
+        <Show when={!blocks().length && !busy() && !error()}>
+          <text fg={theme.text.muted}>No saved output.</text>
+        </Show>
+      </scrollbox>
+      <Show when={archiveTimestamp(props.actor.endedAt, true)}>
+        <text fg={theme.text.muted}>Session ended · {archiveTimestamp(props.actor.endedAt, true)}</text>
+      </Show>
+      <box
+        height={2}
+        border={["top"]}
+        borderColor={theme.border.base}
+        flexDirection="row"
+        justifyContent="space-between"
+        flexShrink={0}
+      >
+        <text fg={theme.text.action.primary.base} onMouseUp={props.onBack}>
+          [ Back to coordinator ]
+        </text>
+        <Show when={cursor() != null || error()}>
+          <text fg={theme.text.muted} onMouseUp={() => void load()}>
+            {busy() ? "Loading…" : error() ? "[ Retry loading history ]" : "[ Load older output ]"}
+          </text>
+        </Show>
+      </box>
+    </box>
+  )
+}
