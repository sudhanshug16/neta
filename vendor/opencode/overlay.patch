@@ -0,0 +1,41 @@
+import { expect, test } from "bun:test"
+import { Database } from "bun:sqlite"
+import { mkdtempSync, readFileSync, rmSync } from "node:fs"
+import { join } from "node:path"
+import { tmpdir } from "node:os"
+import { databasePath } from "../src/database-path"
+
+test("Neta snapshots committed WAL history once and leaves V1 writable", () => {
+  const directory = mkdtempSync(join(tmpdir(), "neta-v2-copy-"))
+  const saved = { managed: process.env.NETA_MANAGED_OPENCODE, db: process.env.OPENCODE_DB, source: process.env.NETA_OPENCODE_V1_DB }
+  const legacy = join(directory, "opencode-local.db")
+  const source = new Database(legacy)
+  try {
+    process.env.NETA_MANAGED_OPENCODE = "1"
+    delete process.env.OPENCODE_DB
+    delete process.env.NETA_OPENCODE_V1_DB
+    source.run("PRAGMA journal_mode=WAL")
+    source.run("CREATE TABLE history (text TEXT)")
+    source.run("INSERT INTO history VALUES ('existing conversation')")
+    const original = readFileSync(legacy)
+    const wal = readFileSync(`${legacy}-wal`)
+    const target = databasePath(directory)
+    expect(target).toBe(join(directory, "opencode-neta-v2.db"))
+    const copy = new Database(target)
+    try {
+      expect(copy.query("SELECT text FROM history").get()).toEqual({ text: "existing conversation" })
+      expect(readFileSync(legacy)).toEqual(original)
+      expect(readFileSync(`${legacy}-wal`)).toEqual(wal)
+      source.run("INSERT INTO history VALUES ('later V1 message')")
+      expect(databasePath(directory)).toBe(target)
+      expect(copy.query("SELECT COUNT(*) AS count FROM history").get()).toEqual({ count: 1 })
+    } finally { copy.close() }
+  } finally {
+    source.close()
+    for (const [key, value] of [["NETA_MANAGED_OPENCODE", saved.managed], ["OPENCODE_DB", saved.db], ["NETA_OPENCODE_V1_DB", saved.source]] as const) {
+      if (value === undefined) delete process.env[key]
+      else process.env[key] = value
+    }
+    rmSync(directory, { recursive: true, force: true })
+  }
+})
diff --git a/packages/core/src/plugin/neta-context.ts b/packages/core/src/plugin/neta-context.ts
new file mode 100644
index 0000000..ae8040d
--- /dev/null
+++ b/packages/core/src/plugin/neta-context.ts
@@ -0,0 +1,132 @@
+import { createHash, randomUUID } from "node:crypto"
+import { readFileSync, renameSync, rmSync, writeFileSync } from "node:fs"
+import { define } from "@opencode/plugin/effect/plugin"
+import type { SessionHooks } from "@opencode/plugin/effect/session"
+import {
+  NetaContextError,
+  usesLegacyNetaContext,
+  type NetaSystemAcknowledgment,
+  type NetaSystemBundle,
+} from "@opencode/util/neta-contract"
+import { Effect } from "effect"
+
+export function readNetaSystemBundle(
+  file: string,
+  identity: {
+    actorId: string | undefined
+    sessionId: string | undefined
+    generation: string | undefined
+  },
+): NetaSystemBundle {
+  let value: unknown
+  try {
+    value = JSON.parse(readFileSync(file, "utf8"))
+  } catch {
+    throw new NetaContextError(
+      "Neta instruction context is missing or malformed. Reopen the conversation to restore its context.",
+    )
+  }
+  if (!value || typeof value !== "object") throw new NetaContextError("Invalid Neta instruction context bundle")
+  const bundle = value as Record<string, unknown>
+  if (
+    bundle.version !== 1 ||
+    typeof bundle.actorId !== "string" ||
+    !bundle.actorId ||
+    typeof bundle.sessionId !== "string" ||
+    !bundle.sessionId ||
+    typeof bundle.generation !== "string" ||
+    !bundle.generation ||
+    !["leader", "lead", "agent"].includes(String(bundle.role)) ||
+    typeof bundle.revision !== "string" ||
+    !bundle.revision ||
+    typeof bundle.text !== "string" ||
+    !bundle.text ||
+    typeof bundle.hash !== "string" ||
+    !/^[a-f0-9]{64}$/.test(bundle.hash)
+  )
+    throw new NetaContextError("Invalid Neta instruction context bundle")
+  if (
+    bundle.actorId !== identity.actorId ||
+    bundle.sessionId !== identity.sessionId ||
+    bundle.generation !== identity.generation
+  )
+    throw new NetaContextError(
+      "Neta instruction context belongs to a different runtime binding. Reopen the conversation.",
+    )
+  if (createHash("sha256").update(bundle.text).digest("hex") !== bundle.hash)
+    throw new NetaContextError("Neta instruction context checksum mismatch. Reopen the conversation.")
+  return bundle as unknown as NetaSystemBundle
+}
+
+export const NetaLeaderPlugin = define({
+  id: "neta.leader-reminder",
+  effect: Effect.fn("NetaLeaderPlugin")(function* (ctx) {
+    const remind = (hook: NetaSystemAcknowledgment["hook"]) => (event: SessionHooks["context"]) =>
+      Effect.sync(() => {
+        if (process.env.NETA_MANAGED_OPENCODE !== "1") return
+        const file = process.env.NETA_SYSTEM_CONTEXT_FILE
+        if (!file) throw new NetaContextError("Neta instruction context path is missing. Reopen the conversation.")
+        // An already running pre-bundle Node can launch a newly installed
+        // OpenCode after reset. Honor that explicitly identifiable protocol;
+        // never downgrade a partial or malformed modern binding to plaintext.
+        let legacy: { version: 0; role: "leader" | "agent"; text: string } | undefined
+        if (usesLegacyNetaContext(process.env)) {
+          let text: string
+          try {
+            text = readFileSync(file, "utf8")
+          } catch {
+            throw new NetaContextError(
+              "The running older Neta service did not publish its instructions. Run neta again after updating the service.",
+            )
+          }
+          if (!text.trim() || /^[\s]*[\[{]/.test(text))
+            throw new NetaContextError(
+              "The running older Neta service supplied invalid plaintext instructions. Update the service and run neta again.",
+            )
+          legacy = { version: 0, text, role: process.env.NETA_NATIVE_LEADER === "1" ? "leader" : "agent" }
+        }
+        const bundle =
+          legacy ??
+          readNetaSystemBundle(file, {
+            actorId: process.env.NETA_SYSTEM_CONTEXT_ACTOR_ID,
+            sessionId: process.env.NETA_SYSTEM_CONTEXT_SESSION_ID,
+            generation: process.env.NETA_SYSTEM_CONTEXT_GENERATION,
+          })
+        const marker = "Neta standing instructions\n"
+        event.system = event.system.filter((part) => !part.text.startsWith(marker))
+        const system = event.system[0]
+        if (!system)
+          throw new NetaContextError("Neta cannot apply standing instructions: model request has no system section")
+        event.system.push({ ...system, text: marker + bundle.text })
+        const reminder =
+          bundle.role === "agent"
+            ? "Neta worker reminder: Honor your assigned scope and access. When assigned read-only work, shell access is for inspection only: do not edit files, change Git state, install dependencies, or make external changes. Report evidence and blockers. Shell access is not authorization to exceed your assignment. Runtime activity and parent notifications are automatic. Use neta_done only when the bounded assignment is complete; otherwise explain the blocker in your final response."
+            : "Neta leader reminder: You may run shell commands for inspection, including git status and git log. Read the Current assignment section for your own access; the mission access ceiling is not your write ownership. Put sustained implementation work in a mission and delegate bounded parts to workers. Keep edits in the appropriate mission worktree, coordinate with its writer, and honor the user's charter and approval requirements. Before staffing, read neta_status.modelCatalog. For a new delegation supply task effort 1–5 and omit model so Neta routes through user preferences; a model is never inherited from you. Exact model overrides require an explicit user request and still respect exclusions. Use neta_model for user-requested changes to an existing agent. Report only the actual returned model. An open PR remains an open mission awaiting review or merge; send follow-ups to the existing agent with neta_send. Runtime activity and parent notifications are automatic. Explain the result or blocker in your final response. This is guidance, not a tool restriction."
+        if (!system.text.includes(reminder)) event.system[0] = { ...system, text: `${system.text}\n\n${reminder}` }
+        // Legacy context has no binding identity. Apply its standing text, but
+        // never manufacture a modern verification receipt for it.
+        if (bundle.version === 0) return
+        // This acknowledges local request construction, never provider acceptance or execution.
+        const acknowledgment: NetaSystemAcknowledgment = {
+          version: 1,
+          actorId: bundle.actorId,
+          sessionId: bundle.sessionId,
+          generation: bundle.generation,
+          revision: bundle.revision,
+          hash: bundle.hash,
+          hook,
+        }
+        const target = `${file}.applied.json`
+        const temporary = `${target}.${randomUUID()}.tmp`
+        try {
+          writeFileSync(temporary, JSON.stringify(acknowledgment), { mode: 0o600, flag: "wx" })
+          renameSync(temporary, target)
+        } finally {
+          rmSync(temporary, { force: true })
+        }
+      })
+    yield* ctx.session.hook("context", remind("context"))
+    yield* ctx.session.hook("compaction", remind("compaction"))
+    yield* ctx.session.hook("generate", remind("generate"))
+  }),
+})
