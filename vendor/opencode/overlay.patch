+import type { OpenCodeClient } from "@opencode/client/promise"
+import { createContext, useContext, type JSX } from "solid-js"
+import type { NetaClient, Snapshot, View, SavedHost } from "@neta/client"
+import type { PromptInfo } from "../prompt/history"
+import { NetaUpdatesProvider } from "./updates-context"
+import type { NetaSendReceipt } from "./updates-model"
+
+export type NetaDraft = { prompt: PromptInfo; cursor: number }
+
+export type NetaView = {
+  startupNotice?: string
+  client: NetaClient
+  snapshot: Snapshot
+  view: View
+  sessionId: string
+  send(input: Parameters<OpenCodeClient["session"]["prompt"]>[0] & { command?: string; skill?: string }): Promise<NetaSendReceipt | void>
+  hosts: SavedHost[]
+  navigate(view: View, migrate?: boolean): Promise<void>
+  drafts: Map<string, NetaDraft>
+}
+
+const Context = createContext<NetaView>()
+export function NetaProvider(props: { value?: NetaView; children: JSX.Element }) {
+  return (
+    <Context.Provider value={props.value}>
+      {props.value ? <NetaUpdatesProvider neta={props.value}>{props.children}</NetaUpdatesProvider> : props.children}
+    </Context.Provider>
+  )
+}
+export function useNeta() {
+  return useContext(Context)
+}
diff --git a/packages/tui/src/neta/model-preferences.tsx b/packages/tui/src/neta/model-preferences.tsx
new file mode 100644
index 0000000..c209efb
--- /dev/null
+++ b/packages/tui/src/neta/model-preferences.tsx
@@ -0,0 +1,148 @@
+import type { NetaClient } from "@neta/client"
+import { createSignal, onCleanup, onMount } from "solid-js"
+import { useTheme } from "../context/theme"
+import { DialogSelect, type DialogSelectRef } from "../ui/dialog-select"
+
+type Preference = "allow" | "prefer" | "exclude"
+type Model = { id: string; name: string; connected: boolean; preference: Preference }
+
+export function NetaModelPreferences(props: {
+  client: Pick<NetaClient, "request">
+  workspaceId: string
+  machineName: string
+  back(): void
+}) {
+  const theme = useTheme("elevated")
+  const [models, setModels] = createSignal<Model[]>([])
+  const [busy, setBusy] = createSignal(true)
+  const [message, setMessage] = createSignal("Loading connected models…")
+  let list: DialogSelectRef<string> | undefined
+  let disposed = false
+  onCleanup(() => {
+    disposed = true
+  })
+  async function refresh() {
+    setBusy(true)
+    setModels([])
+    try {
+      const result = await props.client.request<{ models: Model[] }>("routing.preferences.list", {
+        workspaceId: props.workspaceId,
+      })
+      if (disposed) return
+      setModels(result.models)
+      setMessage("Changes save automatically. Bulk actions affect all models.")
+    } catch {
+      if (!disposed)
+        setMessage("Could not refresh connected models. Check the OpenCode connection, then press f5 to retry.")
+    } finally {
+      if (!disposed) setBusy(false)
+    }
+  }
+  onMount(refresh)
+
+  async function save(changes: Record<string, Preference>) {
+    if (busy()) return
+    const entries = Object.entries(changes)
+    if (!entries.length) return
+    setBusy(true)
+    try {
+      await props.client.request("routing.preferences.save", { models: changes })
+      if (disposed) return
+      setModels((rows) => rows.map((row) => (changes[row.id] ? { ...row, preference: changes[row.id] } : row)))
+      setMessage(`Saved ${entries.length} model preference${entries.length === 1 ? "" : "s"}.`)
+    } catch {
+      if (!disposed) {
+        setMessage("Could not save. Check the connection and try again.")
+      }
+    } finally {
+      if (!disposed) setBusy(false)
+    }
+  }
+
+  function toggle(id = list?.selected?.value) {
+    const model = models().find((model) => model.id === id)
+    if (model) void save({ [model.id]: model.preference === "exclude" ? "allow" : "exclude" })
+  }
+
+  function prefer() {
+    const model = models().find((model) => model.id === list?.selected?.value)
+    if (model) void save({ [model.id]: model.preference === "prefer" ? "allow" : "prefer" })
+  }
+
+  function selectAll(enabled: boolean) {
+    void save(
+      Object.fromEntries(
+        models()
+          .filter((model) => (enabled ? model.preference === "exclude" : model.preference !== "exclude"))
+          .map((model) => [model.id, enabled ? "allow" : "exclude"]),
+      ),
+    )
+  }
+
+  return (
+    <box>
+      <DialogSelect
+        title={`Model preferences · ${props.machineName}`}
+        placeholder="Search models or providers"
+        locked={busy()}
+        preserveSelection
+        ref={(ref) => {
+          list = ref
+        }}
+        options={models().map((model) => ({
+          title: `${model.preference === "exclude" ? "[ ]" : "[x]"} ${model.name}`,
+          value: model.id,
+          description: `${model.id.split("/")[0]}${model.preference === "prefer" ? " · Preferred" : ""}${model.connected ? "" : " · disconnected"}`,
+          searchText: model.id,
+        }))}
+        onSelect={(option) => toggle(option.value)}
+        onCancel={props.back}
+        bindings={[
+          {
+            bind: "f5",
+            title: "Refresh models",
+            group: "Dialog",
+            run: () => {
+              if (!busy()) void refresh()
+            },
+          },
+          { bind: "space", title: "Toggle model", group: "Dialog", run: () => toggle() },
+          { bind: "f2", title: "Select all models", group: "Dialog", run: () => selectAll(true) },
+          { bind: "f3", title: "Deselect all models", group: "Dialog", run: () => selectAll(false) },
+          { bind: "f4", title: "Prefer or unprefer model", group: "Dialog", run: prefer },
+        ]}
+        footer={
+          <box gap={0}>
+            <text fg={theme.text.subdued}>
+              {models().filter((model) => model.preference !== "exclude").length}/{models().length} enabled ·
+              space/enter toggle · f4 prefer · f5 refresh
+            </text>
+            <box flexDirection="row" gap={2}>
+              <text
+                fg={busy() ? theme.text.action.primary.disabled : theme.text.action.primary.default}
+                onMouseUp={() => selectAll(true)}
+              >
+                Select all f2
+              </text>
+              <text
+                fg={busy() ? theme.text.action.primary.disabled : theme.text.action.primary.default}
+                onMouseUp={() => selectAll(false)}
+              >
+                Deselect all f3
+              </text>
+              <text
+                fg={busy() ? theme.text.action.primary.disabled : theme.text.action.primary.default}
+                onMouseUp={prefer}
+              >
+                Prefer f4
+              </text>
+            </box>
+            <text fg={theme.text.subdued}>
+              {busy() ? (models().length ? "Saving…" : "Loading connected models…") : message()}
+            </text>
+          </box>
+        }
+      />
+    </box>
+  )
+}
diff --git a/packages/tui/src/neta/notifications.ts b/packages/tui/src/neta/notifications.ts
