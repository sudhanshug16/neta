@@ -0,0 +1,332 @@
+import { createEffect, createMemo, createSignal, For, onCleanup, Show } from "solid-js"
+import { ScrollBoxRenderable } from "@opentui/core"
+import { useRenderer } from "@opentui/solid"
+import { Keymap } from "../context/keymap"
+import { useTheme, useThemes } from "../context/theme"
+import { useConfig } from "../config"
+import { usePlugin } from "../plugin/context"
+import { useDialog } from "../ui/dialog"
+import { DialogSelect } from "../ui/dialog-select"
+import { DialogAlert } from "../ui/dialog-alert"
+import { useToast } from "../ui/toast"
+import { SplitBorder } from "../ui/border"
+import { useNetaUpdates } from "./updates-context"
+import { replyDeliveryLabel, type LeaderUpdate, type UpdateReference } from "./updates-model"
+
+export function NetaUpdateTabs(props: { onChat: () => void; onUpdates: () => void }) {
+  const updates = useNetaUpdates()!
+  const theme = useTheme()
+  return (
+    <box flexDirection="row" height={2} flexShrink={0} gap={2} border={["bottom"]} borderColor={theme.border.default}>
+      <text
+        fg={!updates.active() ? theme.text.action.primary.default : theme.text.action.secondary.default}
+        onMouseUp={props.onChat}
+      >
+        [ Chat ]
+      </text>
+      <text
+        fg={updates.active() ? theme.text.action.primary.default : theme.text.action.secondary.default}
+        onMouseUp={props.onUpdates}
+      >
+        [ Updates{updates.unread() === undefined ? "" : ` · ${updates.unread()}${updates.hasMore() ? "+" : ""}`} ]
+      </text>
+    </box>
+  )
+}
+
+export function NetaUpdates(props: {
+  items: LeaderUpdate[]
+  loaded: boolean
+  name: string
+  more: boolean
+  loadMore: () => Promise<unknown>
+  onChat: (id?: string) => void
+  onCompose: () => void
+}) {
+  const updates = useNetaUpdates()!
+  const theme = useTheme()
+  const { currentSyntax: syntax } = useThemes()
+  const plugins = usePlugin()
+  const config = useConfig()
+  const renderer = useRenderer()
+  const dialog = useDialog()
+  const toast = useToast()
+  const [filter, setFilter] = createSignal(updates.reading()?.filter ?? "unread")
+  const [loading, setLoading] = createSignal(false)
+  // Freeze the visible membership while reading. Arrivals and read changes must
+  // not remove a row under the reader or move their cursor.
+  const [visible, setVisible] = createSignal<string[]>([])
+  let seeded = false
+  let disposed = false
+  let scroll: ScrollBoxRenderable | undefined
+  const visibleIDs = createMemo(() => new Set(visible()))
+  const items = createMemo(() => props.items.filter((item) => visibleIDs().has(item.id)))
+  const newItems = createMemo(() => props.items.filter((item) => !visibleIDs().has(item.id) && !updates.isRead(item)))
+  function refresh() {
+    const next = props.items.filter((item) => filter() === "all" || !updates.isRead(item))
+    setVisible(next.map((item) => item.id))
+  }
+  createEffect(() => {
+    if (seeded || !props.loaded) return
+    seeded = true
+    void updates.saveReading({ reference: undefined })
+    void (async () => {
+      setLoading(true)
+      try {
+        if (disposed) return
+        refresh()
+        requestAnimationFrame(() =>
+          requestAnimationFrame(() => {
+            if (scroll && !scroll.isDestroyed) scroll.scrollTo(scroll.scrollHeight)
+          }),
+        )
+      } catch (error) {
+        toast.error(error)
+      } finally {
+        setLoading(false)
+      }
+    })()
+  })
+  onCleanup(() => {
+    disposed = true
+    void updates.saveReading({
+      filter: filter(),
+    })
+  })
+  function reveal(id: string) {
+    requestAnimationFrame(() => {
+      const row = scroll?.getRenderable(`update-${id}`)
+      if (!scroll || !row || scroll.isDestroyed) return
+      if (row.y < scroll.viewport.y) scroll.scrollBy(row.y - scroll.viewport.y)
+      else if (row.y + row.height > scroll.viewport.y + scroll.viewport.height)
+        scroll.scrollBy(
+          Math.min(row.y - scroll.viewport.y, row.y + row.height - scroll.viewport.y - scroll.viewport.height),
+        )
+    })
+  }
+  async function loadMore() {
+    if (loading()) return
+    setLoading(true)
+    const before = scroll?.scrollHeight ?? 0
+    try {
+      await props.loadMore()
+      refresh()
+      requestAnimationFrame(() =>
+        requestAnimationFrame(() => {
+          if (scroll && !scroll.isDestroyed) scroll.scrollBy(scroll.scrollHeight - before)
+        }),
+      )
+    } catch (error) {
+      toast.error(error)
+    } finally {
+      setLoading(false)
+    }
+  }
+  Keymap.createLayer(() => ({
+    priority: 25,
+    enabled: () => dialog.stack.length === 0 && renderer.currentFocusedEditor === null,
+    commands: [
+      { bind: "pageup", title: "Scroll updates up", run: () => scroll?.scrollBy(-(scroll.viewport.height - 2)) },
+      { bind: "pagedown", title: "Scroll updates down", run: () => scroll?.scrollBy(scroll.viewport.height - 2) },
+      { bind: "a", title: "Mark all updates read", run: () => void updates.markAllRead(props.items.at(-1)?.at ?? -1) },
+      { bind: "i", title: "Focus composer", run: props.onCompose },
+      { bind: "escape", title: "Return to chat", run: () => props.onChat() },
+    ],
+  }))
+  return (
+    <box flexGrow={1} minHeight={0}>
+      <box flexDirection="row" justifyContent="space-between" height={2} flexShrink={0}>
+        <text
+          fg={theme.text.action.secondary.default}
+          onMouseUp={() => {
+            setFilter(filter() === "all" ? "unread" : "all")
+            refresh()
+          }}
+        >
+          [ {filter() === "all" ? "All" : "Unread"} ▾ ]
+        </text>
+        <text
+          fg={theme.text.action.secondary.default}
+          onMouseUp={() => void updates.markAllRead(props.items.at(-1)?.at ?? -1)}
+        >
+          [ Mark all read a ]
+        </text>
+        <Show when={newItems().length}>
+          <text
+            fg={theme.text.action.primary.default}
+            onMouseUp={() => {
+              const id = newItems().at(-1)?.id
+              refresh()
+              if (id) reveal(id)
+            }}
+          >
+            [ {newItems().length} new update{newItems().length === 1 ? "" : "s"} ↓ ]
+          </text>
+        </Show>
+      </box>
+      <scrollbox
+        id="neta-updates-list"
+        ref={(value) => {
+          scroll = value
+        }}
+        flexGrow={1}
+        minHeight={0}
+        stickyScroll={false}
+        verticalScrollbarOptions={{
+          visible: true,
+          trackOptions: { backgroundColor: theme.background.default, foregroundColor: theme.border.default },
+        }}
+      >
+        <Show when={props.more}>
+          <text fg={theme.text.action.secondary.default} marginBottom={1} onMouseUp={() => void loadMore()}>
+            [ {loading() ? "Loading…" : "Load older updates"} ]
+          </text>
+        </Show>
+        <Show when={!items().length}>
+          <text fg={theme.text.subdued}>
+            {loading()
+              ? "Loading your saved reading position…"
+              : props.items.length
+                ? "No unread updates. Choose All to see read replies."
+                : props.more
+                  ? "No completed replies in this page. Load older updates."
+                  : "Completed leader replies will appear here."}
+          </text>
+        </Show>
+        <For each={items()}>
+          {(item) => {
+            const read = () => !!updates.isRead(item)
+            return (
+              <box
+                id={`update-${item.id}`}
+                flexShrink={0}
+                paddingLeft={1}
+                paddingRight={1}
+                paddingTop={1}
+                paddingBottom={1}
+                marginBottom={1}
+                border={["left"]}
+                customBorderChars={SplitBorder.customBorderChars}
+                borderColor={theme.border.default}
+                backgroundColor={theme.background.default}
+              >
+                <box flexDirection="row" marginBottom={1}>
+                  <text width={2} flexShrink={0} fg={read() ? theme.text.subdued : theme.text.action.primary.default}>
+                    {read() ? "○" : "●"}
+                  </text>
+                  <text flexGrow={1} minWidth={0} wrapMode="none" truncate fg={theme.text.default}>
+                    {props.name}
+                  </text>
+                  <text flexShrink={0} fg={theme.text.subdued}>
+                    {new Date(item.at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false })} ·{" "}
+                    {item.incomplete ? "INCOMPLETE" : read() ? "READ" : "UNREAD"}
+                  </text>
+                </box>
+                <box flexShrink={0}>
+                  <markdown
+                    width="100%"
+                    flexShrink={0}
+                    syntaxStyle={syntax()}
+                    renderNode={plugins.markdown()}
+                    content={item.text}
+                    streaming={false}
+                    internalBlockMode="top-level"
+                    tableOptions={{ style: "grid", cellPaddingX: 1, widthMode: "content" }}
+                    conceal={config.data.session?.markdown !== "source"}
+                    fg={theme.markdown.text}
+                    bg={theme.background.default}
+                  />
+                </box>
+                <text marginTop={1} fg={theme.text.action.secondary.default} onMouseUp={() => props.onChat(item.id)}>
+                  [ Show in chat ]
+                </text>
+              </box>
+            )
+          }}
+        </For>
+      </scrollbox>
+      <text fg={theme.text.subdued} height={1} flexShrink={0}>
+        a mark all read · i compose
+      </text>
+    </box>
+  )
+}
+
+export function NetaReplyReference(props: { reference: UpdateReference; name: string; onRemove: () => void }) {
+  const theme = useTheme("elevated")
+  return (
+    <box
+      paddingLeft={1}
+      paddingRight={1}
+      marginBottom={1}
+      border={["left"]}
+      borderColor={theme.border.default}
+      customBorderChars={SplitBorder.customBorderChars}
+      backgroundColor={theme.background.default}
+    >
+      <box flexDirection="row">
+        <text flexGrow={1} minWidth={0} truncate wrapMode="none" fg={theme.text.default}>
+          ↳ To {props.name} ·{" "}
+          {new Date(props.reference.at).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", hour12: false })}
+        </text>
+        <text fg={theme.text.action.secondary.default} onMouseUp={props.onRemove}>
+          [ × Remove reference ]
+        </text>
+      </box>
+      <text fg={theme.text.subdued} truncate wrapMode="none">
+        {props.reference.text.replaceAll("\n", " ")}
+      </text>
+    </box>
+  )
+}
+
+export function NetaReplyReceipt() {
+  const updates = useNetaUpdates()!
+  const theme = useTheme()
+  const dialog = useDialog()
+  const replies = () => updates.reading()?.replies ?? []
+  const latest = () => replies().at(-1)
+  const view = () =>
+    dialog.replace(() => (
+      <DialogSelect
+        title="Replies to leader updates"
+        options={replies().map((reply, index) => ({
+          value: index,
+          title: reply.text.replaceAll("\n", " "),
+          description: replyDeliveryLabel(reply.status),
+        }))}
+        onSelect={(option) => {
+          const reply = replies()[option.value]
+          if (reply) dialog.replace(() => <DialogAlert title={replyDeliveryLabel(reply.status)} message={reply.text} />)
+        }}
+      />
+    ))
+  return (
+    <Show when={latest()}>
+      {(reply) => (
+        <box flexShrink={0} marginBottom={1}>
+          <box flexDirection="row">
+            <text
+              flexGrow={1}
+              minWidth={0}
+              fg={
+                reply().status === "uncertain" || reply().status === "discarded"
+                  ? theme.text.feedback.warning.default
+                  : theme.text.subdued
+              }
+            >
+              {replyDeliveryLabel(reply().status)}
+              {replies().length > 1 ? ` · ${replies().length} replies` : ""}
+            </text>
+            <text fg={theme.text.action.secondary.default} onMouseUp={view}>
+              [ View ]
+            </text>
+          </box>
+          <text fg={theme.text.subdued} truncate wrapMode="none">
+            {reply().text}
+          </text>
+        </box>
+      )}
+    </Show>
+  )
+}
