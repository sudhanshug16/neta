new file mode 100644
index 0000000..716190c
--- /dev/null
+++ b/packages/tui/src/neta/updates-model.ts
@@ -0,0 +1,59 @@
+import type { SessionMessageInfo } from "@opencode/client"
+
+export type LeaderUpdate = { id: string; text: string; at: number; incomplete: boolean }
+export type UpdateReference = Pick<LeaderUpdate, "id" | "text" | "at">
+
+/** Use final visible replies, never reasoning, tool output, or intermediate tool steps. */
+export function leaderUpdates(
+  messages: readonly SessionMessageInfo[],
+  previous: readonly LeaderUpdate[] = [],
+): LeaderUpdate[] {
+  const prior = new Map(previous.map((item) => [item.id, item]))
+  return messages.flatMap((message) => {
+    if (message.type !== "assistant" || message.time.completed === undefined || message.finish === "tool-calls")
+      return []
+    const text = message.content
+      .flatMap((part) => (part.type === "text" ? [part.text] : []))
+      .join("\n\n")
+      .trim()
+    if (!text) return []
+    const item = {
+      id: message.id,
+      text,
+      at: message.time.completed,
+      incomplete: message.finish !== "stop" || !!message.error,
+    }
+    const old = prior.get(item.id)
+    return [old && old.text === item.text && old.at === item.at && old.incomplete === item.incomplete ? old : item]
+  })
+}
+
+export function updateReplyText(reference: UpdateReference, text: string) {
+  const excerpt = reference.text.slice(0, 2000)
+  return `Reply to your update at ${new Date(reference.at).toISOString()} (message ${reference.id}):\n${excerpt
+    .split("\n")
+    .map((line) => `> ${line}`)
+    .join("\n")}${reference.text.length > excerpt.length ? "\n> [excerpt]" : ""}\n\n${text}`
+}
+
+export type NetaSendReceipt = {
+  messageId?: string
+  status?: "queued" | "delivering" | "delivered" | "uncertain" | "discarded"
+}
+
+export function replyDeliveryLabel(status: NetaSendReceipt["status"]) {
+  switch (status) {
+    case "queued":
+      return "Queued · waiting for the leader"
+    case "delivering":
+      return "Delivering to the leader"
+    case "delivered":
+      return "Delivered to the leader"
+    case "uncertain":
+      return "Delivery uncertain · check chat before retrying"
+    case "discarded":
+      return "Not delivered · message was discarded"
+    default:
+      return "Accepted · delivery status unavailable"
+  }
+}
