+import { expect, test } from "bun:test"
+import { RGBA } from "@opentui/core"
+import { allThemes, parseTheme, resolveThemeDocument } from "../src/theme"
+
+test("Neta resolves the Paper palette in chat, controls and dialogs without color inference", () => {
+  for (const mode of ["dark", "light"] as const) {
+    const theme = resolveThemeDocument(parseTheme(allThemes().neta, "neta"), mode)
+    expect(theme.background.base.equals(RGBA.fromHex("#171717"))).toBeTrue()
+    expect(theme.background.raised.base.equals(RGBA.fromHex("#111315"))).toBeTrue()
+    expect(theme.text.base.equals(RGBA.fromHex("#E5E7EB"))).toBeTrue()
+    expect(theme.text.muted.equals(RGBA.fromHex("#A5ADB3"))).toBeTrue()
+    expect(theme.text.action.primary.base.equals(RGBA.fromHex("#E8B86D"))).toBeTrue()
+    expect(theme.background.formfield.selected.equals(RGBA.fromHex("#322A1E"))).toBeTrue()
+    expect(theme.border.base.equals(RGBA.fromHex("#363B40"))).toBeTrue()
+    const dialog = theme.surface("dialog")
+    expect(dialog.background.base.equals(RGBA.fromHex("#1B1E21"))).toBeTrue()
+    expect(dialog.background.action.primary.focused.equals(RGBA.fromHex("#322A1E"))).toBeTrue()
+    expect(dialog.text.action.primary.focused.equals(RGBA.fromHex("#E8B86D"))).toBeTrue()
+    expect(dialog.background.raised.base.equals(RGBA.fromHex("#303030"))).toBeTrue()
+    expect(dialog.background.raised.high.equals(RGBA.fromHex("#252525"))).toBeTrue()
+  }
+})
