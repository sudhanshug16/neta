+import { expect, test } from "bun:test"
+import { testRender } from "@opentui/solid"
+import { createSignal, For } from "solid-js"
+import { NetaStatus } from "../src/neta/status"
+import { stateLabel } from "../src/neta/presentation"
+import { ConfigProvider } from "../src/config"
+import { ThemeProvider } from "../src/context/theme"
+import { createTuiResolvedConfig } from "./fixture/tui-runtime"
+
+for (const mode of ["dark", "light"] as const) {
+  test(`status marks render distinctly and stop animating when work stops (${mode})`, async () => {
+    const [state, setState] = createSignal("running")
+    const app = await testRender(
+      () => (
+        <ConfigProvider config={createTuiResolvedConfig()}>
+          <ThemeProvider mode={mode} defaultName="neta" source={{ discover: async () => ({}) }}>
+            <box flexDirection="column">
+              <box flexDirection="row" gap={1}>
+                <NetaStatus state={state()} />
+                <text>{stateLabel(state())}</text>
+              </box>
+              <For
+                each={[
+                  "blocked",
+                  "failed",
+                  "completed",
+                  "archived",
+                  "queued",
+                  "interrupted",
+                  "idle",
+                  "readyToClose",
+                  "mergedNotClosed",
+                ]}
+              >
+                {(value) => (
+                  <box flexDirection="row" gap={1}>
+                    <NetaStatus state={value} />
+                    <text>{stateLabel(value)}</text>
+                  </box>
+                )}
+              </For>
+            </box>
+          </ThemeProvider>
+        </ConfigProvider>
+      ),
+      { width: 40, height: 12 },
+    )
+    try {
+      app.renderer.start()
+      await app.waitForFrame((frame) => /[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏] RUNNING/.test(frame))
+      const first = app.captureCharFrame()
+      expect(first).toContain("○ NOT RUNNING")
+      expect(first).not.toMatch(/BLOCKED|FAILED|QUEUED|INTERRUPTED/)
+      await app.waitForFrame((frame) => frame !== first)
+      if (process.env.NETA_TEST_CAPTURE === "1")
+        await Bun.write(`/tmp/neta-status-${mode}.json`, JSON.stringify(app.captureSpans()))
+      setState("blocked")
+      await app.waitForFrame((frame) => frame.startsWith("○ NOT RUNNING"))
+      const stopped = app.captureCharFrame()
+      await Bun.sleep(120)
+      await app.renderOnce()
+      expect(app.captureCharFrame()).toBe(stopped)
+      expect(stopped).not.toMatch(/[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏]/)
+      setState("running")
+      await app.waitForFrame((frame) => /[⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏] RUNNING/.test(frame))
+      setState("closed")
+      await app.waitForFrame((frame) => frame.startsWith("○ NOT RUNNING"))
+    } finally {
+      app.renderer.destroy()
+    }
+  })
+}
+
+test("status honors OpenCode's disabled animations setting", async () => {
+  const app = await testRender(
+    () => (
+      <ConfigProvider config={createTuiResolvedConfig({ animations: false })}>
+        <ThemeProvider mode="dark" defaultName="neta" source={{ discover: async () => ({}) }}>
+          <box flexDirection="row" gap={1}>
+            <NetaStatus state="running" />
+            <text>RUNNING</text>
+          </box>
+        </ThemeProvider>
+      </ConfigProvider>
+    ),
+    { width: 30, height: 3 },
+  )
+  try {
+    app.renderer.start()
+    await app.waitForFrame((frame) => frame.includes("⋯ RUNNING"))
+    const frame = app.captureCharFrame()
+    expect(frame).toContain("⋯ RUNNING")
+    await Bun.sleep(120)
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toBe(frame)
+  } finally {
+    app.renderer.destroy()
+  }
+})
