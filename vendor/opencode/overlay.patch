@@ -0,0 +1,218 @@
+import { expect, test } from "bun:test"
+import { parseFallbackModels, withModelFallback } from "../../src/acp/fallback"
+import { ACPError } from "../../src/acp/error"
+import { makeACPFixture, makeSession, testModel, secondModel } from "./service-fixture"
+
+function setup(safe = true) {
+  let current = { providerID: "broken", id: "first" }
+  const notices: string[] = []
+  const attempts: string[] = []
+  return {
+    notices,
+    attempts,
+    input: {
+      current: () => current,
+      models: async () => ({
+        models: [
+          { ...testModel, providerID: "broken" },
+          { ...secondModel, providerID: "healthy" },
+        ],
+        defaultModel: { providerID: "healthy", id: secondModel.id },
+      }),
+      safe: () => safe,
+      switch: async (model: typeof current) => {
+        current = model
+      },
+      notice: async (text: string) => {
+        notices.push(text)
+      },
+      run: async () => {
+        attempts.push(current.providerID)
+        if (current.providerID === "broken") throw new ACPError.AuthRequiredError({ detail: "expired" })
+        return "done"
+      },
+    },
+  }
+}
+test("connection failure skips the whole provider, selects connected default and reports repair", async () => {
+  const f = setup()
+  expect(await withModelFallback(f.input)).toBe("done")
+  expect(f.attempts).toEqual(["broken", "healthy"])
+  expect(f.notices[0]).toContain("/connect")
+  expect(f.notices[0]).toContain("healthy/second-model")
+})
+test("no automatic replay after output or tool execution", async () => {
+  const f = setup(false)
+  await expect(withModelFallback(f.input)).rejects.toBeInstanceOf(ACPError.AuthRequiredError)
+  expect(f.attempts).toEqual(["broken"])
+  expect(f.notices[0]).toContain("already produced output")
+})
+test("permission denial and unknown errors do not trigger fallback", async () => {
+  const f = setup()
+  f.input.run = async () => {
+    throw new ACPError.ServiceFailureError({ safeMessage: "denied", errorName: "permission.rejected" })
+  }
+  await expect(withModelFallback(f.input)).rejects.toBeInstanceOf(ACPError.ServiceFailureError)
+  expect(f.notices).toEqual([])
+})
+test("exhausted and disconnected catalogs stop with repair instructions", async () => {
+  const f = setup()
+  f.input.models = async () => ({ models: [], defaultModel: { providerID: "broken", id: "first" } })
+  await expect(withModelFallback(f.input)).rejects.toBeInstanceOf(ACPError.AuthRequiredError)
+  expect(f.attempts).toEqual(["broken"])
+  expect(f.notices[0]).toContain("No further connected fallback")
+})
+
+test.each([
+  { permitted: undefined, attempts: 2 },
+  { permitted: "[]", attempts: 1 },
+  { permitted: '["healthy/second-model"]', attempts: 2 },
+])(
+  "native adapter filters disconnected models and honors fallback policy $permitted",
+  async ({ permitted, attempts }) => {
+    const previous = process.env.NETA_FALLBACK_MODELS
+    if (permitted === undefined) delete process.env.NETA_FALLBACK_MODELS
+    else process.env.NETA_FALLBACK_MODELS = permitted
+    try {
+      let prompts = 0
+      await using fixture = makeACPFixture({
+        native: true,
+        models: [
+          testModel,
+          { ...secondModel, providerID: "healthy" },
+          { ...testModel, providerID: "disconnected", settings: { apiKey: "public" } },
+        ],
+        fetch(request, context) {
+          const location = { directory: "/workspace", project: { id: "global", directory: "/workspace" } }
+          if (request.path === "/api/integration")
+            return Response.json({
+              location,
+              data: ["test", "healthy"].map((id) => ({
+                id,
+                name: id,
+                methods: [],
+                connections: [{ type: "env", name: "FIXTURE" }],
+              })),
+            })
+          if (request.path === "/api/provider")
+            return Response.json({
+              location,
+              data: ["test", "healthy", "disconnected"].map((id) => ({
+                id,
+                name: id,
+                activation: "auto",
+                package: "",
+              })),
+            })
+          if (request.method === "POST" && request.path === "/api/session")
+            return Response.json({ data: makeSession("ses_fallback") })
+          if (request.method === "GET" && request.path === "/api/session/ses_fallback")
+            return Response.json({ data: makeSession("ses_fallback") })
+          if (request.method === "POST" && request.path.endsWith("/model")) return new Response(null, { status: 204 })
+          if (request.path.endsWith("/synthetic")) return Response.json({ data: {} })
+          if (request.path.endsWith("/prompt")) {
+            prompts++
+            const id = (request.body as { id: string }).id
+            context.send({
+              id: `evt_${id}`,
+              type: "session.inbox.delivered",
+              data: { sessionID: "ses_fallback", inboxID: id },
+            })
+            context.send(
+              prompts === 1
+                ? {
+                    id: "evt_fail",
+                    type: "session.execution.failed",
+                    data: { sessionID: "ses_fallback", error: { type: "provider.auth", message: "expired" } },
+                  }
+                : { id: "evt_done", type: "session.execution.succeeded", data: { sessionID: "ses_fallback" } },
+            )
+            return Response.json({ data: {} })
+          }
+          return undefined
+        },
+      })
+      const initialized = await fixture.service.initialize({ protocolVersion: 1, clientCapabilities: {} })
+      expect(initialized._meta?.["neta.opencode"]).toMatchObject({
+        contract: {
+          version: 1,
+          instructions: "system-per-request",
+          instructionAcknowledgment: "local-request-hook",
+          readiness: "configured-connection-not-authentication-proof",
+        },
+      })
+      const session = await fixture.service.newSession({ cwd: "/workspace", mcpServers: [] })
+      expect(JSON.stringify(session.configOptions)).not.toContain("disconnected")
+      const turn = fixture.service.prompt({
+        sessionId: session.sessionId,
+        prompt: [{ type: "text", text: "inspect" }],
+      })
+      if (attempts === 1) await expect(turn).rejects.toBeInstanceOf(ACPError.AuthRequiredError)
+      else expect((await turn).stopReason).toBe("end_turn")
+      expect(prompts).toBe(attempts)
+      const switched = fixture.requests.find(
+        (request) => request.method === "POST" && request.path.endsWith("/model"),
+      )?.body
+      if (attempts === 1) expect(switched).toBeUndefined()
+      else expect(switched).toMatchObject({ model: { providerID: "healthy", id: secondModel.id } })
+      expect(JSON.stringify(fixture.requests.filter((request) => request.path.endsWith("/synthetic")))).toContain(
+        "/connect",
+      )
+    } finally {
+      if (previous === undefined) delete process.env.NETA_FALLBACK_MODELS
+      else process.env.NETA_FALLBACK_MODELS = previous
+    }
+  },
+)
+
+test("ordered staffing alternatives override the connected default and ignore unlisted models", async () => {
+  const f = setup()
+  f.input.models = async () => ({
+    models: [
+      { ...secondModel, providerID: "flagship" },
+      { ...secondModel, providerID: "second-choice" },
+      { ...secondModel, providerID: "first-choice" },
+    ],
+    defaultModel: { providerID: "flagship", id: secondModel.id },
+  })
+  expect(
+    await withModelFallback({
+      ...f.input,
+      permitted: ["missing/model", "first-choice/second-model", "second-choice/second-model"],
+    }),
+  ).toBe("done")
+  expect(f.attempts).toEqual(["broken", "first-choice"])
+})
+
+test("an empty staffing allowlist never substitutes a connected model", async () => {
+  const f = setup()
+  await expect(withModelFallback({ ...f.input, permitted: [] })).rejects.toBeInstanceOf(ACPError.AuthRequiredError)
+  expect(f.attempts).toEqual(["broken"])
+  expect(f.notices[0]).toContain("No permitted connected fallback")
+})
+
+test("allowlist parsing fails closed and preserves ordered unique IDs", () => {
+  expect(parseFallbackModels(undefined)).toBeUndefined()
+  expect(parseFallbackModels("[]")).toEqual([])
+  expect(parseFallbackModels('["a/model", "b/model", "a/model"]')).toEqual(["a/model", "b/model"])
+  for (const value of ["", "null", "{}", "[1]", '["model"]', '[" a/model"]'])
+    expect(() => parseFallbackModels(value)).toThrow("Invalid NETA_FALLBACK_MODELS")
+})
+
+test("permitted fallback preserves a supported model variant", async () => {
+  const f = setup()
+  f.input.models = async () => ({
+    models: [{ ...secondModel, providerID: "healthy", variants: [{ id: "minimal", name: "Minimal", options: {} }] }],
+    defaultModel: { providerID: "healthy", id: secondModel.id },
+  })
+  let selected: unknown
+  const change = f.input.switch
+  f.input.switch = async (model) => {
+    selected = model
+    await change(model)
+  }
+  expect(
+    await withModelFallback({ ...f.input, permitted: ["healthy/second-model/high", "healthy/second-model/minimal"] }),
+  ).toBe("done")
+  expect(selected).toEqual({ providerID: "healthy", id: "second-model", variant: "minimal" })
+})
