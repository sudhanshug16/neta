+import { toSessionError } from "@opencode/core/session/to-session-error"
+import { createHash } from "node:crypto"
+import { existsSync, mkdtempSync, readFileSync, writeFileSync, rmSync } from "node:fs"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { expect, test } from "bun:test"
+import { SystemPart } from "@opencode/ai"
+import { Agent } from "@opencode/core/agent"
+import { Plugin } from "@opencode/core/plugin"
+import { PluginHooks } from "@opencode/core/plugin/hooks"
+import { PluginHost } from "@opencode/core/plugin/host"
+import { NetaLeaderPlugin, readNetaSystemBundle } from "@opencode/core/plugin/neta-context"
+import { netaToolRules } from "@opencode/core/session/context"
+import { Permission } from "@opencode/core/permission"
+import type { SessionHooks } from "@opencode/plugin/effect/session"
+import { Model } from "@opencode/schema/model"
+import { Provider } from "@opencode/schema/provider"
+import { Session } from "@opencode/schema/session"
+import { NetaContextError, type NetaSystemBundle } from "@opencode/util/neta-contract"
+import { Effect } from "effect"
+import { testEffect } from "../lib/effect"
+import { PluginTestLayer } from "./fixture"
+
+const it = testEffect(PluginTestLayer)
+const names = [
+  "NETA_MANAGED_OPENCODE",
+  "NETA_NATIVE_LEADER",
+  "NETA_SYSTEM_CONTEXT_FILE",
+  "NETA_SYSTEM_CONTEXT_ACTOR_ID",
+  "NETA_SYSTEM_CONTEXT_SESSION_ID",
+  "NETA_SYSTEM_CONTEXT_GENERATION",
+] as const
+
+function fixture() {
+  const previous = Object.fromEntries(names.map((name) => [name, process.env[name]]))
+  const dir = mkdtempSync(join(tmpdir(), "neta-system-test-"))
+  const file = join(dir, "context.json")
+  const identity = { actorId: "actor", sessionId: "neta-session", generation: "3" }
+  process.env.NETA_MANAGED_OPENCODE = "1"
+  process.env.NETA_SYSTEM_CONTEXT_FILE = file
+  process.env.NETA_SYSTEM_CONTEXT_ACTOR_ID = identity.actorId
+  process.env.NETA_SYSTEM_CONTEXT_SESSION_ID = identity.sessionId
+  process.env.NETA_SYSTEM_CONTEXT_GENERATION = identity.generation
+  return {
+    file,
+    identity,
+    write(text: string, extra: Partial<NetaSystemBundle> = {}) {
+      const bundle: NetaSystemBundle = {
+        version: 1,
+        actorId: identity.actorId,
+        sessionId: identity.sessionId,
+        generation: "3",
+        role: "leader",
+        revision: text,
+        text,
+        hash: createHash("sha256").update(text).digest("hex"),
+        ...extra,
+      }
+      writeFileSync(file, JSON.stringify(bundle))
+      return bundle
+    },
+    [Symbol.dispose]() {
+      for (const name of names) {
+        if (previous[name] === undefined) delete process.env[name]
+        else process.env[name] = previous[name]
+      }
+      rmSync(dir, { recursive: true, force: true })
+    },
+  }
+}
+
+function context(): SessionHooks["context"] {
+  return {
+    sessionID: Session.ID.make("ses_provider"),
+    agent: Agent.ID.make("build"),
+    model: Model.Ref.make({ providerID: Provider.ID.make("test"), id: Model.ID.make("fake") }),
+    system: [SystemPart.make("Provider system")],
+    messages: [],
+    options: {},
+    tools: {
+      execute: { description: "execute", input: { type: "object" } },
+      question: { description: "question", input: { type: "object" } },
+      shell: { description: "shell", input: { type: "object" } },
+      edit: { description: "edit", input: { type: "object" } },
+      neta_send_message: { description: "send_message", input: { type: "object" } },
+    },
+  }
+}
+
+it.effect("all Neta roles refresh one system bundle at every request hook and acknowledge only local application", () =>
+  Effect.gen(function* () {
+    using f = fixture()
+    const hooks = yield* PluginHooks.Service
+    const plugins = yield* Plugin.Service
+    const host = yield* PluginHost.make(plugins)
+    yield* NetaLeaderPlugin.effect(host)
+    for (const role of ["leader", "lead", "agent", "orchestrator", "curator"] as const) {
+      for (const hook of ["context", "compaction", "generate"] as const) {
+        const event = context()
+        for (const text of ["Charter A", "Charter B"]) {
+          const bundle = f.write(text, { role })
+          yield* hooks.trigger("session", hook, event)
+          const parts = event.system.filter((part) => part.text.startsWith("Neta standing instructions\n"))
+          expect(parts).toHaveLength(1)
+          expect(parts[0]?.text).toBe("Neta standing instructions\n" + text)
+          expect(event.messages).toEqual([])
+          expect(event.tools.question).toBeUndefined()
+          if (role === "orchestrator") {
+            expect(Object.keys(event.tools)).toEqual(["execute"])
+          } else if (role === "curator") {
+            expect(Object.keys(event.tools)).toEqual(["neta_send_message"])
+          } else {
+            expect(event.tools.shell).toBeDefined()
+            expect(event.tools.edit).toBeDefined()
+          }
+          const marker =
+            role === "agent"
+              ? "Worker reminder:"
+              : role === "orchestrator"
+                ? "Workspace leader reminder:"
+                : role === "curator"
+                  ? "Filter reminder:"
+                  : role === "lead" ? "Mission lead reminder:" : "Coordinator reminder:"
+          expect(event.system[0]?.text.split(marker)).toHaveLength(2)
+          expect(event.system[0]?.text).not.toContain("omitting model inherits")
+          if (role === "leader" || role === "lead") {
+            expect(event.system[0]?.text).toContain("omit model so Neta routes through user preferences")
+            expect(event.system[0]?.text).toContain("An open PR remains an open mission")
+          }
+          if (role === "orchestrator" || role === "curator") {
+            expect(event.system[0]?.text).not.toContain("delegate bounded parts to workers")
+            expect(event.system[0]?.text).not.toContain("Neta leader reminder:")
+          }
+          expect(JSON.parse(readFileSync(`${f.file}.applied.json`, "utf8"))).toEqual({
+            version: 1,
+            actorId: bundle.actorId,
+            sessionId: bundle.sessionId,
+            generation: "3",
+            revision: bundle.revision,
+            hash: bundle.hash,
+            hook,
+          })
+        }
+      }
+    }
+  }),
+)
+
+test("missing, malformed, altered and stale instruction bundles fail closed", () => {
+  using f = fixture()
+  expect(() => readNetaSystemBundle(f.file, f.identity)).toThrow("missing or malformed")
+  writeFileSync(f.file, "Old plaintext instructions")
+  expect(() => readNetaSystemBundle(f.file, f.identity)).toThrow("missing or malformed")
+  f.write("Current", { version: 2 as 1 })
+  expect(() => readNetaSystemBundle(f.file, f.identity)).toThrow("Invalid Neta")
+  for (const extra of [{ actorId: "old" }, { sessionId: "old" }, { generation: "2" }]) {
+    f.write("Current", extra)
+    expect(() => readNetaSystemBundle(f.file, f.identity)).toThrow("different runtime binding")
+  }
+  f.write("Current", { hash: "0".repeat(64) })
+  expect(() => readNetaSystemBundle(f.file, f.identity)).toThrow("checksum mismatch")
+  const bundle = f.write("Current")
+  expect(readNetaSystemBundle(f.file, f.identity)).toEqual(bundle)
+})
+
+test("Neta tool inventory contains only execute and its scoped Neta tools", () => {
+  using f = fixture()
+  f.write("Workspace instructions", { role: "orchestrator" })
+  const rules = netaToolRules()
+  expect(Permission.evaluate("execute", "*", rules).effect).toBe("allow")
+  expect(Permission.evaluate("neta_missions", "*", rules).effect).toBe("allow")
+  expect(Permission.evaluate("neta_send_message", "*", rules).effect).toBe("allow")
+  expect(Permission.evaluate("neta_mission", "*", rules).effect).toBe("allow")
+  expect(Permission.evaluate("neta_artifacts", "*", rules).effect).toBe("allow")
+  expect(Permission.evaluate("shell", "*", rules).effect).toBe("deny")
+  expect(Permission.evaluate("neta_dispatch_mission", "*", rules).effect).toBe("deny")
+  for (const role of ["leader", "lead", "agent", "orchestrator", "curator"] as const) {
+    f.write("Workspace instructions", { role })
+    expect(Permission.evaluate("question", "*", netaToolRules()).effect).toBe("deny")
+  }
+})
+
+it.effect("a replacement binding rejects stale context without publishing a new acknowledgment", () =>
+  Effect.gen(function* () {
+    using f = fixture()
+    const hooks = yield* PluginHooks.Service
+    const plugins = yield* Plugin.Service
+    const host = yield* PluginHost.make(plugins)
+    yield* NetaLeaderPlugin.effect(host)
+    f.write("Current")
+    yield* hooks.trigger("session", "context", context())
+    const acknowledgment = readFileSync(`${f.file}.applied.json`, "utf8")
+    process.env.NETA_SYSTEM_CONTEXT_GENERATION = "4"
+    const result = yield* Effect.exit(hooks.trigger("session", "context", context()))
+    expect(result._tag).toBe("Failure")
+    expect(readFileSync(`${f.file}.applied.json`, "utf8")).toBe(acknowledgment)
+    f.write("Fresh reset", { generation: "4" })
+    const fresh = context()
+    yield* hooks.trigger("session", "context", fresh)
+    expect(
+      fresh.system.filter((part) => part.text.startsWith("Neta standing instructions")).map((part) => part.text),
+    ).toEqual(["Neta standing instructions\nFresh reset"])
+    expect(fresh.messages).toEqual([])
+  }),
+)
+
+test("instruction validation errors stay classified and do not expose bundle content", () => {
+  const message = "Neta instruction context belongs to a different runtime binding. Reopen the conversation."
+  expect(toSessionError(new NetaContextError(message))).toEqual({ type: "neta.instructions", message })
+})
