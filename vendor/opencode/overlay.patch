@@ -0,0 +1,22 @@
+import { expect, test } from "bun:test"
+import { RGBA } from "@opentui/core"
+import { allThemes, parseTheme, resolveThemeDocument } from "../src/theme"
+
+test("Neta resolves the Paper palette in chat, controls and dialogs without color inference", () => {
+  for (const mode of ["dark", "light"] as const) {
+    const theme = resolveThemeDocument(parseTheme(allThemes().neta, "neta"), mode)
+    expect(theme.background.default.equals(RGBA.fromHex("#171717"))).toBeTrue()
+    expect(theme.background.surface.offset.equals(RGBA.fromHex("#111315"))).toBeTrue()
+    expect(theme.text.default.equals(RGBA.fromHex("#E5E7EB"))).toBeTrue()
+    expect(theme.text.subdued.equals(RGBA.fromHex("#A5ADB3"))).toBeTrue()
+    expect(theme.text.action.primary.default.equals(RGBA.fromHex("#E8B86D"))).toBeTrue()
+    expect(theme.background.formfield.selected.equals(RGBA.fromHex("#322A1E"))).toBeTrue()
+    expect(theme.border.default.equals(RGBA.fromHex("#363B40"))).toBeTrue()
+    const dialog = theme.contextual.elevated
+    expect(dialog.background.default.equals(RGBA.fromHex("#1B1E21"))).toBeTrue()
+    expect(dialog.background.action.primary.focused.equals(RGBA.fromHex("#322A1E"))).toBeTrue()
+    expect(dialog.text.action.primary.focused.equals(RGBA.fromHex("#E8B86D"))).toBeTrue()
+    expect(dialog.background.surface.offset.equals(RGBA.fromHex("#303030"))).toBeTrue()
+    expect(dialog.background.surface.overlay.equals(RGBA.fromHex("#252525"))).toBeTrue()
+  }
+})
