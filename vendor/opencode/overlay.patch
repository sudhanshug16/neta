--- /dev/null
+++ b/packages/tui/src/neta/notifications.ts
@@ -0,0 +1,59 @@
+import type { Snapshot } from "@neta/client"
+import type { Attention } from "@opencode/plugin/tui/context"
+
+// Node turn events cover every leader, including conversations not currently displayed.
+export function createNetaNotifications(
+  attention: Pick<Attention, "notify">,
+  snapshot: () => Snapshot,
+  workspaceId: string,
+) {
+  const seen = new Set<string>()
+  return (method: string, raw: unknown) => {
+    if (!raw || typeof raw !== "object") return
+    const value = raw as Record<string, unknown>
+    const state = snapshot()
+    let key: string
+    let title: string
+    let message: string
+    let sound: "done" | "error" | "question" = "done"
+    if (method === "conversation.ended") {
+      if (!value.turn || typeof value.turn !== "object" || typeof value.sessionId !== "string") return
+      const turn = value.turn as Record<string, unknown>
+      if (typeof turn.id !== "string" || !turn.endedAt) return
+      const actor =
+        state.leaders.find((actor) => actor.workspaceId === workspaceId && actor.sessionId === value.sessionId) ??
+        state.agents.find(
+          (actor) =>
+            actor.workspaceId === workspaceId &&
+            actor.sessionId === value.sessionId &&
+            actor.canSpawn &&
+            actor.state !== "archived",
+        )
+      if (!actor) return
+      if ("missionId" in actor && state.missions.find((mission) => mission.id === actor.missionId)?.state === "closed")
+        return
+      key = `turn:${value.sessionId}:${turn.id}`
+      title = `Neta · ${actor.name}`
+      message = turn.failed
+        ? "Response failed. Open Neta for details."
+        : turn.cancelled
+          ? "Response interrupted."
+          : "Response ready."
+      sound = turn.failed ? "error" : "done"
+    } else if (method === "event") {
+      if (!value.event || typeof value.event !== "object") return
+      const event = value.event as Record<string, unknown>
+      if (event.workspaceId !== workspaceId || event.kind !== "mission.blocked" || typeof event.seq !== "number") return
+      key = `question:${event.seq}`
+      title = "Neta · Decision needed"
+      message = "A mission needs your response."
+      sound = "question"
+    } else return
+    if (seen.has(key)) return
+    seen.add(key)
+    if (seen.size > 512) seen.delete(seen.values().next().value!)
+    void attention
+      .notify({ title, message, notification: { when: "always" }, sound: { name: sound, when: "always" } })
+      .catch(() => undefined)
+  }
+}
diff --git a/packages/tui/src/neta/presentation.ts b/packages/tui/src/neta/presentation.ts
new file mode 100644
index 0000000..d4c91af
--- /dev/null
+++ b/packages/tui/src/neta/presentation.ts
@@ -0,0 +1,86 @@
+import type { Agent, Leader, Mission, Snapshot } from "@neta/client"
+import { deliveryNeedsAttention } from "./recovery"
+
+export function archiveTimestamp(value: string | undefined, includeTime = false) {
+  if (!value) return ""
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return ""
+  const day = `${String(date.getDate()).padStart(2, "0")} ${date.toLocaleDateString("en-US", { month: "short" })}`
+  return includeTime
+    ? `${day}, ${date.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false })}`
+    : day
+}
+
+/** Reserve a readable chat pane; terminal cells replace the Paper pixel grid. */
+export function spineWidth(columns: number) {
+  return columns < 95 ? 0 : Math.min(42, Math.max(30, Math.floor(columns * 0.24)))
+}
+
+export function workspaceActivity(snapshot: Snapshot, workspaceId: string) {
+  const agents = snapshot.agents.filter((actor) => actor.workspaceId === workspaceId && actor.state !== "archived")
+  const leaders = snapshot.leaders.filter((actor) => actor.workspaceId === workspaceId)
+  const attention = new Set(
+    snapshot.missions
+      .filter(
+        (mission) =>
+          mission.workspaceId === workspaceId && ["failed", "blocked", "readyToClose"].includes(mission.state),
+      )
+      .map((mission) => mission.id),
+  )
+  for (const agent of agents) {
+    if (["blocked", "failed"].includes(agent.state) || deliveryNeedsAttention(agent)) attention.add(agent.missionId)
+  }
+  return {
+    running: [...agents, ...leaders].filter((actor) => ["running", "starting"].includes(actor.state)).length,
+    attention: attention.size + leaders.filter((actor) => ["blocked", "failed"].includes(actor.state)).length,
+  }
+}
+
+export function stateLabel(state: string) {
+  return state === "readyToClose"
+    ? "READY TO CLOSE"
+    : state === "mergedNotClosed"
+      ? "MERGED · CLOSEOUT"
+      : state === "closed"
+        ? "ARCHIVED"
+        : state.toUpperCase()
+}
+
+/** The durable "running" mission state also includes idle and queued work. */
+export function missionDisplayState(mission: Mission, agents: Agent[], leader?: Leader) {
+  const lead = mission.lead
+  const activeLead = lead?.kind === "agent" && agents.find((actor) => actor.id === lead.agentId && actor.missionId === mission.id)
+  if (mission.state === "blocked" && activeLead && ["running", "starting"].includes(activeLead.state)) return activeLead.state
+  if (mission.state !== "running") return mission.state
+  const states = agents.filter((actor) => actor.missionId === mission.id).map((actor) => actor.state)
+  if (mission.lead?.kind === "leader" && leader) states.push(leader.state)
+  return (
+    ["running", "starting", "blocked", "failed", "interrupted", "queued"].find((state) => states.includes(state)) ??
+    "idle"
+  )
+}
+
+export function modelDecisionText(actor: Agent | Leader) {
+  const routing = "routing" in actor ? actor.routing : undefined
+  const requested = "requestedModel" in actor ? actor.requestedModel : undefined
+  return [
+    `Actual model: ${actor.model}`,
+    requested ? `Requested model: ${requested}` : undefined,
+    routing ? `Selected model: ${routing.selectedModel}` : undefined,
+    routing ? `Routing: ${routing.method}${routing.effort ? ` · task effort ${routing.effort}/5` : ""}` : undefined,
+    routing?.reason ?? "No automatic routing decision was recorded for this conversation.",
+    ...(routing?.warnings ?? []).map((warning) => `Warning: ${warning}`),
+  ]
+    .filter(Boolean)
+    .join("\n\n")
+}
+
+/** Live work first, then attention and unfinished work, then finished history. */
+export function spineStatusRank(state: string) {
+  const order = [
+    "running", "starting", "blocked", "failed", "queued", "interrupted", "idle",
+    "readyToClose", "mergedNotClosed", "completed", "closed", "archived",
+  ]
+  const rank = order.indexOf(state)
+  return rank < 0 ? order.length : rank
+}
