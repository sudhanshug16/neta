+import { expect, test } from "bun:test"
+import { testRender } from "@opentui/solid"
+import type { Agent } from "@neta/client"
+import { NetaArchive } from "../src/neta/archive"
+import { ConfigProvider } from "../src/config"
+import { ThemeProvider } from "../src/context/theme"
+import { createTuiResolvedConfig } from "./fixture/tui-runtime"
+
+test("archive renders stored output without attaching, resuming or prompting a provider", async () => {
+  const calls: string[] = []
+  const actor: Agent = {
+    id: "a",
+    sessionId: "saved",
+    missionId: "m",
+    workspaceId: "w",
+    name: "Hazel",
+    provider: "opencode",
+    model: "fixture",
+    state: "archived",
+    task: "inspect",
+  }
+  const client = {
+    async request<T>(method: string): Promise<T> {
+      calls.push(method)
+      if (method === "conversation.untail") return {} as T
+      if (method !== "conversation.tail") throw new Error(`Forbidden archive operation: ${method}`)
+      return {
+        blocks: [{ seq: 1, role: "agent", kind: "text", text: "Saved verification result" }],
+        prevCursor: null,
+      } as T
+    },
+  }
+  const app = await testRender(
+    () => (
+      <ConfigProvider config={createTuiResolvedConfig()}>
+        <ThemeProvider mode="dark" source={{ discover: async () => ({}) }}>
+          <NetaArchive actor={actor} client={client} onBack={() => {}} />
+        </ThemeProvider>
+      </ConfigProvider>
+    ),
+    { width: 100, height: 24 },
+  )
+  try {
+    await Bun.sleep(50)
+    await app.renderOnce()
+    const screen = app.captureCharFrame()
+    expect(screen).toContain("Saved verification result")
+    expect(screen).toContain("input disabled")
+    expect(screen).toContain("Back to workspace leader")
+    expect(calls).toEqual(["conversation.tail"])
+  } finally {
+    app.renderer.destroy()
+  }
+  expect(calls).toEqual(["conversation.tail", "conversation.untail"])
+})
