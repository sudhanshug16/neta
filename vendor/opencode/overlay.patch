+      expect(app.captureCharFrame()).toContain("1/8 enabled")
+      app.mockInput.pressKey("F4")
+      await app.waitForFrame((frame) => frame.includes("Preferred"))
+      expect(saves.at(-1)?.models).toEqual({ "openai/luna": "prefer" })
