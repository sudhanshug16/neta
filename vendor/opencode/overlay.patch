@@ -0,0 +1,66 @@
+import { expect, test } from "bun:test"
+import { createServer } from "node:net"
+import { mkdtemp, writeFile, rm } from "node:fs/promises"
+import { tmpdir } from "node:os"
+import { join } from "node:path"
+import { NetaClient } from "../src/index"
+import { ensureLocalRuntime } from "../src/startup"
+
+test("a stopped Node with a stale descriptor starts and completes the real socket handshake", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "neta-startup-"))
+  const socketPath = join(directory, "node.sock")
+  let started = 0
+  const received: string[] = []
+  const server = createServer((socket) => {
+    let buffer = ""
+    socket.on("data", (chunk) => {
+      buffer += chunk.toString()
+      while (buffer.includes("\n")) {
+        const end = buffer.indexOf("\n")
+        const request = JSON.parse(buffer.slice(0, end))
+        buffer = buffer.slice(end + 1)
+        received.push(request.method)
+        const result = request.method === "hello" ? {} : { nativeOpenCodeVersions: [1, 2], nativeOpenCodeRevision: 9 }
+        socket.write(JSON.stringify({ jsonrpc: "2.0", id: request.id, result }) + "\n")
+      }
+    })
+  })
+  let client: NetaClient | undefined
+  try {
+    await writeFile(join(directory, "node.json"), JSON.stringify({ socket: socketPath, token: "fixture" }))
+    await expect(NetaClient.connect(directory)).rejects.toMatchObject({ code: "ENOENT" })
+    client = await ensureLocalRuntime({
+      connect: () => NetaClient.connect(directory),
+      start: async () => {
+        started++
+        await new Promise<void>((resolve, reject) => {
+          server.once("error", reject)
+          server.listen(socketPath, resolve)
+        })
+      },
+      replace: async () => {
+        throw new Error("A stopped Node must not be replaced")
+      },
+      notice: () => {},
+    })
+    expect(started).toBe(1)
+    expect(received).toEqual(["hello", "runtime.capabilities"])
+  } finally {
+    client?.close()
+    if (server.listening) await new Promise<void>((resolve) => server.close(() => resolve()))
+    await rm(directory, { recursive: true, force: true })
+  }
+})
+
+
+test("malformed descriptor is classified before connecting", async () => {
+  const directory = await mkdtemp(join(tmpdir(), "neta-invalid-"))
+  try {
+    for (const content of ["{broken", "null", "{}"])
+    {
+      await writeFile(join(directory, "node.json"), content)
+      try { await NetaClient.connect(directory); throw new Error("unexpected success") }
+      catch (error) { expect(error).toMatchObject({ code: "NETA_DESCRIPTOR_INVALID" }) }
+    }
+  } finally { await rm(directory, { recursive: true, force: true }) }
+})
diff --git a/packages/neta-client/test/startup.test.ts b/packages/neta-client/test/startup.test.ts
new file mode 100644
index 0000000..cd2206f
--- /dev/null
+++ b/packages/neta-client/test/startup.test.ts
@@ -0,0 +1,222 @@
+import { expect, test } from "bun:test"
+import { ensureLocalRuntime, openStartupConversation } from "../src/startup"
+import { NetaError } from "../src/index"
+
+function fixture(
+  input: {
+    old?: boolean
+    revision?: number
+    absent?: boolean
+    active?: "leader" | "agent" | "queued" | "mission"
+    error?: boolean
+    expectedBuild?: string
+    live?: string[]
+    legacy?: boolean
+    refused?: string
+    commit?: boolean
+    invalidReplacement?: boolean
+  } = {},
+) {
+  const calls: string[] = []
+  let old = input.old ?? false
+  let absent = input.absent ?? false
+  const client = {
+    async request<T>(method: string): Promise<T> {
+      calls.push(method)
+      if (input.error) throw new Error("broken connection")
+      if (method === "runtime.capabilities") {
+        if (input.legacy && input.revision === undefined) throw new NetaError("unknown method", -32601)
+        return { nativeOpenCodeVersions: [1, 2], nativeOpenCodeRevision: old ? (input.revision ?? 8) : 9, runtimeBuild: old ? "previous" : "current", activeSessionIds: input.live, instanceId: old ? "old-instance" : "current-instance", runtimeUpgrade: input.legacy ? undefined : 1 } as T
+      }
+      if (method === "runtime.upgrade.prepare") return { prepared: !input.refused, reason: input.refused, token: "reservation" } as T
+      if (method === "runtime.upgrade.commit") return { stopping: input.commit ?? true } as T
+      return {
+        leaders: input.active === "leader" ? [{ state: "running" }] : [],
+        agents: input.active === "agent" ? [{ state: "running" }] : input.active === "queued" ? [{ state: "queued" }] : [],
+        missions: input.active === "mission" ? [{ state: "running" }] : [],
+      } as T
+    },
+    close() {
+      calls.push("close")
+    },
+  }
+  return {
+    calls,
+    run: () =>
+      ensureLocalRuntime({
+        expectedBuild: input.expectedBuild,
+        connect: async () => {
+          calls.push("connect")
+          if (absent) throw Object.assign(new Error("missing"), { code: "ENOENT" })
+          return client
+        },
+        start: async () => {
+          calls.push("start")
+          absent = false
+        },
+        validateReplacement: async () => { if (input.invalidReplacement) throw new Error("bad executable") },
+        replace: async () => {
+          calls.push("replace")
+          old = false
+        },
+        notice: () => {
+          calls.push("notice")
+        },
+      }),
+  }
+}
+
+test("compatible Node is reused without restarting or opening a workspace", async () => {
+  const item = fixture()
+  await item.run()
+  expect(item.calls).toEqual(["connect", "runtime.capabilities"])
+})
+test("missing Node starts automatically", async () => {
+  const item = fixture({ absent: true })
+  await item.run()
+  expect(item.calls).toContain("start")
+  expect(item.calls).not.toContain("replace")
+})
+test("outdated idle Node is replaced before continuing", async () => {
+  const item = fixture({ old: true })
+  await item.run()
+  expect(item.calls).toEqual([
+    "connect",
+    "runtime.capabilities",
+    "snapshot",
+    "runtime.upgrade.prepare",
+    "runtime.upgrade.commit",
+    "notice",
+    "replace",
+    "close",
+    "connect",
+    "runtime.capabilities",
+  ])
+})
+for (const active of ["leader", "agent"] as const)
+  test(`outdated Node preserves active ${active}`, async () => {
+    const item = fixture({ old: true, active, legacy: true })
+    await expect(item.run()).rejects.toThrow("has not been stopped")
+    expect(item.calls).not.toContain("replace")
+  })
+test("unexpected connection errors never trigger a restart", async () => {
+  const item = fixture({ error: true })
+  await expect(item.run()).rejects.toThrow("broken connection")
+  expect(item.calls).not.toContain("replace")
+})
+
+for (const active of ["leader", "agent"] as const) {
+  test(`an older compatible revision opens during active ${active} work`, async () => {
+    const item = fixture({ old: true, revision: 2, active })
+    await item.run()
+    expect(item.calls).toContain("notice")
+    expect(item.calls).not.toContain("replace")
+    expect(item.calls).not.toContain("close")
+  })
+}
+test("a running mission without live actors does not block an idle update", async () => {
+  const item = fixture({ old: true, revision: 2, active: "mission" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+
+test("durably queued workers do not block an idle runtime update", async () => {
+  const item = fixture({ old: true, revision: 3, active: "queued" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+
+
+test("same revision with a changed build replaces an idle service", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+test("live turns defer a build update even when persisted actor labels are idle", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current", live: ["session"] })
+  await item.run()
+  expect(item.calls).not.toContain("replace")
+  expect(item.calls).toContain("notice")
+})
+test("stale running labels do not block an update when no turns are live", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "current", active: "agent", live: [] })
+  await item.run()
+  expect(item.calls).toContain("replace")
+})
+test("matching build reuses the service", async () => {
+  const item = fixture({ expectedBuild: "current" })
+  await item.run()
+  expect(item.calls).toEqual(["connect", "runtime.capabilities"])
+})
+test("a replacement with the wrong build cannot be reported as updated", async () => {
+  const item = fixture({ old: true, revision: 9, expectedBuild: "missing" })
+  await expect(item.run()).rejects.toThrow("outdated")
+  expect(item.calls).toContain("replace")
+})
+
+
+test("a saved unavailable worker opens the leader without restarting work", async () => {
+  const calls: unknown[] = []
+  const attachment = { integrationVersion: 2, url: "http://fixture", authorization: "", sessionId: "vendor", netaSessionId: "leader", directory: "/project" }
+  const client = {
+    async request<T>(method: string, params?: unknown): Promise<T> {
+      calls.push([method, params])
+      if (calls.length === 1) throw new NetaError("Worktree missing; history retained", -32002)
+      return attachment as T
+    },
+    close() {},
+  }
+  const result = await openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: true })
+  expect(result).toMatchObject({ attachment, recovered: true })
+  expect(result.notice).toContain("Worktree missing")
+  expect(calls).toEqual([["conversation.native", { sessionId: "worker" }], ["conversation.native", { sessionId: "leader" }]])
+})
+for (const code of [-32002, -32004, -32005]) {
+  test(`explicit tab navigation preserves error ${code}`, async () => {
+    const client = { async request<T>(): Promise<T> { throw new NetaError("unavailable", code) }, close() {} }
+    await expect(openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: false })).rejects.toThrow("unavailable")
+  })
+}
+test("a queued saved tab opens the leader without attaching the queued worker", async () => {
+  const calls: unknown[] = []
+  const client = { async request<T>(method: string, params?: unknown): Promise<T> { calls.push(params); return {} as T }, close() {} }
+  const result = await openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "queued" }, leader: { sessionId: "leader" }, recover: true })
+  expect(result.recovered).toBe(true)
+  expect(calls).toEqual([{ sessionId: "leader" }])
+})
+test("connection failures are not masked by tab recovery", async () => {
+  const client = { async request<T>(): Promise<T> { throw new Error("disconnected") }, close() {} }
+  await expect(openStartupConversation({ client, selected: { name: "Worker", sessionId: "worker", state: "interrupted" }, leader: { sessionId: "leader" }, recover: true })).rejects.toThrow("disconnected")
+})
+
+
+test("work admitted after idle snapshot prevents replacement", async () => {
+  const item = fixture({ old: true, expectedBuild: "current", refused: "active-work" })
+  await item.run()
+  expect(item.calls).toContain("runtime.upgrade.prepare")
+  expect(item.calls).not.toContain("replace")
+  expect(item.calls).not.toContain("runtime.upgrade.commit")
+})
+test("competing updater joins replacement without committing another stop", async () => {
+  const item = fixture({ old: true, expectedBuild: "current", refused: "update-in-progress" })
+  await item.run()
+  expect(item.calls).toContain("replace")
+  expect(item.calls).not.toContain("runtime.upgrade.commit")
+})
+test("expired reservation does not replace service", async () => {
+  const item = fixture({ old: true, expectedBuild: "current", commit: false })
+  await item.run()
+  expect(item.calls).not.toContain("replace")
+})
+test("replacement validation fails before requesting drain", async () => {
+  const item = fixture({ old: true, expectedBuild: "current", invalidReplacement: true })
+  await expect(item.run()).rejects.toThrow("bad executable")
+  expect(item.calls).not.toContain("runtime.upgrade.prepare")
