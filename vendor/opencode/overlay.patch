+
+test.each([100, 160])(
+  "native Neta Updates, bulk read, composer reply and persistence at %s columns",
+  async (width) => {
+    await using state = await tmpdir()
+    const socket = new Socket()
+    const client = new NetaClient(socket)
+    const info = session("ses_updates", { providerID: "provider", id: "fixture" })
+    const snapshot: Snapshot = {
+      machine: { id: "mac", name: "mac-mini" },
+      workspaces: [{ id: "w", name: "noscrubs", roots: [] }],
+      leaders: [
+        {
