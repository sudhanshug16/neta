+      })
+      return <text>Workspace</text>
+    }
+    const app = await testRender(
+      () => (
+        <TestTuiContexts>
+          <ConfigProvider config={createTuiResolvedConfig()}>
+            <Keymap.Provider>
+              <ThemeProvider mode="dark" source={{ discover: async () => ({}) }}>
+                <ToastProvider>
+                  <DialogProvider>
+                    <Open />
+                  </DialogProvider>
+                </ToastProvider>
+              </ThemeProvider>
+            </Keymap.Provider>
+          </ConfigProvider>
+        </TestTuiContexts>
+      ),
+      { width, height, kittyKeyboard: true },
+    )
+    try {
+      app.renderer.start()
+      await app.waitForFrame((frame) => frame.includes("Session routing log"))
+      const screen = app.captureCharFrame()
+      expect(screen).toContain("Session routing log")
+      expect(screen).toContain("Cove · #22 · archived")
+      app.mockInput.pressTab()
+      app.mockInput.pressKey("END")
+      await app.waitForFrame((frame) => frame.includes("Raised effort for review."))
+      app.mockInput.pressTab()
+      expect(screen).toContain("Jev API key · Remote fixture")
+      expect(screen).toContain("TYPESAFE_API_KEY")
+      await app.mockInput.pasteBracketedText("fixture-pasted-key")
+      await app.waitForFrame((frame) => frame.includes("******************"))
+      expect(app.captureCharFrame()).not.toContain("fixture-pasted-key")
+      expect(app.captureCharFrame()).toContain("enter save")
+      if (process.env.NETA_TEST_CAPTURE === "1")
+        await Bun.write(`/tmp/neta-routing-key-${width}x${height}.json`, JSON.stringify(app.captureSpans()))
+      app.mockInput.pressKey("u", { ctrl: true })
+      await app.mockInput.typeText("fixture-typed-key")
+      app.mockInput.pressBackspace()
+      await app.mockInput.typeText("Y")
+      await app.waitForFrame((frame) => frame.includes("*****************"))
+      expect(app.captureCharFrame()).not.toContain("fixture-typed")
+      app.mockInput.pressEnter()
+      await app.waitForFrame((frame) => frame.includes("Key saved."))
+      expect(saved).toEqual(["fixture-typed-keY"])
+      expect(app.captureCharFrame()).toContain("saved privately on this machine")
