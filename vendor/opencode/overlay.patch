@@ -0,0 +1,18 @@
+import { Show } from "solid-js"
+import { Spinner } from "../component/spinner"
+import { useTheme } from "../context/theme"
+
+/** One terminal cell for observed runtime activity. */
+export function NetaStatus(props: { state: string }) {
+  const theme = useTheme()
+  return (
+    <box width={1} height={1} flexShrink={0}>
+      <Show
+        when={props.state === "running"}
+        fallback={<text fg={theme.text.muted}>○</text>}
+      >
+        <Spinner color={theme.text.feedback.info.base} />
+      </Show>
+    </box>
+  )
+}
