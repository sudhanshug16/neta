+      const row = lines.findIndex((line) => line.includes(text))
+      expect(row).toBeGreaterThanOrEqual(0)
+      await app.mockMouse.click(lines[row]!.indexOf(text) + 1, row)
+    }
+    try {
+      app.renderer.start()
+      await app.waitForFrame((frame) => frame.includes("Session routing log"))
+      app.mockInput.pressKey("F2")
+      await app.waitForFrame((frame) => frame.includes("[ ] Muse Spark Contributor"))
+      expect(app.captureCharFrame()).toContain("6/8 enabled")
+      expect(app.captureCharFrame()).toContain("Select all")
+      expect(app.captureCharFrame()).toContain("Deselect all")
+      expect(app.captureCharFrame()).toContain("Preferred")
+      if (process.env.NETA_TEST_CAPTURE === "1")
+        await Bun.write(`/tmp/neta-model-checkboxes-${width}x${height}.json`, JSON.stringify(app.captureSpans()))
