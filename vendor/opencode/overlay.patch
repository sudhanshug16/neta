@@ -0,0 +1,72 @@
+import type { Agent, Leader, Mission, Snapshot } from "@neta/client"
+
+export function archiveTimestamp(value: string | undefined, includeTime = false) {
+  if (!value) return ""
+  const date = new Date(value)
+  if (Number.isNaN(date.getTime())) return ""
+  const day = `${String(date.getDate()).padStart(2, "0")} ${date.toLocaleDateString("en-US", { month: "short" })}`
+  return includeTime
+    ? `${day}, ${date.toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit", hour12: false })}`
+    : day
+}
+
+/** Reserve a readable chat pane; terminal cells replace the Paper pixel grid. */
+export function spineWidth(columns: number) {
+  return columns < 95 ? 0 : Math.min(42, Math.max(30, Math.floor(columns * 0.24)))
+}
+
+export function workspaceActivity(snapshot: Snapshot, workspaceId: string) {
+  const agents = snapshot.agents.filter((actor) => actor.workspaceId === workspaceId && actor.state !== "archived")
+  const leaders = snapshot.leaders.filter((actor) => actor.workspaceId === workspaceId)
+  const attention = new Set(
+    snapshot.missions
+      .filter(
+        (mission) =>
+          mission.workspaceId === workspaceId && Boolean(mission.attention),
+      )
+      .map((mission) => mission.id),
+  )
+  for (const agent of agents) {
+    if (agent.state === "failed") attention.add(agent.missionId)
+  }
+  return {
+    running: [...agents, ...leaders].filter((actor) => actor.state === "running").length,
+    attention: attention.size + leaders.filter((actor) => ["failed"].includes(actor.state)).length,
+  }
+}
+
+export function stateLabel(state: string) {
+  return state === "running" ? "RUNNING" : "NOT RUNNING"
+}
+
+/** Show actual actor activity; the durable mission state tracks unfinished work separately. */
+export function missionDisplayState(mission: Mission, agents: Agent[]) {
+  if (mission.state === "closed") return "idle"
+  if (agents.some((actor) => actor.missionId === mission.id && actor.state === "running")) return "running"
+  return "idle"
+}
+
+export function modelDecisionText(actor: Agent | Leader) {
+  const routing = "routing" in actor ? actor.routing : undefined
+  const requested = "requestedModel" in actor ? actor.requestedModel : undefined
+  return [
+    `Actual model: ${actor.model}`,
+    requested ? `Requested model: ${requested}` : undefined,
+    routing ? `Selected model: ${routing.selectedModel}` : undefined,
+    routing ? `Routing: ${routing.method}${routing.effort ? ` · task effort ${routing.effort}/5` : ""}` : undefined,
+    routing?.reason ?? "No automatic routing decision was recorded for this conversation.",
+    ...(routing?.warnings ?? []).map((warning) => `Warning: ${warning}`),
+  ]
+    .filter(Boolean)
+    .join("\n\n")
+}
+
+/** Live work first, then attention and unfinished work, then finished history. */
+export function spineStatusRank(state: string) {
+  const order = [
+    "running", "starting", "failed", "queued", "interrupted", "idle",
+    "open", "closed", "archived",
+  ]
+  const rank = order.indexOf(state)
+  return rank < 0 ? order.length : rank
+}
