+import { expect, test } from "bun:test"
+import { createServer } from "node:net"
+import { mkdtemp, rm, writeFile } from "node:fs/promises"
+import { join } from "node:path"
+import { NetaClient, initialView, loadView, ownerSession, saveView, savedHosts, type Snapshot } from "./index"
+import { shellQuote } from "./remote"
+
+test("saved view survives reopening; old Toad workspace migrates without its duplicate tabs", async () => {
+  const dir = await mkdtemp("/tmp/neta-view-")
+  try {
+    expect(await loadView(dir)).toBeUndefined()
+    await writeFile(
+      join(dir, "tui-view.json"),
+      JSON.stringify({ host: "local", workspace: "noscrubs", path: "/project/noscrubs", session: "stale" }),
+    )
+    expect(await loadView(dir)).toEqual({
+      host: "local",
+      workspaceId: "noscrubs",
+      path: "/project/noscrubs",
+      owner: "leader",
+      tabs: ["leader"],
+    })
+    const view = {
+      host: "ssh:test",
+      workspaceId: "other",
+      path: "/srv/project",
+      owner: "agent-1",
+      tabs: ["leader", "agent-1"],
+    }
+    await saveView(view, dir)
+    expect(await loadView(dir)).toEqual(view)
+    await writeFile(
+      join(dir, "client-hosts.json"),
+      JSON.stringify({ hosts: [{ id: "test", displayName: "Test", sshDestination: "host" }] }),
+    )
+    expect((await savedHosts(dir))[0]?.remoteNetaDir).toBe("~/.neta")
+    await writeFile(
+      join(dir, "client-hosts.json"),
+      JSON.stringify([{ id: "test", displayName: "Bad", sshDestination: "-oProxyCommand=bad" }]),
+    )
+    expect(savedHosts(dir)).rejects.toThrow()
+  } finally {
+    await rm(dir, { recursive: true, force: true })
+  }
+})
+
+test("RPC handles UTF-8 split across socket frames and rejects on disconnect", async () => {
+  const dir = await mkdtemp("/tmp/neta-rpc-")
+  const path = join(dir, "node.sock")
+  const server = createServer((socket) => {
+    socket.on("data", (line) => {
+      const request = JSON.parse(line.toString())
+      if (request.method === "hello") {
+        socket.write(JSON.stringify({ id: request.id, result: {} }) + "\n")
+        return
+      }
+      const bytes = Buffer.from(JSON.stringify({ id: request.id, result: "héllo" }) + "\n")
+      const index = bytes.indexOf(Buffer.from("é")) + 1
+      socket.write(bytes.subarray(0, index))
+      setTimeout(() => socket.end(bytes.subarray(index)), 10)
+    })
+  })
+  await new Promise<void>((resolve) => server.listen(path, resolve))
+  const client = await NetaClient.open(path, "fixture")
+  try {
+    expect(await client.request<string>("snapshot")).toBe("héllo")
+    await new Promise((resolve) => setTimeout(resolve, 30))
+    expect(client.request("snapshot")).rejects.toThrow("disconnected")
+  } finally {
+    client.close()
+    server.close()
+    await rm(dir, { recursive: true, force: true })
+  }
+})
+
+test("leader selection follows the owner instead of keeping superseded session IDs", () => {
+  const snapshot = { leaders: [{ workspaceId: "project", sessionId: "new" }], agents: [] } as unknown as Snapshot
+  expect(ownerSession(snapshot, "project", "leader")?.sessionId).toBe("new")
+  expect(ownerSession(snapshot, "other", "leader")).toBeUndefined()
+  expect(shellQuote("a'$(secret)")).toBe("'a'\\''$(secret)'")
+})
+
+test("bare launch restores the remote workspace; an explicit path opens locally", () => {
+  const previous = {
+    host: "ssh:test",
+    workspaceId: "remote",
+    path: "/srv/repo",
+    owner: "agent-1",
+    tabs: ["leader", "agent-1"],
+  }
+  const input = { cwd: "/local", previous, hosts: [] }
+  expect(initialView(input)).toEqual(previous)
+  expect(initialView({ ...input, path: "repo" })).toEqual({
+    host: "local",
+    workspaceId: "",
+    path: "/local/repo",
+    owner: "leader",
+    tabs: ["leader"],
+  })
+  expect(initialView({ ...input, host: "test", path: "/remote/other" }).path).toBe("/remote/other")
+  expect(() => initialView({ ...input, host: "missing" })).toThrow("project path")
+})
+
+test("saved machines accept legacy null optional paths without rewriting the registry", async () => {
+  const dir = await mkdtemp("/tmp/neta-hosts-")
+  try {
+    const host = {
+      id: "mini",
+      displayName: "Mini",
+      sshDestination: "runner@mini",
+      remoteNetaDir: "~/.neta",
+      sshConfig: null,
+      lastRemoteWorkspacePath: null,
+    }
+    const file = join(dir, "client-hosts.json")
+    const original = JSON.stringify({ hosts: [host] })
+    await writeFile(file, original)
+    expect(await savedHosts(dir)).toEqual([
+      { id: "mini", displayName: "Mini", sshDestination: "runner@mini", remoteNetaDir: "~/.neta" },
+    ])
+    expect(await Bun.file(file).text()).toBe(original)
+    await writeFile(file, JSON.stringify({ hosts: [{ ...host, lastRemoteWorkspacePath: 42 }] }))
+    await expect(savedHosts(dir)).rejects.toThrow("Invalid saved machine paths")
+  } finally {
+    await rm(dir, { recursive: true, force: true })
+  }
+})
