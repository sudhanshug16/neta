diff --git a/packages/tui/src/neta/status.tsx b/packages/tui/src/neta/status.tsx
new file mode 100644
index 0000000..ae45ee9
--- /dev/null
+++ b/packages/tui/src/neta/status.tsx
@@ -0,0 +1,61 @@
+import { Show } from "solid-js"
+import { Spinner } from "../component/spinner"
+import { useTheme } from "../context/theme"
+
+/** One terminal cell, shared by the spine and conversation tabs. */
+export function NetaStatus(props: { state: string }) {
+  const theme = useTheme()
+  const color = () => {
+    switch (props.state) {
+      case "failed":
+        return theme.text.feedback.error.default
+      case "blocked":
+      case "interrupted":
+      case "readyToClose":
+      case "mergedNotClosed":
+        return theme.text.feedback.warning.default
+      case "completed":
+        return theme.text.feedback.success.default
+      case "starting":
+      case "running":
+        return theme.text.feedback.info.default
+      default:
+        return theme.text.subdued
+    }
+  }
+  const symbol = () => {
+    switch (props.state) {
+      case "blocked":
+        return "!"
+      case "failed":
+        return "×"
+      case "completed":
+        return "✓"
+      case "closed":
+      case "archived":
+        return "□"
+      case "queued":
+        return "◷"
+      case "interrupted":
+        return "‖"
+      case "readyToClose":
+        return "◇"
+      case "mergedNotClosed":
+        return "◆"
+      case "idle":
+        return "○"
+      default:
+        return "?"
+    }
+  }
+  return (
+    <box width={1} height={1} flexShrink={0}>
+      <Show
+        when={props.state === "running" || props.state === "starting"}
+        fallback={<text fg={color()}>{symbol()}</text>}
+      >
+        <Spinner color={color()} />
+      </Show>
+    </box>
+  )
+}
diff --git a/packages/tui/src/neta/updates-context.tsx b/packages/tui/src/neta/updates-context.tsx
new file mode 100644
index 0000000..c916020
--- /dev/null
+++ b/packages/tui/src/neta/updates-context.tsx
@@ -0,0 +1,131 @@
+import { createContext, createSignal, onCleanup, useContext, type JSX } from "solid-js"
+import { createStore } from "solid-js/store"
+import { useStorageOptional } from "../context/storage"
+import { useToast } from "../ui/toast"
+import { isRecord } from "../util/record"
+import type { NetaView } from "./context"
+import type { NetaSendReceipt, UpdateReference } from "./updates-model"
+
+type Reading = {
+  read: Record<string, boolean>
+  readThrough?: number
+  selected?: string
+  expanded?: string
+  filter?: "unread" | "all"
+  scroll?: number
+  reference?: UpdateReference
+  replies?: (NetaSendReceipt & { sourceId: string; text: string })[]
+}
+type Saved = { views: Record<string, boolean>; sessions: Record<string, Reading> }
+
+function createUpdates(neta: NetaView) {
+  const toast = useToast()
+  const storage = useStorageOptional()
+  const initial: Saved = { views: {}, sessions: {} }
+  const [memory, setMemory] = createStore(initial)
+  const persisted = storage?.store<Saved>("neta-updates", { initial })
+  const saved = persisted?.[0] ?? memory
+  const workspace = JSON.stringify([neta.view.host, neta.view.workspaceId])
+  const session = JSON.stringify([neta.view.host, neta.sessionId])
+  const [active, setActive] = createSignal(saved.views[workspace] ?? false)
+  const [unread, setUnread] = createSignal<number>()
+  const [hasMore, setHasMore] = createSignal(false)
+  const reading = () => saved.sessions[session]
+  async function save(mutation: (state: Saved) => void) {
+    if (persisted) return persisted[1](mutation)
+    const next = structuredClone(JSON.parse(JSON.stringify(saved)) as Saved)
+    mutation(next)
+    setMemory(next)
+  }
+  const updateReading = (mutation: (state: Reading) => void) =>
+    save((state) => {
+      state.sessions[session] ??= { read: {} }
+      mutation(state.sessions[session])
+    })
+  let refreshing: Promise<void> | undefined
+  let dirty = false
+  async function refreshReceipt() {
+    if (!reading()?.replies?.some((item) => item.messageId)) return
+    dirty = true
+    if (refreshing) return refreshing
+    refreshing = (async () => {
+      while (dirty) {
+        dirty = false
+        const result = await neta.client.request<{ messages: { id: string; status: NetaSendReceipt["status"] }[] }>(
+          "conversation.inbox",
+          { sessionId: neta.sessionId },
+        )
+        await updateReading((state) => {
+          for (const reply of state.replies ?? []) {
+            const receipt = result.messages.find((item) => item.id === reply.messageId)
+            if (receipt) reply.status = receipt.status
+          }
+        })
+      }
+    })().finally(() => {
+      refreshing = undefined
+    })
+    return refreshing
+  }
+  onCleanup(
+    neta.client.subscribe((method, value) => {
+      const changed =
+        method === "state" ||
+        method === "conversation.ended" ||
+        (method === "turn" && isRecord(value) && isRecord(value.inbox))
+      if (changed && reading()?.replies?.some((item) => item.status !== "delivered" && item.status !== "discarded"))
+        void refreshReceipt().catch(toast.error)
+    }),
+  )
+  void refreshReceipt().catch(toast.error)
+  return {
+    active,
+    unread,
+    setUnread,
+    hasMore,
+    setHasMore,
+    reading,
+    isRead(item: UpdateReference) {
+      return reading()?.read[item.id] ?? item.at <= (reading()?.readThrough ?? -1)
+    },
+    markAllRead(through: number) {
+      return updateReading((state) => {
+        state.readThrough = Math.max(state.readThrough ?? -1, through)
+        state.read = {}
+      }).catch(toast.error)
+    },
+    setActive(value: boolean) {
+      setActive(value)
+      return save((state) => {
+        state.views[workspace] = value
+      }).catch(toast.error)
+    },
+    saveReading(value: Partial<Reading>) {
+      return updateReading((state) => {
+        Object.assign(state, value)
+      }).catch(toast.error)
+    },
+    markRead(id: string, read: boolean) {
+      return updateReading((state) => {
+        state.read[id] = read
+      }).catch(toast.error)
+    },
+    async sent(reference: UpdateReference, text: string, receipt: NetaSendReceipt | void) {
+      await updateReading((state) => {
+        state.read[reference.id] = true
+        if (state.reference?.id === reference.id) delete state.reference
+        state.replies = [
+          ...(state.replies ?? []).filter((item) => item.status !== "delivered" && item.status !== "discarded"),
+          { ...receipt, sourceId: reference.id, text },
+        ]
+      }).catch(toast.error)
+      await refreshReceipt().catch(toast.error)
+    },
+  }
+}
+
+const Context = createContext<ReturnType<typeof createUpdates>>()
+export function NetaUpdatesProvider(props: { neta: NetaView; children: JSX.Element }) {
+  return <Context.Provider value={createUpdates(props.neta)}>{props.children}</Context.Provider>
+}
+export const useNetaUpdates = () => useContext(Context)
