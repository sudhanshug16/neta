+import { expect, test } from "bun:test"
+import type { Agent, Mission } from "@neta/client"
+import { deliveryLabel, deliveryNeedsAttention, parentOwner } from "../src/neta/recovery"
+
+const agent: Agent = { id: "child", sessionId: "child-chat", workspaceId: "work", missionId: "mission",
+  name: "Child", provider: "opencode", model: "small", state: "interrupted", task: "inspect" }
+const mission: Mission = { id: "mission", workspaceId: "work", number: 1, name: "Inspect", state: "running",
+  createdAt: "2026-09-14", agentIds: ["lead", "child"], lead: { kind: "agent", agentId: "lead" } }
+
+test("inbox acceptance is not displayed as completed work", () => {
+  expect(deliveryLabel({ ...agent, deliveryStatus: "accepted" })).toBe("Result received by parent inbox")
+  expect(deliveryNeedsAttention({ ...agent, deliveryStatus: "accepted" })).toBe(false)
+  expect(deliveryNeedsAttention({ ...agent, deliveryStatus: "uncertain" })).toBe(true)
+  expect(deliveryNeedsAttention({ ...agent, deliveryStatus: "failed" })).toBe(true)
+})
+
+test("worker review opens mission lead and lead review opens workspace leader", () => {
+  expect(parentOwner(agent, mission)).toBe("lead")
+  expect(parentOwner({ ...agent, canSpawn: true }, mission)).toBe("leader")
+  expect(parentOwner(agent, { ...mission, lead: { kind: "leader" } })).toBe("leader")
+})
+
+test("active agents do not show old successful receipts, but retain delivery failures", () => {
+ for (const state of ["running", "starting", "queued"] as const) {
+ expect(deliveryLabel({ ...agent, state, deliveryStatus: "accepted" })).toBeUndefined()
+ expect(deliveryLabel({ ...agent, state, deliveryStatus: "uncertain" })).toContain("uncertain")
+ }
+})
