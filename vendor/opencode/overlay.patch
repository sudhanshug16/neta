 export function databasePath(data: string) {
+  if (process.env.NETA_MANAGED_OPENCODE === "1" && !process.env.OPENCODE_DB) {
+    const target = path.join(data, "opencode-neta-v2.db")
+    if (existsSync(target)) return target
+    const source =
+      process.env.NETA_OPENCODE_V1_DB ??
+      ["opencode-local.db", "opencode-neta.db", "opencode.db"].map((name) => path.join(data, name)).find(existsSync)
+    if (!source) return target
+    // Snapshot SQLite, including its WAL, without upgrading the V1 source.
+    mkdirSync(data, { recursive: true })
+    const temporary = `${target}.${randomUUID()}.tmp`
+    const database = new Database(source, { readonly: true })
+    try {
+      writeFileSync(temporary, database.serialize(), { mode: 0o600, flag: "wx" })
+      try {
+        linkSync(temporary, target)
+      } catch (error) {
+        if (!(error instanceof Error && "code" in error && error.code === "EEXIST")) throw error
+      }
+    } finally {
+      database.close()
+      if (existsSync(temporary)) unlinkSync(temporary)
+    }
+    return target
+  }
   const filename =
