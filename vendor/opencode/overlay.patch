diff --git a/packages/tui/src/ui/terminal-dimensions.ts b/packages/tui/src/ui/terminal-dimensions.ts
new file mode 100644
index 0000000..1f6e558
--- /dev/null
+++ b/packages/tui/src/ui/terminal-dimensions.ts
@@ -0,0 +1,52 @@
+import { useRenderer } from "@opentui/solid"
+import { createContext, createSignal, onCleanup, useContext, type Accessor } from "solid-js"
+
+interface Renderer {
+  width: number
+  height: number
+  on(event: "resize", listener: (width: number, height: number) => void): unknown
+  off(event: "resize", listener: (width: number, height: number) => void): unknown
+}
+
+type Size = { width: number; height: number }
+const sizes = new WeakMap<
+  Renderer,
+  { read: Accessor<Size>; listener: (width: number, height: number) => void; count: number }
+>()
+
+/** A renderer gets one resize listener, regardless of mounted dialogs or rows. */
+export function acquireTerminalDimensions(renderer: Renderer) {
+  let entry = sizes.get(renderer)
+  if (!entry) {
+    const [read, write] = createSignal({ width: renderer.width, height: renderer.height })
+    const listener = (width: number, height: number) => write({ width, height })
+    entry = { read, listener, count: 0 }
+    sizes.set(renderer, entry)
+    renderer.on("resize", listener)
+  }
+  const current = entry
+  current.count++
+  let released = false
+  return {
+    read: current.read,
+    release: () => {
+      if (released) return
+      released = true
+      if (--current.count === 0) {
+        renderer.off("resize", current.listener)
+        sizes.delete(renderer)
+      }
+    },
+  }
+}
+
+const Viewport = createContext<Accessor<Size>>()
+export const TerminalViewport = Viewport.Provider
+
+export function useTerminalDimensions() {
+  const viewport = useContext(Viewport)
+  if (viewport) return viewport
+  const dimensions = acquireTerminalDimensions(useRenderer())
+  onCleanup(dimensions.release)
+  return dimensions.read
+}
