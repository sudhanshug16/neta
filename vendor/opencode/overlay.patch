index 0000000..05ef77c
--- /dev/null
+++ b/packages/tui/src/neta/reconnect.ts
@@ -0,0 +1,40 @@
+/** Reopen the saved Neta view, rather than retrying a dead native server URL. */
+export function createNetaReconnect(options: {
+  connect(): Promise<boolean>
+  failed(): void
+  delayMs?: number
+  attempts?: number
+}) {
+  let timer: ReturnType<typeof setTimeout> | undefined
+  let active = false
+  let stopped = false
+  let attempt = 0
+  let reported = false
+  async function retry() {
+    timer = undefined
+    const connected = await options.connect().catch(() => false)
+    if (stopped || connected) {
+      active = false
+      return
+    }
+    attempt += 1
+    if (!reported && attempt >= (options.attempts ?? 5)) {
+      reported = true
+      options.failed()
+    }
+    timer = setTimeout(retry, Math.min(30_000, (options.delayMs ?? 1000) * 2 ** Math.min(attempt, 30)))
+  }
+  return {
+    start() {
+      if (active || stopped) return
+      active = true
+      attempt = 0
+      reported = false
+      timer = setTimeout(retry, options.delayMs ?? 1000)
+    },
+    stop() {
+      stopped = true
+      if (timer !== undefined) clearTimeout(timer)
+    },
+  }
+}
diff --git a/packages/tui/src/neta/recovery.ts b/packages/tui/src/neta/recovery.ts
new file mode 100644
index 0000000..5cf137a
--- /dev/null
+++ b/packages/tui/src/neta/recovery.ts
@@ -0,0 +1,18 @@
+import type { Agent, Mission } from "@neta/client"
+
+export function deliveryLabel(agent: Agent): string | undefined {
+  switch (agent.deliveryStatus) {
+    case "pending": return "Result queued"
+    case "accepted": return ["running", "starting", "queued"].includes(agent.state) ? undefined : "Result received by parent inbox"
+    case "uncertain": return "Delivery uncertain · review parent"
+    case "failed": return "Parent unavailable · retry delivery"
+  }
+}
+
+export function deliveryNeedsAttention(agent: Agent): boolean {
+  return agent.deliveryStatus === "uncertain" || agent.deliveryStatus === "failed"
+}
+
+export function parentOwner(agent: Agent, mission?: Mission): string {
+  return agent.canSpawn || mission?.lead?.kind !== "agent" ? "leader" : mission.lead.agentId
+}
diff --git a/packages/tui/src/neta/routing.tsx b/packages/tui/src/neta/routing.tsx
new file mode 100644
index 0000000..1c94b74
--- /dev/null
+++ b/packages/tui/src/neta/routing.tsx
@@ -0,0 +1,324 @@
+import type { Agent, Leader, Mission, NetaClient, RoutingAuthStatus } from "@neta/client"
+import { InputRenderable, TextAttributes } from "@opentui/core"
+import { createSignal, For, onCleanup, onMount, Show } from "solid-js"
+import { Keymap } from "../context/keymap"
+import { useTheme } from "../context/theme"
+import { useDialog } from "../ui/dialog"
+import { useTerminalDimensions } from "../ui/terminal-dimensions"
+import { modelDecisionText } from "./presentation"
+import { NetaModelPreferences } from "./model-preferences"
+
+type RoutingLogs = {
+  agents: Agent[]
+  missions: Mission[]
+  changes?: {
+    kind?: string
+    at: string
+    agentId?: string
+    missionId?: string
+    data: Record<string, string | number | boolean | null>
+  }[]
+}
+
+export function NetaRouting(props: {
+  actor: Agent | Leader
+  client: Pick<NetaClient, "request">
+  machineName: string
+}) {
+  const theme = useTheme("elevated")
+  const dialog = useDialog()
+  const dimensions = useTerminalDimensions()
+  const [logs, setLogs] = createSignal<RoutingLogs>()
+  const [logError, setLogError] = createSignal(false)
+  const [status, setStatus] = createSignal<RoutingAuthStatus>()
+  const [message, setMessage] = createSignal("")
+  const [failed, setFailed] = createSignal(false)
+  const [busy, setBusy] = createSignal(false)
+  const [editing, setEditing] = createSignal(true)
+  let input: InputRenderable
+  let secret = ""
+  let disposed = false
+
+  onMount(() => {
+    void props.client
+      .request<RoutingLogs>("routing.logs", {
+        workspaceId: props.actor.workspaceId,
+      })
+      .then((result) => {
+        if (!disposed) setLogs(result)
+      })
+      .catch(() => {
+        if (!disposed) setLogError(true)
+      })
+  })
+
+  onMount(async () => {
+    try {
+      const result = await props.client.request<RoutingAuthStatus>("routing.auth.status")
+      if (!disposed && !status()) setStatus(result)
+    } catch {
+      if (!disposed && !status()) {
+        setFailed(true)
+        setMessage("Cannot load key status. Check the Neta connection and reopen /routing.")
+      }
+    }
+  })
+  onCleanup(() => {
+    disposed = true
+    secret = ""
+  })
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    commands: [
+      {
+        bind: "f2",
+        title: "Model preferences",
+        group: "Dialog",
+        run: () => {
+          openPreferences()
+        },
+      },
+      {
+        bind: "tab",
+        title: "Switch routing field",
+        group: "Dialog",
+        run: () => {
+          setEditing(!editing())
+        },
+      },
+    ],
+  }))
+
+  function replace(start: number, end: number, text: string) {
+    const next = secret.slice(0, start) + text + secret.slice(end)
+    if (next.length > 4096 || /[^\x21-\x7e]/.test(next)) {
+      setFailed(true)
+      setMessage("Use an API key without spaces (up to 4096 characters).")
+      return
+    }
+    secret = next
+    // The renderable, selection and undo buffers receive masks only, never the key.
+    input.value = "*".repeat(secret.length)
+    input.cursorOffset = start + text.length
+    setFailed(false)
+    setMessage("")
+  }
+
+  async function save() {
+    if (busy()) return
+    if (!secret) {
+      setFailed(true)
+      setMessage("Paste or type your Jev API key first.")
+      return
+    }
+    setBusy(true)
+    setMessage("")
+    try {
+      const result = await props.client.request<RoutingAuthStatus>("routing.auth.save", { apiKey: secret })
+      if (disposed) return
+      replace(0, secret.length, "")
+      setStatus(result)
+      setMessage("Key saved. Ready for the next delegation; not yet verified with Jev.")
+    } catch {
+      // A remote error may include input. Do not echo it into the terminal or toast log.
+      if (!disposed) {
+        setFailed(true)
+        setMessage("Could not save the key. Check the Neta connection and data-directory access, then retry.")
+      }
+    } finally {
+      if (!disposed) setBusy(false)
+    }
+  }
+
+  function openPreferences() {
+    if (busy()) return
+    dialog.replace(() => (
+      <NetaModelPreferences
+        client={props.client}
+        workspaceId={props.actor.workspaceId}
+        machineName={props.machineName}
+        back={() => {
+          dialog.replace(() => <NetaRouting {...props} />)
+          dialog.setSize("large")
+        }}
+      />
+    ))
+    dialog.setSize("large")
+    dialog.setCentered(true)
+  }
+
+  return (
+    <box
+      paddingLeft={2}
+      paddingRight={2}
+      paddingBottom={1}
+      gap={1}
+      maxHeight={Math.max(12, Math.floor(dimensions().height * 0.75) - 4)}
+    >
+      <box flexDirection="row" justifyContent="space-between" flexShrink={0}>
+        <text attributes={TextAttributes.BOLD} fg={theme.text.default}>
+          Session routing log
+        </text>
+        <text fg={theme.text.subdued} onMouseUp={() => dialog.clear()}>
+          esc
+        </text>
+      </box>
+      <scrollbox flexShrink={1} minHeight={3} focused={!editing()}>
+        <Show
+          when={logs()}
+          fallback={
+            <text fg={theme.text.subdued}>
+              {logError() ? "Cannot load routing logs. Reopen /routing to retry." : "Loading routing logs…"}
+            </text>
+          }
+        >
+          <Show
+            when={logs()!.agents.length > 0}
+            fallback={<text fg={theme.text.subdued}>No routing decisions recorded for this workspace yet.</text>}
+          >
+            <For each={logs()!.agents.toReversed()}>
+              {(agent) => {
+                const mission = () => logs()!.missions.find((item) => item.id === agent.missionId)
+                return (
+                  <box flexShrink={0} marginBottom={1} gap={1}>
+                    <text fg={theme.text.default} attributes={TextAttributes.BOLD}>
+                      {agent.name} · #{mission()?.number ?? "?"} · {agent.state}
+                    </text>
+                    <text fg={theme.text.subdued}>{modelDecisionText(agent)}</text>
+                  </box>
+                )
+              }}
+            </For>
+          </Show>
+          <For each={logs()!.changes?.toReversed()}>
+            {(event) => (
+              <box flexShrink={0} marginBottom={1} gap={1}>
+                <text fg={theme.text.default} attributes={TextAttributes.BOLD}>
+                  {event.kind === "routing.failed"
+                    ? "Routing failed"
+                    : `${logs()!.agents.find((agent) => agent.id === event.agentId)?.name ?? "Agent"} · #${logs()!.missions.find((mission) => mission.id === event.missionId)?.number ?? "?"} · Model change`}{" "}
+                  · {event.at}
+                </text>
+                <text fg={theme.text.subdued}>
+                  {[
+                    event.data.model ? `${event.data.previousModel} → ${event.data.model}` : undefined,
+                    event.data.effort ? `Task effort ${event.data.effort}/5` : undefined,
+                    event.data.method ? `Routing: ${event.data.method}` : undefined,
+                    event.data.reason,
+                    event.data.warnings,
+                  ]
+                    .filter(Boolean)
+                    .join("\n\n")}
+                </text>
+              </box>
+            )}
+          </For>
+        </Show>
+      </scrollbox>
+      <box flexShrink={0}>
+        <text fg={theme.text.default} attributes={TextAttributes.BOLD}>
+          Jev API key · {props.machineName}
+        </text>
+        <text fg={theme.text.subdued}>
+          {status()?.error ??
+            (status()?.source === "saved"
+              ? "Configured · saved privately on this machine"
+              : status()?.source === "environment"
+                ? "Configured · TYPESAFE_API_KEY (saving here replaces it)"
+                : status()
+                  ? "Not configured · fixed routing needs no key"
+                  : "Checking key status…")}
+        </text>
+        <input
+          id="neta-routing-key"
+          ref={(value: InputRenderable) => {
+            input = value
+          }}
+          focused={editing() && !busy()}
+          selectable={false}
+          placeholder={status()?.configured ? "Paste a replacement key" : "Paste your TypeSafe/Jev API key"}
+          placeholderColor={theme.text.subdued}
+          textColor={theme.text.formfield.default}
+          focusedTextColor={theme.text.formfield.default}
+          backgroundColor={theme.background.formfield.default}
+          focusedBackgroundColor={theme.background.formfield.default}
+          cursorColor={theme.text.default}
+          onPaste={(event) => {
+            event.preventDefault()
+            event.stopPropagation()
+            if (!busy()) replace(input.cursorOffset, input.cursorOffset, new TextDecoder().decode(event.bytes).trim())
+          }}
+          onKeyDown={(event) => {
+            if (event.name === "f2") {
+              event.preventDefault()
+              event.stopPropagation()
+              openPreferences()
+              return
+            }
+            if (event.name === "escape" || event.name === "tab") return
+            event.preventDefault()
+            event.stopPropagation()
+            if (busy()) return
+            const cursor = input.cursorOffset
+            if (event.name === "return") {
+              void save()
+              return
+            }
+            if (event.ctrl && event.name === "u") {
+              replace(0, secret.length, "")
+              return
+            }
+            if (event.ctrl && event.name === "k") {
+              replace(cursor, secret.length, "")
+              return
+            }
+            if (event.name === "home" || (event.ctrl && event.name === "a")) {
+              input.cursorOffset = 0
+              return
+            }
+            if (event.name === "end" || (event.ctrl && event.name === "e")) {
+              input.cursorOffset = secret.length
+              return
+            }
+            if (event.name === "left") {
+              input.cursorOffset = Math.max(0, cursor - 1)
+              return
+            }
+            if (event.name === "right") {
+              input.cursorOffset = Math.min(secret.length, cursor + 1)
+              return
+            }
+            if (event.name === "backspace") {
+              replace(Math.max(0, cursor - 1), cursor, "")
+              return
+            }
+            if (event.name === "delete") {
+              replace(cursor, cursor + 1, "")
+              return
+            }
+            if (!event.ctrl && !event.meta && !event.super && !event.option && /^[\x20-\x7e]$/.test(event.sequence))
+              replace(cursor, cursor, event.sequence)
+          }}
+        />
+        <text fg={failed() ? theme.text.feedback.error.default : theme.text.subdued}>
+          {busy() ? "Saving…" : message() || "Private to this machine; routing policy stays unchanged."}
+        </text>
+        <box flexDirection="row" gap={1}>
+          <text
+            fg={theme.text.action.primary.default}
+            onMouseUp={() => {
+              void save()
+            }}
+          >
+            enter save
+          </text>
+          <text fg={theme.text.subdued}>· ctrl+u clear · tab {editing() ? "details" : "key"} ·</text>
+          <text fg={theme.text.action.primary.default} onMouseUp={openPreferences}>
+            f2 models
+          </text>
+        </box>
+      </box>
+    </box>
+  )
+}
