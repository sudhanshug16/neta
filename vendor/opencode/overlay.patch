+    )
+    const click = async (text: string, direction: "up" | "down" = "down") => {
+      for (let step = 0; step < 16 && !app.captureCharFrame().includes(text); step++) {
+        await app.mockMouse.scroll(15, 35, direction)
+        await app.waitForVisualIdle()
+      }
+      const lines = app.captureCharFrame().split("\n")
+      const row = lines.findIndex((line) => line.includes(text))
+      const line = lines[row]
+      expect(line, `Visible row for ${text}`).toBeDefined()
+      if (!line) throw new Error(`Missing row: ${text}`)
+      await app.mockMouse.click(line.indexOf(text) + 1, row)
+    }
+    try {
+      app.renderer.start()
+      if (width < 95) {
+        await app.waitForFrame((frame) => frame.includes("Help · actions"))
+        expect(app.captureCharFrame()).toContain("78×59")
+        await click("Help · actions")
+        await app.waitForFrame((frame) => frame.includes("Spine help"))
+        expect(app.captureCharFrame()).toContain("Switch workspace")
+      } else {
+      await app.waitForFrame((frame) => frame.includes("#10 Mission 10"))
+      const initial = app.captureCharFrame()
+      for (let number = 3; number <= 10; number++) expect(initial).toContain(`#${number} Mission ${number}`)
+      expect(initial).toContain("#0 Still active")
+      expect(initial.indexOf("#10 Mission 10")).toBeLessThan(initial.indexOf("#0 Still active"))
+      expect(initial.indexOf("#0 Still active")).toBeLessThan(initial.indexOf("#9 Mission 9"))
+      expect(initial).toContain("Hazel")
+      expect(initial).toContain("Rowan")
+      expect(initial).toContain("Pru")
+      expect(initial).toContain("Quill")
+      expect(initial).not.toContain("Cove")
+      expect(initial).toContain("NOT RUNNING")
+      expect(initial).not.toContain("ARCHIVED")
+       expect(initial).toContain("○ Coordinator")
+       expect(calls).toEqual([])
+       if (process.env.NETA_TEST_CAPTURE === "1") await Bun.write(`/tmp/neta-recent-missions-${width}.txt`, initial)
+
+       await click("Hazel")
+       await app.waitForVisualIdle()
+       expect(navigated).toEqual(["mission-lead"])
+       await click("#10 Mission 10")
+      await app.waitForFrame((frame) => frame.includes("Cove"))
+      const expanded = app.captureCharFrame()
+      expect(expanded.match(/Hazel/g)?.length).toBe(1)
+      expect(expanded.match(/Rowan/g)?.length).toBe(1)
+      expect(expanded).toContain("Cove")
+      }
+    } finally {
+      app.renderer.destroy()
+      socket.destroy()
+    }
+  })
+}
diff --git a/packages/tui/test/neta-reconnect.test.ts b/packages/tui/test/neta-reconnect.test.ts
new file mode 100644
index 0000000..6f07223
--- /dev/null
+++ b/packages/tui/test/neta-reconnect.test.ts
@@ -0,0 +1,63 @@
+import { expect, test } from "bun:test"
+import { createNetaReconnect } from "../src/neta/reconnect"
+
+test("reconnects once after duplicate disconnect events and retries failures", async () => {
+  let calls = 0
+  let failed = false
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    connect: async () => ++calls === 2,
+    failed: () => { failed = true },
+  })
+  recovery.start()
+  recovery.start()
+  await Bun.sleep(40)
+  recovery.stop()
+  expect(calls).toBe(2)
+  expect(failed).toBe(false)
+})
+
+test("continues recovery after showing the failure notice", async () => {
+  let calls = 0
+  let failures = 0
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    attempts: 2,
+    connect: async () => ++calls === 4,
+    failed: () => { failures++ },
+  })
+  recovery.start()
+  await Bun.sleep(80)
+  expect(calls).toBe(4)
+  expect(failures).toBe(1)
+  recovery.start()
+  recovery.stop()
+  expect(calls).toBe(4)
+})
+
+test("unmount cancels scheduled and in-flight retries", async () => {
+  let calls = 0
+  let finish!: (connected: boolean) => void
+  const recovery = createNetaReconnect({
+    delayMs: 1,
+    connect: () => { calls++; return new Promise<boolean>((resolve) => { finish = resolve }) },
+    failed: () => { throw new Error("must not report after unmount") },
+  })
+  recovery.start()
+  await Bun.sleep(20)
+  recovery.stop()
+  finish(false)
+  recovery.start()
+  await Bun.sleep(20)
+  expect(calls).toBe(1)
+  let scheduled = 0
+  const cancelled = createNetaReconnect({
+    delayMs: 10,
+    connect: async () => { scheduled++; return true },
+    failed: () => {},
+  })
+  cancelled.start()
+  cancelled.stop()
+  await Bun.sleep(20)
+  expect(scheduled).toBe(0)
+})
