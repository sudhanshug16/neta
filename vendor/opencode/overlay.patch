@@ -0,0 +1,22 @@
+import { expect, test } from "bun:test"
+import { EventEmitter } from "node:events"
+import { acquireTerminalDimensions } from "../src/ui/terminal-dimensions"
+
+test("dialogs and transcript rows share one resize listener and release it", () => {
+  const renderer = Object.assign(new EventEmitter(), { width: 100, height: 40 })
+  const mounted = Array.from({ length: 100 }, () => acquireTerminalDimensions(renderer))
+  expect(renderer.listenerCount("resize")).toBe(1)
+  renderer.width = 140
+  renderer.height = 50
+  renderer.emit("resize", 140, 50)
+  for (const item of mounted) expect(item.read()).toEqual({ width: 140, height: 50 })
+  for (const item of mounted.slice(1)) item.release()
+  expect(renderer.listenerCount("resize")).toBe(1)
+  mounted[0]!.release()
+  mounted[0]!.release()
+  expect(renderer.listenerCount("resize")).toBe(0)
+  const reopened = acquireTerminalDimensions(renderer)
+  expect(reopened.read()).toEqual({ width: 140, height: 50 })
+  reopened.release()
+  expect(renderer.listenerCount("resize")).toBe(0)
+})
