@@ -0,0 +1,266 @@
+import { ensureLocalRuntime, openStartupConversation } from "@neta/client/startup"
+import { execFile } from "node:child_process"
+import { access, readFile } from "node:fs/promises"
+import { dirname, join, resolve } from "node:path"
+import { fileURLToPath } from "node:url"
+import { createInterface } from "node:readline/promises"
+import { Effect, Option, FileSystem } from "effect"
+import {
+  NetaClient,
+  netaDirectory,
+  NetaError,
+  initialView,
+  loadView,
+  saveView,
+  savedHosts,
+  ownerSession,
+  type Snapshot,
+  type View,
+  type Workspace,
+  type Leader,
+  type Attachment,
+} from "@neta/client"
+import { connectRemote } from "@neta/client/remote"
+import { run, type TuiInput } from "@opencode/tui"
+import { Config } from "../../config"
+import { Npm } from "@opencode/util/npm"
+import { OPENCODE_VERSION } from "../../version"
+import { Global } from "@opencode/util/global"
+import { Commands } from "../commands"
+import { Runtime } from "../../framework/runtime"
+async function localClient() {
+  const root = process.env.NETA_OPENCODE_DIR ?? resolve(dirname(fileURLToPath(import.meta.url)), "../../../../..")
+  const entry = process.env.NETA_ENGINE_ENTRY ?? resolve(root, "../neta/dist/main.js")
+  const command = async (...args: string[]) => {
+    await access(entry).catch(() => {
+      throw new Error("Build the Neta engine first: run bun run build in the neta checkout.")
+    })
+    await new Promise<void>((resolve, reject) => {
+      execFile(
+        entry.endsWith(".ts") ? "bun" : "node",
+        [entry, "node", ...args],
+        { env: { ...process.env, NETA_OPENCODE_DIR: root }, timeout: 30_000 },
+        (error) => (error ? reject(error) : resolve()),
+      )
+    })
+  }
+  return ensureLocalRuntime({
+    connect: () => NetaClient.connect(),
+    expectedBuild: process.env.NETA_ENGINE_BUILD,
+    start: () => command("start", "--detach"),
+    validateReplacement: async () => {
+      await access(entry)
+      await new Promise<void>((resolve, reject) => {
+        execFile(
+          entry.endsWith(".ts") ? "bun" : "node",
+          [entry, "--version"],
+          { env: process.env, timeout: 15_000 },
+          (error) => (error ? reject(error) : resolve()),
+        )
+      })
+    },
+    replace: async (instanceId) => {
+      const deadline = Date.now() + 30_000
+      for (;;) {
+        const raw = await readFile(join(netaDirectory(), "node.json"), "utf8").catch((error: unknown) => {
+          if (error instanceof Error && "code" in error && error.code === "ENOENT") return undefined
+          throw error
+        })
+        const descriptor: unknown = raw ? JSON.parse(raw) : undefined
+        if (
+          !descriptor ||
+          typeof descriptor !== "object" ||
+          !("instanceId" in descriptor) ||
+          descriptor.instanceId !== instanceId
+        )
+          break
+        if (Date.now() >= deadline)
+          throw new Error(
+            "Neta's update has not finished retiring the previous service. Saved work is retained; retry neta after it settles.",
+          )
+        await new Promise((resolve) => setTimeout(resolve, 100))
+      }
+      await command("start", "--detach")
+    },
+    notice: (message) => process.stderr.write(`${message}\n`),
+  })
+}
+
+export default Runtime.handler(Commands.commands.neta, (input) =>
+  Effect.gen(function* () {
+    process.env.NETA_TUI = "1"
+    const config = yield* Config.Service
+    const npm = yield* Npm.Service
+    const context = yield* Effect.context<FileSystem.FileSystem | Global.Service>()
+    const runPromise = Effect.runPromiseWith(context)
+    const args = {
+      path: Option.getOrUndefined(input.path),
+      host: Option.getOrUndefined(input.host),
+      migrate: input.migrate,
+    }
+    yield* Effect.tryPromise(async () => {
+      if (process.env.NETA_LAUNCH_CWD) process.chdir(process.env.NETA_LAUNCH_CWD)
+      const previous = await loadView()
+      const hosts = await savedHosts()
+      const drafts = new Map() as NonNullable<TuiInput["neta"]>["drafts"]
+      const initial = initialView({ path: args.path, host: args.host, cwd: process.cwd(), previous, hosts })
+      async function prepare(requested: View, interactive: boolean, migrate = args.migrate) {
+        const view = { ...requested, tabs: [...requested.tabs] }
+        const host = hosts.find((host) => `ssh:${host.id}` === view.host)
+        if (view.host !== "local" && !host)
+          throw new Error("The saved machine is missing. Choose --host local or restore its machine entry.")
+        const connection = host
+          ? await connectRemote(host)
+          : { client: await localClient(), native: async (attachment: Attachment) => attachment, close: async () => {} }
+        const client = connection.client
+        try {
+          const capabilities = await client
+            .request<{ nativeOpenCode?: number; nativeOpenCodeVersions?: number[] }>("runtime.capabilities")
+            .catch((error: unknown) => {
+              if (error instanceof NetaError && error.code === -32601) return undefined
+              throw error
+            })
+          if (!capabilities?.nativeOpenCodeVersions?.includes(2))
+            throw new Error(
+              `Neta on ${host?.displayName ?? "this machine"} needs the migrated engine. Build it, then restart its Node with neta node stop followed by neta node start --detach. Running work will be interrupted; saved conversations and missions are retained.`,
+            )
+          const opened = await client.request<{ workspace: Workspace; leader: Leader }>("workspace.open", {
+            path: view.path,
+            provider: "opencode",
+          })
+          view.workspaceId = opened.workspace.id
+          view.path =
+            opened.workspace.roots.find((root) => root.machineId === opened.leader.machineId)?.path ?? view.path
+          let snapshot = await client.request<Snapshot>("snapshot")
+          let selected = ownerSession(snapshot, view.workspaceId, view.owner)
+          if (!selected) {
+            view.owner = "leader"
+            selected = opened.leader
+          }
+          if (selected.provider !== "opencode") {
+            if (!migrate && interactive && process.stdin.isTTY) {
+              const reader = createInterface({ input: process.stdin, output: process.stdout })
+              try {
+                migrate =
+                  (
+                    await reader.question(
+                      `${selected.name} uses ${selected.provider}. Start a fresh OpenCode conversation here? Existing Neta history is retained. [y/N] `,
+                    )
+                  )
+                    .trim()
+                    .toLowerCase() === "y"
+              } finally {
+                reader.close()
+              }
+            }
+            if (!migrate)
+              throw new Error(
+                "This workspace still uses a legacy provider. Open it with neta tui --migrate to move it to OpenCode; its Neta history is retained.",
+              )
+            await client.request("conversation.setProvider", {
+              sessionId: selected.sessionId,
+              provider: "opencode",
+              handoff: "",
+            })
+            snapshot = await client.request<Snapshot>("snapshot")
+            selected = ownerSession(snapshot, view.workspaceId, view.owner)!
+          }
+          const restored = await openStartupConversation({
+            client,
+            selected,
+            leader: opened.leader,
+            recover: interactive,
+          })
+          if (restored.recovered) view.owner = "leader"
+          const attachment = await connection.native(restored.attachment)
+          if (attachment.integrationVersion !== 2)
+            throw new Error(
+              "This Node is still running an older OpenCode runtime. Finish active work, then restart the Node with the updated Neta CLI and reopen this workspace.",
+            )
+          return {
+            view,
+            notice: restored.notice,
+            snapshot,
+            attachment,
+            client,
+            close: async () => {
+              client.close()
+              await connection.close()
+            },
+          }
+        } catch (error) {
+          client.close()
+          await connection.close()
+          throw error
+        }
+      }
+      let next: Awaited<ReturnType<typeof prepare>> | undefined = await prepare(initial, true)
+      while (next) {
+        const current = next
+        next = undefined
+        const { view, snapshot, attachment, client } = current
+        try {
+          await saveView(view)
+
+          await runPromise(
+            run({
+              app: { name: "neta", version: OPENCODE_VERSION, channel: "neta" },
+              server: {
+                endpoint: {
+                  url: attachment.url,
+                  auth: (() => {
+                    const [username, ...password] = Buffer.from(attachment.authorization.slice(6), "base64")
+                      .toString()
+                      .split(":")
+                    return { type: "basic" as const, username: username!, password: password.join(":") }
+                  })(),
+                },
+              },
+              args: { sessionID: attachment.sessionId },
+              config: {
+                path: config.path,
+                get: () => runPromise(config.get()),
+                update: (update) => runPromise(config.update(update)),
+              },
+              packages: { prepare: (spec, install = true) => runPromise(install ? npm.add(spec) : npm.resolve(spec)) },
+              neta: {
+                client,
+                startupNotice: current.notice,
+                snapshot,
+                view,
+                sessionId: attachment.netaSessionId,
+                hosts,
+                drafts,
+                send: async (input) => {
+                  const response = await fetch(`${attachment.url}/api/session/${attachment.sessionId}/neta-prompt`, {
+                    method: "POST",
+                    headers: { Authorization: attachment.authorization, "content-type": "application/json" },
+                    body: JSON.stringify({ ...input, id: crypto.randomUUID() }),
+                  })
+                  if (!response.ok) {
+                    const error = (await response.json()) as { data?: { message?: string } }
+                    throw new Error(error.data?.message ?? "Neta could not send this message")
+                  }
+                  return response.json()
+                },
+                navigate: async (view, migrate) => {
+                  next = await prepare(view, false, migrate ?? args.migrate)
+                },
+              },
+            }),
+          )
+        } finally {
+          await current.close()
+        }
+      }
+    }).pipe(
+      Effect.catch((error) =>
+        Effect.sync(() => {
+          const cause = error.cause
+          process.stderr.write(`neta: ${cause instanceof Error ? cause.message : String(cause)}\n`)
+          process.exitCode = 1
+        }),
+      ),
+    )
+  }),
+)
diff --git a/packages/cli/test/acp/fallback.test.ts b/packages/cli/test/acp/fallback.test.ts
