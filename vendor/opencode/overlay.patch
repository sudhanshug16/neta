@@ -0,0 +1,25 @@
+import { expect, test } from "bun:test"
+import type { AttentionNotifyOptions } from "@opencode/plugin/tui/context"
+import { createNetaNotifications } from "../src/neta/notifications"
+
+test("only Neta responses notify, once per turn and in the current workspace", () => {
+  const sent: AttentionNotifyOptions[] = []
+  const notify = createNetaNotifications({ notify: async value => {
+    sent.push(value)
+    return { ok: true, notification: true, sound: true }
+  } }, "w")
+  const turn = { id: "one", endedAt: "2026-09-27T12:00:00Z" }
+  for (const role of ["leader", "lead", "agent", undefined])
+    notify("conversation.ended", { role, workspaceId: "w", sessionId: "actor", turn })
+  notify("conversation.ended", { role: "neta", workspaceId: "other", sessionId: "neta", turn })
+  expect(sent).toHaveLength(0)
+  for (let i = 0; i < 2; i++)
+    notify("conversation.ended", { role: "neta", workspaceId: "w", sessionId: "neta", turn })
+  expect(sent).toHaveLength(1)
+  expect(sent[0]?.title).toBe("Neta")
+  notify("conversation.ended", { role: "neta", workspaceId: "w", sessionId: "neta", turn: { ...turn, id: "failed", failed: true } })
+  expect(sent[1]?.message).toContain("failed")
+  notify("conversation.ended", { role: "neta", workspaceId: "w", sessionId: "neta", turn: { id: "open" } })
+  notify("conversation.ended", null)
+  expect(sent).toHaveLength(2)
+})
