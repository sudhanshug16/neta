+import { expect, test } from "bun:test"
+import { testRender } from "@opentui/solid"
+import { createSignal } from "solid-js"
+import { TerminalViewport, useTerminalDimensions } from "../src/ui/terminal-dimensions"
+
+test("native chat measures its pane while outer dialogs retain terminal dimensions", async () => {
+  const [size, setSize] = createSignal({ width: 78, height: 31 })
+  function Probe() {
+    const dimensions = useTerminalDimensions()
+    return (
+      <text>
+        {dimensions().width}×{dimensions().height}
+      </text>
+    )
+  }
+  const app = await testRender(
+    () => (
+      <box flexDirection="column">
+        <Probe />
+        <TerminalViewport value={size}>
+          <Probe />
+        </TerminalViewport>
+      </box>
+    ),
+    { width: 120, height: 40 },
+  )
+  try {
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain("120×40")
+    expect(app.captureCharFrame()).toContain("78×31")
+    setSize({ width: 65, height: 21 })
+    await app.renderOnce()
+    expect(app.captureCharFrame()).toContain("65×21")
+    expect(app.captureCharFrame()).toContain("120×40")
+  } finally {
+    app.renderer.destroy()
+  }
+})
diff --git a/packages/tui/test/terminal-dimensions.test.ts b/packages/tui/test/terminal-dimensions.test.ts
