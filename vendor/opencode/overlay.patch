+            expect(event.system[0]?.text).toContain("An open PR remains an open mission")
+          }
+          expect(JSON.parse(readFileSync(`${f.file}.applied.json`, "utf8"))).toEqual({
+            version: 1,
+            actorId: bundle.actorId,
