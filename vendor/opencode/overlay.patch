+      app.mockInput.pressEnter()
+      await app.waitForFrame((frame) => frame.includes("[ Updates · 0 ]"))
+      expect(sent).toEqual(["Use three attempts."])
+      expect(app.captureCharFrame()).not.toContain("Remove reference")
+      expect(scroll.scrollTop).toBe(0)
+      await app.click("[ Chat ]")
+      await app.waitForFrame((frame) => !frame.includes("[ Mark all read a ]"))
+      await app.mockInput.typeText("/updates")
+      app.mockInput.pressEnter()
+      await app.waitForFrame((frame) => frame.includes("No unread updates"))
+      await app.click("[ Unread")
+      await app.waitForFrame((frame) => frame.includes("[ All"))
+      app.renderer.destroy()
+      await app.task
+      paginate = true
+      app = await boot()
+      await app.waitForFrame((frame) => frame.includes("[ All") && frame.includes("[ Updates · 0 ]"))
+      expect(sent).toHaveLength(1)
+      expect(olderLoads).toBe(0)
+      await app.click("Load older updates")
+      await app.waitFor(() => olderLoads > 0)
+      await app.waitForVisualIdle()
+      expect(app.captureCharFrame()).toContain("[ Updates · 0 ]")
+    } finally {
+      app.renderer.destroy()
+      await app.task
+      await server.stop(true)
+      socket.destroy()
+    }
+  },
+  30000,
+)
