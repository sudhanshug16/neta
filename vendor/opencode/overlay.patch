+      app.mockInput.pressKey("F3")
+      await app.waitForFrame((frame) => frame.includes("0/8 enabled"))
+      expect(Object.values(saves.at(-1)!.models)).toEqual(Array(8).fill("exclude"))
+
+      await app.mockInput.typeText("Luna")
+      await app.waitForFrame((frame) => frame.includes("[ ] Luna") && !frame.includes("Muse Spark Contributor"))
