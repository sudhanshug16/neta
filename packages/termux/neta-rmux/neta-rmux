#!/data/data/com.termux/files/usr/bin/bash
# Native Termux launcher for the remote-Node Neta rmux client.
set -euo pipefail

command_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)"
runtime_dir="$(CDPATH= cd -- "$command_dir/../lib/neta-rmux" && pwd -P)"

need_file() {

	if [ ! -f "$2" ] || [ ! -x "$2" ]; then
		printf 'neta-rmux: %s is missing or is not executable: %s\n' "$1" "$2" >&2
		exit 127
	fi
}

need_value() {

	if [ -z "${!1:-}" ]; then
		printf 'neta-rmux: %s is required for the remote Neta Node\n' "$1" >&2
		exit 2
	fi
}

need_value NETA_REMOTE_SSH_DESTINATION
need_value NETA_REMOTE_NETA_DIR
need_value NETA_REMOTE_WORKSPACE_ROOT

node="${NETA_TERMUX_NODE:-$(command -v node || true)}"
if [ -z "$node" ] || [ ! -x "$node" ]; then
	printf 'neta-rmux: Node.js is required; install it with: pkg install nodejs\n' >&2
	exit 127
fi
node_version="$("$node" --version 2>/dev/null || true)"
case "$node_version" in
	v[0-9]*.[0-9]*.[0-9]*)
		node_numbers="${node_version#v}"
		node_major="${node_numbers%%.*}"
		node_rest="${node_numbers#*.}"
		node_minor="${node_rest%%.*}"
		;;
	*)
		node_major=0
		node_minor=0
		;;
esac
if [ "$node_major" -lt 22 ] || { [ "$node_major" -eq 22 ] && [ "$node_minor" -lt 19 ]; }; then
	printf 'neta-rmux: Node.js 22.19 or newer is required (found %s)\n' "${node_version:-unknown}" >&2
	exit 1
fi

ssh="${NETA_REMOTE_SSH_EXECUTABLE:-$(command -v ssh || true)}"
if [ -z "$ssh" ] || [ ! -x "$ssh" ]; then
	printf 'neta-rmux: OpenSSH is required; install it with: pkg install openssh\n' >&2
	exit 127
fi

need_file 'native Neta rmux client' "$runtime_dir/neta-rmux"
need_file 'Android rmux daemon' "$runtime_dir/rmux"
pi_runtime="$runtime_dir/pi-runtime"
pi_cli="$pi_runtime/node_modules/@earendil-works/pi-coding-agent/dist/bundle/cli.js"
if [ ! -f "$pi_cli" ]; then
	printf 'neta-rmux: local Pi runtime is missing; run: (cd %q && npm install --omit=dev --package-lock=false)\n' "$pi_runtime" >&2
	exit 127
fi
if [ ! -f "$pi_runtime/neta-acp-extension.mjs" ]; then
	printf 'neta-rmux: bundled Pi ACP extension is missing: %s\n' "$pi_runtime/neta-acp-extension.mjs" >&2
	exit 127
fi

termux_prefix="${TERMUX_PREFIX:-${PREFIX:-$command_dir/..}}"
tmpdir="${TMPDIR:-$termux_prefix/tmp}"
if [ ! -d "$tmpdir" ]; then
	printf 'neta-rmux: Termux temporary directory is missing: %s\n' "$tmpdir" >&2
	exit 1
fi

# With a configured remote connection `ConnectOptions` takes its remote branch,
# so the shell does not launch a JavaScript Node on the Android device.
unset NETA_NODE_EXECUTABLE NETA_NODE_SCRIPT
export NETA_PI_EXECUTABLE="$node"
export NETA_PI_CLI="$pi_cli"
export NETA_PI_ACP_EXTENSION="$pi_runtime/neta-acp-extension.mjs"
export RMUX_SDK_DAEMON_BINARY="$runtime_dir/rmux"
export NETA_REMOTE_SSH_EXECUTABLE="$ssh"
export NETA_WORKSPACE_ROOT="${NETA_WORKSPACE_ROOT:-$(pwd -P)}"
export TMPDIR="$tmpdir"
export RMUX_TMPDIR="${RMUX_TMPDIR:-$tmpdir}"

exec "$runtime_dir/neta-rmux" "$@"
