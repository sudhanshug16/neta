+    pub(super) fn fd_path_impl(_pid: u32, _fd: i32) -> io::Result<Option<PathBuf>> {
+        Ok(None)
+    }
+
+    pub(super) fn is_live_impl(pid: u32) -> io::Result<Option<bool>> {
+        if pid == 0 {
+            return Ok(Some(false));
+        }
+        let Some(pid) = libc::pid_t::try_from(pid).ok() else {
+            return Ok(None);
+        };
+        let result = unsafe {
+            // SAFETY: signal zero only probes whether the supplied pid exists.
+            libc::kill(pid, 0)
+        };
+        if result == 0 {
+            return Ok(Some(true));
+        }
+        match io::Error::last_os_error().raw_os_error() {
+            Some(libc::ESRCH) => Ok(Some(false)),
+            Some(libc::EPERM) => Ok(Some(true)),
+            _ => Err(io::Error::last_os_error()),
+        }
+    }
+
+    pub(super) fn environment_impl(_pid: u32) -> io::Result<Option<HashMap<String, String>>> {
+        Ok(None)
+    }
+
+    pub(super) fn raw_environment_impl(
+        _pid: u32,
+    ) -> io::Result<Option<Vec<(OsString, OsString)>>> {
+        Ok(None)
+    }
